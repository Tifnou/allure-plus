# Fichier .env - Identifiants Garmin Connect
# ─────────────────────────────────────────────
# Renommez ce fichier en ".env" et renseignez vos identifiants
# pour activer la connexion automatique au démarrage.
#
# Si ce fichier est absent, le dashboard demandera vos identifiants
# à chaque démarrage (ou vous pouvez les mémoriser depuis la page de connexion).

GARMIN_EMAIL=votre@email.com
GARMIN_PASSWORD=votre_mot_de_passe
PORT=3001
