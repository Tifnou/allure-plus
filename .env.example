# Fichier .env - Identifiants Garmin Connect
# ─────────────────────────────────────────────
# Renommez ce fichier en ".env" et renseignez vos identifiants
# pour activer la connexion automatique au démarrage.
#
# Si ce fichier est absent, le dashboard demandera vos identifiants
# à chaque démarrage (ou vous pouvez les mémoriser depuis la page de connexion).

GARMIN_EMAIL=votre@email.com
GARMIN_PASSWORD=votre_mot_de_passe
PORT=3001

# Génération d'itinéraires (BRouter self-hosted) — optionnel.
# Sans ces fichiers en place dans le dossier brouter/ (brouter.jar, segments4/,
# profiles2/), la fonctionnalité "Itinéraires" reste simplement indisponible.
# BROUTER_JAVA_PATH=java
# BROUTER_DIR=./brouter
# BROUTER_PORT=17777

# Centre de support (remontée d'idées/bugs) — relais Cloudflare partagé,
# ces deux valeurs sont communes à toutes les installations Allure+.
SUPPORT_RELAY_URL=https://allure-plus-support-relay.support-relay.workers.dev
SUPPORT_CLIENT_KEY=6a23376104f76e64d2d263b72ecc7bfb1fd3e0d7bd427dd8
