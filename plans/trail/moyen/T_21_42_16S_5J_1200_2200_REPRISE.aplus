nt avant la suite de ton plan d'entrainement.","isStatic":true},"estimatedPaces":[{"slug":"slow","value":590.7674276021575,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":251.38287438254494,"dvalue":11.454802745099862,"abstract":true,"competitive":false},{"slug":"fast","value":189.51368893429222,"dvalue":5.622056814161974,"abstract":true,"competitive":false},{"slug":"sprint","value":151.73407479154852,"dvalue":3.211767391828672,"abstract":true,"competitive":false},{"slug":"ef","value":323.5653228503161,"dvalue":19.83573326493678,"abstract":false,"competitive":false},{"slug":"tempo","value":295.9074591775808,"dvalue":16.46660559598708,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":264.65309751732553,"dvalue":12.889924709733245,"abstract":false,"competitive":false},{"slug":"aerobie","value":313.97361419700974,"dvalue":18.647183578517982,"abstract":false,"competitive":false},{"slug":"seuil60","value":251.38287438254494,"dvalue":11.454802745099862,"abstract":false,"competitive":false},{"slug":"seuil30","value":238.7780461503702,"dvalue":10.14337100917525,"abstract":false,"competitive":false},{"slug":"vma","value":209.04654202975587,"dvalue":7.281689613693443,"abstract":false,"competitive":false},{"slug":"marathon","value":285.1055151294296,"dvalue":14.036861458295162,"abstract":false,"competitive":true},{"slug":"half-marathon","value":259.313254051146,"dvalue":12.306028907653076,"abstract":false,"competitive":true},{"slug":"10km","value":244.24882804158256,"dvalue":10.706073719350261,"abstract":false,"competitive":true},{"slug":"5km","value":231.04692241735262,"dvalue":9.366062913089552,"abstract":false,"competitive":true},{"slug":"1500m","value":209.7892412689966,"dvalue":7.348655439029243,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":336.0676707367567,"dvalue":21.415398720641736,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":323.5653228503161,"dvalue":19.83573326493678,"abstract":true,"competitive":false},{"slug":"endurance-active","value":313.97361419700974,"dvalue":18.647183578517982,"abstract":true,"competitive":false},{"slug":"vo2max","value":209.04654202975587,"dvalue":7.281689613693443,"abstract":true,"competitive":false},{"slug":"race","value":418,"dvalue":14.495389579895628,"abstract":false,"competitive":true,"race":{"distance":35,"elevation":1500,"goalId":"6a68a2d9ba63bbdf0cae595d","timeLowerBound":14640,"timeUpperBound":17568}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Et l'amélioration de tes capacités cardio-respiratoires dans tout ça ? À ce stade de ta préparation, tu devrais vraiment être très à l'aise à ton allure de footing !\nQuand on est en forme, les footings deviennent presque des séances où l'on a l'impression d'être aussi frais en rentrant qu'au moment de partir. C'est un excellent signe que ton endurance et ton efficacité cardiovasculaire progressent.\nEt si tu es déjà parti(e) avec un peu de fatigue, par exemple à cause d'une séance de fractionné la veille, tu ne devrais pas te sentir plus fatigué(e) en rentrant. Si c'est le cas, mieux vaut raccourcir le footing et privilégier la récupération plutôt que d'accumuler de la fatigue inutilement.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1794787200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":324}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Recup_active_30","description":"La récupération active se fera idéalement sous forme de vélo, de natation, ski de fond ou encore une marche bien active en sentier. On ne force pas, ce n'est pas encore le moment de reprendre l'entrainement et encore moins l'impact de la course à pied.","displayName":"Récupération active","coachAdvice":"A la cool, le but est de garder une activité physique mais sans créer de fatigue.","test":false,"importance":false,"trainingType":"Special","trainingCategory":"trail_special","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EC_30","exerciseType":"running","pace":{"name":"Endurance confort","value":336,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1794787200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z1","duration":1800,"pace":{"value":336}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Recup_active_30","description":"La récupération active se fera idéalement sous forme de vélo, de natation, ski de fond ou encore une marche bien active en sentier. On ne force pas, ce n'est pas encore le moment de reprendre l'entrainement et encore moins l'impact de la course à pied.","displayName":"Récupération active","coachAdvice":"A la cool, le but est de garder une activité physique mais sans créer de fatigue.","test":false,"importance":false,"trainingType":"Special","trainingCategory":"trail_special","exercisesBl