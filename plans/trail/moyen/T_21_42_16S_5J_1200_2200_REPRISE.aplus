 en fonction de votre profil. Faire ce travail en côte plus ou moins proche de ta course nous permet de nous adapter à la spécificité de celle-ci. C'est un cycle exigeant par la longueur des intervalles mais sur lequel on se sent fort, et fier de soi et de ses progrès à son issue.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":596.8671650142134,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.9784296755053,"dvalue":11.57307481899467,"abstract":true,"competitive":false},{"slug":"fast","value":191.47043821409122,"dvalue":5.68010515718122,"abstract":true,"competitive":false},{"slug":"sprint","value":153.3007454802937,"dvalue":3.244929236580804,"abstract":true,"competitive":false},{"slug":"ef","value":326.90616970953585,"dvalue":20.040539350442863,"abstract":false,"competitive":false},{"slug":"tempo","value":298.96273561111394,"dvalue":16.636625074906377,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.38566929552115,"dvalue":13.023014572709736,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.2154256297918,"dvalue":18.839717760311025,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.9784296755053,"dvalue":11.57307481899467,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.24345523223624,"dvalue":10.248102408941413,"abstract":false,"competitive":false},{"slug":"vma","value":211.2049701246415,"dvalue":7.356873844381152,"abstract":false,"competitive":false},{"slug":"marathon","value":288.2865597364371,"dvalue":14.207668283538608,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.2065233305932,"dvalue":12.456525869215398,"abstract":false,"competitive":true},{"slug":"10km","value":246.97401705399736,"dvalue":10.837720027189432,"abstract":false,"competitive":true},{"slug":"5km","value":233.62481210211638,"dvalue":9.481840058904144,"abstract":false,"competitive":true},{"slug":"1500m","value":212.12994988083798,"dvalue":7.440312333992468