us trop rapidement et qui génèrent une fatigue qui va s'ajouter à celle des entraînements fractionnés ! Le programme qu'on te donne a été étudié pour que ces séances soient courues à allure lente, sinon la charge d'entraînement va être trop forte et tu vas soit te blesser, soit t'entraîner plus fort que ce que ton corps peut accepter... et donc ne pas progresser !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_35","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":35,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":6,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":329}}]}],"weekStats":{"expectedDistance":0,"realDistance":0,"expectedDuration":11100,"realDuration":0},"exportStatus":"NotAvailable","goalDuration":{"durationInWeeks":16,"index":3},"coach":{"name":"Mathieu","image":"https://www.datocms-assets.com/89756/1765362554-mathieu-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a68a32cce2d2a7e262eb3a1","articles":["A_QNQBdiRd2v-oOGoWKdww","JQqpHs_NR_SmcUdR84cnjQ","JZ0pBc-cQD2GTbh_DhOYFQ","KhwfJTSpQnC9A_jbhCP1oQ","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1786924800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a68a2d9ba63bbdf0cae595d","cycleTheme":"S60_Cote","cycleDescription":"Ce cycle de S60 en côte est le versant \"endurance\" de ton travail au seuil qui nous permet d'adapter votre plan en fonction de votre profil. Faire ce travail en côte plus ou moins proche de ta course nous permet de nous adapter à la spécificité de celle-ci. C'est un cycle exigeant par la longueur des intervalles mais sur lequel on se sent fort, et fier de soi et de ses progrès à son issue.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":598.74700858822,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.77833918125026,"dvalue":11.609524420522796,"abstract":true,"competitive":false},{"slug":"fast","value":192.0734777076116,"dvalue":5.697994747705367,"abstract":true,"competitive":false},{"slug":"sprint","value":153.78356885905137,"dvalue":3.255149197957552,"abstract":true,"competitive":false},{"slug":"ef","value":327.93576640785153,"dvalue":20.103657379588718,"abstract":false,"competitive":false},{"slug":"tempo","value":299.90432397507215,"dvalue":16.68902241651502,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.22780513691026,"dvalue":13.064030784848205,"abstract":false,"competitive":false},{"slug":"aerobie","value":318.2145011601602,"dvalue":18.899053780859223,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.77833918125026,"dvalue":11.609524420522796,"abstract":false,"competitive":false},{"slug":"seuil30","value":242.00325571326755,"dvalue":10.280378986693446,"abstract":false,"competitive":false},{"slug":"vma","value":211.87016387152443,"dvalue":7.380044447208352,"abstract":false,"competitive":false},{"slug":"marathon","value":289.26743458556916,"dvalue":14.260368562185617,"abstract":false,"competitive":true},{"slug":"half-marathon","value":263.0986626805805,"dvalue":12.502961477568682,"abstract":false,"competitive":true},{"slug":"10km","value":247.8143288671421,"dvalue":10.878340938420546,"abstract":false,"competitive":true},{"slug":"5km","value":234.41970417940806,"dvalue":9.517565819306542,"abstract":false,"competitive":true},{"slug":"1500m","value":212.85170719333982,"dvalue":7.468597393036807,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":340.6069853132661,"dvalue":21.704659604800156,"abstract