 que ce soit vis-à-vis des intensités, ou des durées des sorties longues.","isStatic":true},"estimatedPaces":[{"slug":"slow","value":593.1251653712344,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":252.38613703674463,"dvalue":11.50051857134144,"abstract":true,"competitive":false},{"slug":"fast","value":190.27003324388133,"dvalue":5.644494299831164,"abstract":true,"competitive":false},{"slug":"sprint","value":152.3396416225501,"dvalue":3.224585473752964,"abstract":true,"competitive":false},{"slug":"ef","value":324.85666381937426,"dvalue":19.914897171596085,"abstract":false,"competitive":false},{"slug":"tempo","value":297.08841831658805,"dvalue":16.532323399860793,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":265.70932129434124,"dvalue":12.941368071213144,"abstract":false,"competitive":false},{"slug":"aerobie","value":315.2266749009327,"dvalue":18.72160401362628,"abstract":false,"competitive":false},{"slug":"seuil60","value":252.38613703674463,"dvalue":11.50051857134144,"abstract":false,"competitive":false},{"slug":"seuil30","value":239.73100325587646,"dvalue":10.183852944733474,"abstract":false,"competitive":false},{"slug":"vma","value":209.88084145895598,"dvalue":7.310750651629445,"abstract":false,"competitive":false},{"slug":"marathon","value":286.3347768841911,"dvalue":14.102848038750498,"abstract":false,"competitive":true},{"slug":"half-marathon","value":260.43130981924685,"dvalue":12.364168332787585,"abstract":false,"competitive":true},{"slug":"10km","value":245.3019319873991,"dvalue":10.756929861329056,"abstract":false,"competitive":true},{"slug":"5km","value":232.0431049891071,"dvalue":9.410787799742923,"abstract":false,"competitive":true},{"slug":"1500m","value":210.69376916189037,"dvalue":7.384061357738221,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":337.4089082580565,"dvalue":21.500867031933726,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":324.85666381937426,"dvalue":19.914897171596085,"abstract":true,"competitive":false},{"slug":"endurance-active","value":315.2266749009327,"dvalue":18.72160401362628,"abstract":true,"competitive":false},{"slug":"vo2max","value":209.88084145895598,"dvalue":7.310750651629445,"abstract":true,"competitive":false},{"slug":"race","value":420,"dvalue":14.563450707592608,"abstract":false,"competitive":true,"race":{"distance":35,"elevation":1500,"goalId":"6a68a2d9ba63bbdf0cae595d","timeLowerBound":14703,"timeUpperBound":17644}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Du footing et quelques lignes droites en accélération progressive, sans forcer, c'est tout ! Les lignes droites c'est vraiment censé faire du bien ! L'accélération progressive permet d'adapter le rythme à comment se sent ton corps. Puis, au fur et à mesure des lignes droites d'allonger la foulée et de sentir que tout se met en place, que tu es plus à l'aise !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_44","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":44,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"run