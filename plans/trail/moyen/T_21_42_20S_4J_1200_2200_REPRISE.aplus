ions":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":4,"trainingIndex":0,"weekDate":1792368000000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":40},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":40},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_20","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"La troisième semaine d’un cycle, c’est là que les séances d’intensité tapent le plus fort, et que la fatigue se fait bien sentir. Profite du footing pour faire le point sur tes sensations et évaluer où tu en es. Si tu te sens vraiment épuisé, mise à fond sur la récupération en rentrant.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_20","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-