PP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant de speeder pendant tes footings, pas vrai ? On connaît tous ça, c’est tellement simple de se laisser aller. Mais si tu veux vraiment avancer, il faut apprendre à te freiner. Accélérer, même un peu, ça fatigue ton corps et ça risque de te limiter pour ta prochaine séance intense… et donc de ralentir tes progrès. (Je le redis, parce que c’est essentiel !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_45","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":45,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S60_600_Cote4'+_7","description":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **9 répétitions de 3'** à l'allure cible entrecoupées de 2'30 de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"Tu te souviens quand on disait que c'était une intensité qu'on pouvait tenir 60 minutes ? C'était facile de se mentir et de partir trop vite sur les premières séances faciles. Maintenant qu'on se rapproche de plus en plus de l'heure de temps de maintien, impossible de se mentir. Tu as intérêt à partir au bon rythme, voire de façon conservatrice, sinon la séance va paraître plus longue qu'elle ne l'est déjà.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":9,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_3","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2.5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":338,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":150,"timeUnit":"seconds"}],"terrainIncline":"downhill",