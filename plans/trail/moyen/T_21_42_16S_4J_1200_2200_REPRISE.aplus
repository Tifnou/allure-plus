ration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Bien que l'EF soit fondamentale pour ta progression (c'est dans le nom), il est important de ne pas te surmener à ce stade. Si tu te sens fatigué, ajuste la durée de tes sorties pour éviter l'épuisement. L'objectif est de rester en forme sans compromettre tes ressources pour la course.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_200_3x30AC_Affutage","description":"Sortie longue de 3h20 en endurance confort avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, envie...). Le bloc actif est composé de 3x30' à allure course, séparées par minimum 5' de récupération en endurance.","displayName":"Sortie Longue & Active","coachAdvice":"Cette sortie longue (la plus longue de tout ton programme) à 4 semaines de la course doit rester spécifique. Alterne entre l'endurance de confort et l'allure de course selon les indications. Profite de cette sortie pour tester ta nutrition et tes équipements comme expliqué dans les articles joints à tes semaines.","test":false,"importance":false,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EC_80","exerciseType":"running","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":80,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"AC_30_Indif","exerciseType":"running","pace":{"name":"Allure course","value":420,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"race","context":"intensity","perception":"target"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_5_Indif","exerciseType":"running","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","ex