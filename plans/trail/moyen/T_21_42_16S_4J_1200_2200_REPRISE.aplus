":"GPP","duration":30},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":90}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant de speeder pendant tes footings, pas vrai ? On connaît tous ça, c’est tellement simple de se laisser aller. Mais si tu veux vraiment avancer, il faut apprendre à te freiner. Accélérer, même un peu, ça fatigue ton corps et ça risque de te limiter pour ta prochaine séance intense… et donc de ralentir tes progrès. (Je le redis, parce que c’est essentiel !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1785715200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":329}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30+4LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Ajouter des lignes droites en accélération progressive dans les footings, c'est vraiment une bonne manière d'entretenir ta vitesse, de te permettre de courir avec une belle amplitude de mouvement et de travailler à avoir une foulée efficace. En plus ça se fait assez naturellement sur des lignes droites ! Concentre-toi sur le fait de te relâcher... et le reste va suivre !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_26","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":26,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":4,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":212,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":342,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1785715200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1560,"pace":{"value":329}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":342}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":342}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":342}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":342}}]},{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - REPRISE  - SEMAINE 2 SEANCE 2","description":"Séance en 2 blocs. Le premier bloc est composé de 4 séries de 5 exercices enchainés sans pause. Le second bloc est composé de 3 séries de 3 exercices enchainés sans pause. Prenez 1'30 de récupération entre les séries du premier bloc et 1' entre celles du second. ","displayName":"Renforcement","coachAdvice":"Les exercices en statiques sont peu utilisés alors que très bon pour la santé, la performance tout en étant peu traumatiques. Ils seront par la suite beaucoup utilisés, dans différents contextes, donc autant s'y habituer.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":4,"exercises":[{"_t":"SmartPPGExercise","name":"Split Squat avec charge additionnelle","exerciseType":"ppg","sport":"ppg","difficulty":"moderate","durations":[{"value":30,"timeUnit":"seconds"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Fente arrière","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"hb4BQg4cqbEo2jFyobgiiaVMM9Lvq227","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"K3t4gDQOM02dAnQYrsSalA01mNjkty8xiu","format":"mobile"}]},{"name":"Split Squat","description":"","variationType":"standard","videos":[{"th