uration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant de speeder pendant tes footings, pas vrai ? On connaît tous ça, c’est tellement simple de se laisser aller. Mais si tu veux vraiment avancer, il faut apprendre à te freiner. Accélérer, même un peu, ça fatigue ton corps et ça risque de te limiter pour ta prochaine séance intense… et donc de ralentir tes progrès. (Je le redis, parce que c’est essentiel !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":327}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S30_600_Cote_4","description":"Séance de seuil 30' **EN COTE** où tu vas enchaîner **6 répétitions de 2'** à l'allure cible entrecoupées de 2'30 de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 30","coachAdvice":"On attaque les choses sérieuses maintenant. Reste concentré pendant tes intervalles : surveille ta posture, ton gainage et ton souffle. Avec la fatigue, tu risqueras de te relâcher, mais c’est là que tu dois rester vigilant pour être efficace.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S30_Cote_2","exerciseType":"running","pace":{"name":"Seuil 30","value":243,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil30","context":"intensity","perception":"high"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2.5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":340,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":150,"timeUnit":"seconds"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":10,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":5,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3420},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":327}},{"kind":"Z4","duration":120,"pace"