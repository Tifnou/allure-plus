VER","duration":60,"pace":{"value":337}},{"kind":"Z3","duration":180,"pace":{"value":314}},{"kind":"RECOVER","duration":60,"pace":{"value":337}},{"kind":"Z3","duration":180,"pace":{"value":314}},{"kind":"RECOVER","duration":60,"pace":{"value":337}},{"kind":"Z3","duration":180,"pace":{"value":314}},{"kind":"RECOVER","duration":60,"pace":{"value":337}},{"kind":"Z3","duration":180,"pace":{"value":314}},{"kind":"RECOVER","duration":60,"pace":{"value":337}},{"kind":"Z3","duration":180,"pace":{"value":314}},{"kind":"RECOVER","duration":60,"pace":{"value":337}},{"kind":"RECOVER","duration":600,"pace":{"value":324}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"En footing d’endurance, l’objectif, c’est d’être à l’aise du début à la fin. Tu dois finir en te disant que tu pourrais facilement continuer encore un bon moment sans forcer.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1795996800000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":324}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_45+5LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Vas-y doucement sur l'endurance fondamentale sur cette sortie. Aucune fatigue ne doit être générée et les lignes droites finales ne sont là que pour garder le corps habitué à une grande amplitude de mouvement (en endurance fondamentale, tous les gestes sont \"restreints\" pour garder l'allure basse, on vient rééquilibrer ça avec les lignes droites)","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":209,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":337,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":3,"weekDate":1795996800000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":324}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_90_15AC_Affutage","description":"Sortie longue d'1h30 en endurance confort avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, envie...). Le bloc actif est composé de 15' à allure course en continues","displayName":"Sortie Longue & Active","coachAdvice":"1h30 de sortie longue, c'est la durée la plus utilisée en préparation de base car on a les avantages de la sortie longue en terme de développement de l'endurance, sans pour autant générer de fatigue inutile !","test":false,"importance":false,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EC_65","exerciseType":"running","pace":{"name":"Endurance confort","value":337,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":65,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"AC_15_Indif","exerciseType":"running","pace":{"name":"Allure course","value":417,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"race","context":"intensity","perception":"target"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainInclin