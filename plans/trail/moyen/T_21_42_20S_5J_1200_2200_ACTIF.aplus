 d’entraînement. Ne lâche pas, mais prends bien en compte cette fatigue !\nDors un peu plus, fais attention à ton alimentation, utilise ton foam roller pour masser les points de tension… bref, fais tout pour favoriser et accélérer la récupération !:)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1789948800000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S30_600_Cote4'+_7","description":"Séance de seuil 30' **EN COTE** où tu vas enchaîner **5 répétitions de 3'** à l'allure cible entrecoupées de 2'30 de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 30","coachAdvice":"Réussir cette séance est la preuve que tu as compris comment gérer cette intensité et que tu as bien progressé depuis le début de ce cycle. Alors ne pars pas trop vite et sois régulier.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S30_Cote_3","exerciseType":"running","pace":{"name":"Seuil 30","value":243,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil30","context":"intensity","perception":"high"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2.5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":150,"timeUnit":"seconds"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":10,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":5,"weekDate":1789948800000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3450},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":326}},{"kind":"Z4","duration":180,"pace":{"value":243}},{"kind":"RECOVER","duration":150,"pace":{"value":339}},{"kind":"Z4","duration":180,"pace":{"value":243}},{"kind":"RECOVER","duration":150,"pace":{"value":339}},{"kind":"Z4","duration":180,"pace":{"value":243}},{"kind":"RECOVER","duration":150,"pace":{"value":339}},{"kind":"Z4","duration":180,"pace":{"value":243}},{"kind":"RECOVER","duration":150,"pace":{"value":339}},{"kind":"Z4","duration":180,"pace":{"value":243}},{"kind":"RECOVER","duration":150,"pace":{"value":339}},{"kind":"RECOVER","duration":600,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_120","description":"Sortie longue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Sortie Longue","coachAdvice":"2h, c’est la limite en termes de durée pour les sorties longues, celles qui peuvent commencer à laisser des traces de fatigue. Tu es entraîné(e) pour ça, mais reste vigilant(e) sur la sortie suivante et écoute bien ton corps. Si tu ressens certaines tensions, n’hésite pas à utiliser l’automassage ou d’autres techniques de récupération en rentrant : elles sont les bienvenues pour accélérer la récup !","test":false,"importance":true,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_120","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":120,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":6,"weekDate":1789948800000,"status":"todo","nutritionTraining":{"_id":"6a68a03dba63bbdf0cae263b","userId":"642ab60364e5867bee895c04","weekDate":1789948800000,"sessionIndex":6,"choRecommendation":4,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"AdSspNUrTa-cUILb7xt-4g","name":"Compote de pommes","form":"semi-liquid","info":{"quantity":{"value":1,"metric":"item"},"cho":{"value":15,"metric":"g"},"sodium":{"value":1,"metric":"mg"}}},{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":4,"metric":"item"},"cho":{"value":108,"metric":"g"},"sodium":{"value":4,"metric":"mg"}}},{"datoId":"d2Xmi074S8qN0vgyfiujiw","name":"Eau","form":"liquid","info":{"quantity":{"value":500,"metric":"mL"},"cho":{"value":0,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}],[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort