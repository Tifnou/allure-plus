ndurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":25,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1792972800000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1500},"paceZones":[{"kind":"Z2","duration":1500,"pace":{"value":324}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30+5LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Quelques lignes droites en plus du traditionnel footing. De quoi te faire plaisir car il n'y a aucun objectif d'allure, juste de sentir que ton corps se libère et te permet d'accélérer progressivement de ligne droite en ligne droite !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_25","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":25,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":210,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"dura