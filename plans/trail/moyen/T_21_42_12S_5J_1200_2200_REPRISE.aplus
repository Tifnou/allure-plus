{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_44","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":44,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":211,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":2640,"pace":{"value":327}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S60_4x5_Cote_Affutage","description":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **4 répétitions de 5' (dont les 3ère minutes courues à plat)** à l'allure cible entrecoupées de 2' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"Maîtrise ton effort : Une séance avec quelques intervalles de 5 minutes à S60, tu sais que tu dois avoir de la marge ! Garde un bon contrôle sur ton effort pour ne pas trop solliciter ton corps à 5 semaines de la course. L’objectif est de rester efficace sans épuiser trop de réserves avant les sorties longues restantes.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Plat_3","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"S60_Cote_2","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"}