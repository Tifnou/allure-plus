":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_25","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":25,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1788134400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1500},"paceZones":[{"kind":"Z2","duration":1500,"pace":{"value":327}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_25","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Le genre de sorties qui doivent se courir vraiment lentement. On ne fait pas monter le cardio, au contraire on cherche à le garder le plus bas possible. On sort juste pour se garder actif et ne pas tomber dans un état de surentraînement mais ton objectif est vraiment de récupérer avant de rattaquer un nouveau cycle d'entraînement !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_25","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":25,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1788134400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1500},"pa