entale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1795392000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":324}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_45+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Quelques lignes droites en plus du traditionnel footing. De quoi te faire plaisir car il n'y a aucun objectif d'allure, juste de sentir que ton corps se libère et te permet d'accélérer progressivement de ligne droite en ligne droite !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_39","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":39,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":209,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":337,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":3,"weekDate":1795392000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2340,"pace":{"value":324}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_130_25AC_Affutage","description":"Sortie longue de 2h10 en endurance confort avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, envie...). Le bloc actif est composé de 25' de allure course en continues","displayName":"Sortie Longue & Active","coachAdvice":"Pour vérifier si ton endurance progresse et si tu tiens mieux sur trail, ce genre de sortie est parfait. Petit à petit, tu devrais ressentir que tu avances plus longtemps sans être fatigué. C’est tout l’enjeu ! Et une fois bien reposé pour la course, les effets seront encore plus marqués.","test":false,"importance":false,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV