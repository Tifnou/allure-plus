"coachAdvice":"Les footings, c'est la base de l'entraînement, tu en retrouveras donc chaque semaine, c'est ce qui te permettra de faire un bon kilométrage chaque semaine sans générer trop de fatigue et donc en évitant un maximum les blessures !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_35","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":322,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":35,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":3,"weekDate":1797206400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":322}}]}],"weekStats":{"expectedDistance":0,"realDistance":0,"expectedDuration":7500,"realDuration":0},"exportStatus":"NotAvailable","coach":{"name":"Mathieu","image":"https://www.datocms-assets.com/89756/1765362554-mathieu-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a68a3520462290c63b4c0aa","articles":["ObXpXK6XSy-fr8_aJhItFQ","LDeoknxgTUWm5staAPlgrw","dDmcZGxESga8-Ur2NN71hg","R7eLMxpGQ9eo7XoG23s6Mg","VweloBXBQhCZB7UIPiUqeQ"],"weekDate":1797811200000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a68a2d9ba63bbdf0cae595d","cycleTheme":"post-competition","cycleDescription":"Ce \"bloc\" permet de t'octroyer le repos nécessaire (et mérité) après ta course, puis de reprendre progressivement avant la suite de ton plan d'entrainement.","isStatic":true},"estimatedPaces":[{"slug":"slow","value":587.8026106222211,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":250.1212878772432,"dvalue":11.397315835541654,"abstract":true,"competitive":false},{"slug":"fast","value":188.5625982400008,"dvalue":5.593842040079976,"abstract":true,"competitive":false},{"slug":"sprint","value":150.97258432955235,"dvalue":3.1956488618387047,"abstract":true,"competitive":false},{"slug":"ef","value":321.941482539419,"dvalue":19.73618593709563,"abstract":false,"competitive":false},{"slug":"tempo","value":294.42242222654147,"dvalue":16.383966524176596,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":263.32491325961007,"dvalue":12.82523551756732,"abstract":false,"competitive":false},{"slug":"aerobie","value":312.3979106982544,"dvalue":18.553601089168513,"abstract":false,"competitive":false},{"slug":"seuil60","value":250.1212878772432,"dvalue":11.397315835541654,"abstract":false,"competitive":false},{"slug":"seuil30","value":237.5797180561213,"dvalue":10.092465632208434,"abstract":false,"competitive":false},{"slug":"vma","value":207.9974240377187,"dvalue":7.245145830132228,"abstract":false,"competitive":false},{"slug":"marathon","value":283.5602967364527,"dvalue":13.953948285840795,"abstract":false,"competitive":true},{"slug":"half-marathon","value":257.90782487338834,"dvalue":12.23297758896887,"abstract":false,"competitive":true},{"slug":"10km","value":242.92504522601143,"dvalue":10.642175477736657,"abstract":false,"competitive":true},{"slug":"5km","value":229.7946914529747,"dvalue":9.309869831064079,"abstract":false,"competitive":true},{"slug":"1500m","value":208.65222294751527,"dvalue":7.304173157464869,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":334.3810863212071,"dvalue":21.307923706291692,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":321.941482539419,"dvalue":19.73618593709563,"abstract":true,"competitive":false},{"slug":"endurance-active","value":312.3979106982544,"dvalue":18.553601089168513,"abstract":true,"competitive":false},{"slug":"vo2max","value":207.9974240377187,"dvalue":7.245145830132228,"abstract":true,"competitive":false},{"slug":"race","value":416,"dvalue":14.409869215470678,"abstract":false,"competitive":true,"race":{"distance":35,"elevation":1500,"goalId":"6a68a2d9ba63bbdf0cae595d","timeLowerBound":14561,"timeUpperBound":17473}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant de speeder pendant tes footings, pas vrai ? On connaît tous ça, c’est tellement simple de se laisser aller. Mais si tu veux vraiment avancer, il faut apprendre à te freiner. Accélérer, même un peu, ça fatigue ton corps et ça risque de te limiter pour ta prochaine séance intense… et donc de ralentir tes progrès. (Je le redis, parce que c’est essentiel !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":322,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1797811200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":322}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_35","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Tu ressens de la fatigue sur ce footing ? C’est normal, tu arrives en fin de cycle d’entraînement. Ne lâche pas, mais prends bien en compte cette fatigue !\nDors un peu plus, fais attention à ton alimentation, utilise ton foam roller pour masser les points de tension… bref, fais tout pour favoriser et accélérer la récupération !:)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_35","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":322,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":35,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1797811200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":322}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Recup_S60_600_Plat_1","description":"Petite séance avec du seuil pour garder les jambes actives sans trop pousser pendant la récupération. Enchaine 8 fois 1' au seuil 60 et 1' lent.","displayName":"Intensité Facile","coachAdvice":"A la cool, le but est de garder une activité physique mais sans créer de fatigue.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":322,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":8,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Plat_1","exerciseType":"running","pace":{"name":"Seuil 60","value":250,"kind"