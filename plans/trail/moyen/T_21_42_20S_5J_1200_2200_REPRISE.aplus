nt_600_Cote_1","description":"Séance d'endurance de force **EN COTE** où tu vas répéter 5 efforts de 30\" à très haute intensité séparés par 3' de récupération courues très lentement et/ou marchées entre les efforts.","displayName":"Sprint en côte","coachAdvice":"Bienvenue dans ta première séance de Sprint. Cette zone est simple : théoriquement, tu donnes tout, c’est à fond ! Mais sur cette première séance, prends ton temps pour y aller progressivement afin d'éviter les blessures et laisser à ton corps le temps de s’adapter. C'est pour ça aussi qu'il y a très très peu de séries.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartTrailV2Exercise","name":"Sprint_Cote_30","exerciseType":"running","pace":{"name":"Sprint","value":154,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"sprint","context":"intensity","perception":"maximal"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_3","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":341,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"en