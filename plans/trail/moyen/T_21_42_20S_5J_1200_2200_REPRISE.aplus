nce","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":3,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":329}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30+5LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Comme l'indique la description de l'entrainement, si jamais tu te sens très fatigué(e), n'hésite pas à supprimer les lignes droites et rentre directement te reposer ! Elles sont optionnelles, pour garder le corps habitué à des intensités très élevées, mais le principal est de ne pas générer de fatigue inutile ici.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_25","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":25,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":5,"exercises":[{"_t"