ie Longue & Active","coachAdvice":"Courir longtemps, sans fatigue et sans blessures ? C'est exactement là où on t'emmène avec les sorties longues ! Pas besoin de courir des heures pour atteindre cet objectif, 1h30 c'est la durée qui optimise le rapport coût / bénéfice de ce type d'entraînement.","test":false,"importance":false,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EC_65","exerciseType":"running","pace":{"name":"Endurance confort","value":337,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":65,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"AC_15_Indif","exerciseType":"running","pace":{"name":"Allure course","value":417,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"race","context":"intensity","perception":"target"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":10,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":2,"trainingIndex":4,"weekDate":1795996800000,"status":"todo","nutritionTraining":{"_id":"6a68a355ba63bbdf0cae5dbd","userId":"642ab60364e5867bee895c04","weekDate":1795996800000,"sessionIndex":4,"choRecommendation":5,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":4,"metric":"item