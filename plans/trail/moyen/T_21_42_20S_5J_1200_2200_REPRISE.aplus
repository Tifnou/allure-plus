e":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":40},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":40},{"kind":"GPP","duration":40},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_20","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Les footings sont essentiels pendant ce type de semaine, alors ne les cours surtout pas trop vite ! Tu arrives en fin de cycle d'entraînement et il est tout à fait normal que la fatigue soit importante. Ce n'est pas le moment de jouer les héros : garde ton énergie pour les séances les plus intenses.\nD'ailleurs, en période de forte charge d'entraînement, si tu te sens vraiment très fatigué(e), n'hésite pas à écourter ton footing après 25 à 30 minutes. Dans ce cas, privilégie une vraie récupération, dans ton canapé ou dans ton lit, afin d'arriver le plus frais possible à la prochaine séance.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_20","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1792368000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":325}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S60_600_Cote6'+_8","description":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **6 répétitions de 5'** à l'allure cible entrecoupées de 4' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"12ᵉ et dernière séance de seuil 60, bravo, tu maîtrises cette zone comme un expert ! Arriver jusqu’ici prouve à quel point tu as progressé depuis le début. Donne tout ce qu’il faut pour boucler cette dernière séance et sois fier de ce que tu as accompli.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_5","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_4","exerciseTy