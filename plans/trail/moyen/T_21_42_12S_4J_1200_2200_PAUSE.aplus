e":1785110400000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":90}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant de speeder pendant tes footings, pas vrai ? On connaît tous ça, c’est tellement simple de se laisser aller. Mais si tu veux vraiment avancer, il faut apprendre à te freiner. Accélérer, même un peu, ça fatigue ton corps et ça risque de te limiter pour ta prochaine séance intense… et donc de ralentir tes progrès. (Je le redis, parce que c’est essentiel !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":3,"weekDate":1785110400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":329}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30+4LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing / lignes droites, c'est un classique des coureurs ! Ça ne fatigue pas mais ça permet de garder le corps en mode \"entraînement\". Pas de rythmes précis sur les lignes droites, vas y progressivement, selon tes sensations !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_26","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":26,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":4,"exerci