":{"quantity":{"value":200,"metric":"mL"},"cho":{"value":12,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}},{"datoId":"eYGAVJrKTQO3qdBF7j3n_g","name":"Gum de l'effort","form":"solid","info":{"quantity":{"value":3,"metric":"item"},"cho":{"value":22.8,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}],[{"datoId":"CobrX8IwSw2uKueLLZanOQ","name":"Velouté de tomates","form":"liquid","info":{"quantity":{"value":200,"metric":"mL"},"cho":{"value":12.8,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}},{"datoId":"UHB8rQYwQ6q1cVY9D09F0w","name":"Barre énergétique au miel","form":"solid","info":{"quantity":{"value":1.5,"metric":"item"},"cho":{"value":22.5,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}]]}}},"stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":327}},{"kind":"Z4","duration":60,"pace":{"value":241}},{"kind":"RECOVER","duration":120,"pace":{"value":340}},{"kind":"Z4","duration":60,"pace":{"value":241}},{"kind":"RECOVER","duration":120,"pace":{"value":340}},{"kind":"Z4","duration":60,"pace":{"value":241}},{"kind":"RECOVER","duration":120,"pace":{"value":340}},{"kind":"Z4","duration":60,"pace":{"value":241}},{"kind":"RECOVER","duration":120,"pace":{"value":340}},{"kind":"Z4","duration":60,"pace":{"value":241}},{"kind":"RECOVER","duration":120,"pace":{"value":340}},{"kind":"RECOVER","duration":600,"pace":{"value":327}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_20+3LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Et ton cardio, ça progresse ? À ce stade, ton allure de footing devrait te sembler vraiment facile. Quand tout va bien, tu devrais rentrer presque aussi frais qu’au départ ! Si tu pars déjà fatigué, par exemple à cause d’une séance intense la veille, veille à ne pas aggraver cette fatigue. Mieux vaut écourter le footing plutôt que de rentrer encore plus épuisé.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_17","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":17,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":211,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":340,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":1020,"pace":{"value":327}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":340}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":340}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":340}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Competition_M","description":"Le mot du jour : gestion. La course sera suffisamment longue pour que chaque erreur de rythme se paie plus tard. Prends le temps de trouver ton allure dès le départ et n'hésite pas à marcher dans les montées les plus raides si cela te permet d'économiser ton énergie. Pense à boire et à t'alimenter régulièrement, sans attendre les premiers signes de fatigue. Aujourd'hui, ce n'est pas le plus rapide au départ qui sera récompensé, mais celui ou celle qui saura rester efficace jusqu'au bout. Sois patient(e), régulier(ère) et profite du terrain.","displayName":"Jour de course","coachAdvice":"L'équipe CAMPUS te souhaite bon courage pour ta compétition ! On est tous derrière toi :)","test":false,"importance":false,"trainingType":"Competition","trainingCategory":"trail_competition","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"","exerciseType":"running","pace":{"name":"course","value":431,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"race","context":"intensity","perception":"target"},"durations":[{"value":15085,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":5,"trainingIndex":3,"weekDate":1791763200000,"status":"todo","nutritionTraining":{"_id":"6a6616a191815bf735be2573","userId":"642ab60364e5867bee895c04","weekDate":1791763200000,"sessionIndex":3,"choRecommendation":5,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"AdSspNUrTa-cUILb7xt-4g","name":"Compote de pommes","form":"semi-liquid","info":{"quantity":{"value":10,"metric":"item"},"cho":{"value":150,"metric":"g"},"sodium":{"value":10,"metric":"mg"}}},{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":5,"metric":"item"},"cho":{"value"