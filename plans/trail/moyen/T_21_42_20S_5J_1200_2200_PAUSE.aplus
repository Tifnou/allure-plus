es":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1786924800000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":328}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Sprint_600_Cote_3","description":"Séance d'endurance de force **EN COTE** en **deux blocs**. Il y a 3 intervalles par bloc, respectivement de **30\", 30\" et 20\"**, séparés par 3' de repos courues très lentement et/ou marchées. À la fin du premier bloc, après le dernier sprint de 20\", prends 5' *(soit 2' de bonus !)* activement afin de pouvoir repartir sur le second bloc avec autant d'intensité que sur le premier.","displayName":"Sprint en côte","coachAdvice":"L'objectif sur ces séances est de maintenir la même intensité tout au long des intervalles et de ne pas ralentir. Pour y arriver, trouve un point de repère à partir du 3ᵉ intervalle (les deux premiers étant pour l'échauffement) et vise-le sur chaque sprint suivant. Si tu ne l'atteins pas, c’est que tu as ralenti !","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name