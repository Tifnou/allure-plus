ie Longue","coachAdvice":"Tu veux savoir si ton endurance et ta capacité à tenir sur trail s’améliorent ? C’est avec ce type de sortie que tu peux le mesurer. Progressivement, tu devrais sentir que tu vas plus loin sans te fatiguer. C’est ça le but ! Et le jour de la course, bien reposé, tu verras encore plus la différence.","test":false,"importance":true,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_110","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":110,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":6,"weekDate":1789344000000,"status":"todo","nutritionTraining":{"_id":"6a68a1aeba18ec4605331011","userId":"642ab60364e5867bee895c04","weekDate":1789344000000,"sessionIndex":6,"choRecommendation":4,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":4,"metric":"item"},"cho":{"value":108,"metric":"g"},"sodium":{"value":4,"metric":"mg"}}},{"datoId":"d2Xmi074S8qN0vgyfiujiw","name":"Eau","form":"liquid","info":{"quantity":{"value":450,"metric":"mL"},"cho":{"value":0,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}],[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":450,"metric":"mL"},"cho":{"value":27,"metric":"g"},"sodium":{"value":1845,"metric":"mg"}}},{"datoId":"AdSspNUrTa-cUILb7xt-4g","name":"Compote de pommes","form":"semi-liquid","info":{"quantity":{"value":5.5,"metric":"item"},"cho":{"value":82.5,"metric":"g"},"sodium":{"value":5.5,"metric":"mg"}}}],[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","