10317,"dvalue":16.456248438924316,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":264.48663614906417,"dvalue":12.881817211562625,"abstract":false,"competitive":false},{"slug":"aerobie","value":313.7761312357011,"dvalue":18.635454882644677,"abstract":false,"competitive":false},{"slug":"seuil60","value":251.22475971236068,"dvalue":11.447597909199574,"abstract":false,"competitive":false},{"slug":"seuil30","value":238.6278596585217,"dvalue":10.136991036929277,"abstract":false,"competitive":false},{"slug":"vma","value":208.91505604397676,"dvalue":7.2771095803300705,"abstract":false,"competitive":false},{"slug":"marathon","value":284.91181872670825,"dvalue":14.026466042169933,"abstract":false,"competitive":true},{"slug":"half-marathon","value":259.137080523023,"dvalue":12.29686983359867,"abstract":false,"competitive":true},{"slug":"10km","value":244.08288905811858,"dvalue":10.698062139036468,"abstract":false,"competitive":true},{"slug":"5km","value":230.8899526101858,"dvalue":9.359017313804575,"abstract":false,"competitive":true},{"slug":"1500m","value":209.64671361096453,"dvalue":7.3430780224954955,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":335.85629106720404,"dvalue":21.401928874241474,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":323.36180690106437,"dvalue":19.823256995697037,"abstract":true,"competitive":false},{"slug":"endurance-active","value":313.7761312357011,"dvalue":18.635454882644677,"abstract":true,"competitive":false},{"slug":"vo2max","value":208.91505604397676,"dvalue":7.2771095803300705,"abstract":true,"competitive":false},{"slug":"race","value":418,"dvalue":14.484667311539324,"abstract":false,"competitive":true,"race":{"distance":35,"elevation":1500,"goalId":"6a68a133ba18ec460533052d","timeLowerBound":14630,"timeUpperBound":17556}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Ajouter des lignes droites en accélération progressive dans les footings, c'est vraiment une bonne manière d'entretenir ta vitesse, de te permettre de courir avec une belle amplitude de mouvement et de travailler à avoir une foulée efficace. En plus ça se fait assez naturellement sur des lignes droites ! Concentre-toi sur le fait de te relâcher... et le reste va suivre !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_44","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":44,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":209,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":337,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1794787200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":2640,"pace":{"value":324}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"VO2_7x60-90_Cote_Affutage","description":"Séance VMA **EN COTE**. Sur cette séance, tu enchaînes **7 fois** 1' rapides et 1'30 lentes pour te laisser le temps de redescendre.","displayName":"VO2max","coachAdvice":"Lors de cette séance de 1min à VO2, rappelle-toi que tu devrais être capable de tenir cette intensité pendant environ 5 minutes en condition idéale. Si tu te sens épuisé après seulement 30 secondes, il faudra ajuster ton effort. Tu as maintenant l'expérience nécessaire pour bien gérer cette intensité.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":7,"exercises":[{"_t":"SmartTrailV2Exercise","name":"VMA_Cote_1","exerciseType":"running","pac