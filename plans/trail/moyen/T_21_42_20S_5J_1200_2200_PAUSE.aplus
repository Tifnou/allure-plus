)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":322,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1797206400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":322}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Recup_active_30","description":"La récupération active se fera idéalement sous forme de vélo, de natation, ski de fond ou encore une marche bien active en sentier. On ne force pas, ce n'est pas encore le moment de reprendre l'entrainement et encore moins l'impact de la course à pied.","displayName":"Récupération active","coachAdvice":"A la cool, le but est de garder une activité physique mais sans créer de fatigue.","test":false,"importance":false,"trainingType":"Special","trainingCategory":"trail_special","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EC_30","exerciseType":"running","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1797206400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z1","duration":1800,"pace":{"value":335}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Recup_active_30","description":"La 