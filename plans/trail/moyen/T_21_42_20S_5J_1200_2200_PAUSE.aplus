ry":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_55","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":55,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3300},"paceZones":[{"kind":"Z2","duration":3300,"pace":{"value":325}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"VarT_600_Cote4'+_5","description":"Séance de variation d'allure avec 3 blocs courus en continu. Première partie du bloc constituée de 9' en endurance active, directement enchaînée **EN COTE** par la deuxième partie et son 3' au Seuil 30, pour finir (toujours sans pause) par 30\" à VMA. Tes 5' de récupération sont bien méritées avant d'attaquer le bloc suivant !","displayName":"Variation d'allure","coachAdvice":"Sortie intense de ta semaine. Fais en sorte d'y arriver le plus reposé(e) possible pour la valider sans soucis.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EA_Plat_8","exerciseType":"running","pace":{"name":"Endurance active","value":317,"kind":"abstract","zoneKind":"Z3","abstract":true,"slug":"endurance-active","context":"pace","perception":"moderate"},"durations":[{"value":8,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"S30_Cote_3","exerciseType":"running","pace":{"name":"Seuil 30","value":241,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil30","context":"intensity","perception":"high"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"VMA_Cote_0.5","exerciseType":"running","pace":{"name":"VO2max","value":211,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":338,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":5,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":4170},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":325}},{"kind":"Z3","duration":480,"pace":{"value":317}},{"kind":"Z4","duration":180,"pace":{"value":241}},{"kind":"Z5","duration":30,"pace":{"value":211}},{"kind":"RECOVER","duration":300,"pace":{"value":338}},{"kind":"Z3","duration":480,"pace":{"value":317}},{"kind":"Z4","duration":180,"pace":