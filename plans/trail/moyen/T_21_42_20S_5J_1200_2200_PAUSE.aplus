n":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Qu'en est-il de l'amélioration de tes capacités cardio-respiratoires ? Tu devrais vraiment être très à l'aise à ton allure de footing arrivé(e) à ce stade de ta préparation ! Lorsqu'on est en forme, les footings, ce sont des entraînements où on a presque l'impression d'être aussi frais en revenant qu'avant d'être parti ! (et si tu es parti déjà fatigué(e) à cause de l'entraînement fractionné de la veille par exemple... alors tu ne devrais pas être plus fatigué(e) encore en rentrant sinon mieux vaut raccourcir le footing avant de rentrer dans cet état d'accumulation de fatigue supplémentaire!)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":328}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Sprint_600_Cote_2","description":"Séance d'endurance de force **EN COTE** en **deux blocs identiques**. Il y a **3 intervalles de 30\"** par bloc, chacun suivi par 3' de repos courues très lentement et/ou marchées. À la fin du premier bloc, après le dernier sprint de 30\", prends 5' *(soit 2' de bonus !)* puis recommence une seconde fois ce même bloc.","displayName":"Coup de bourre","coachAdvice":"Même conseil sur cette deuxième séance que pour la première : vas-y progressivement afin d'éviter les blessures et laisser à ton corps le temps de s’adapter. Si tu n'as jamais sprinté, ne cherche pas encore la vitesse max max sur ces quelques intervalles","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"Sprint_Cote_30","exerciseType":"running","pace":{"name":"Sprint","value":154,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"sprint","context":"intensity","perception":"maximal"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_3","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":341,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2","exerciseType":"recuperation","pace":{"n