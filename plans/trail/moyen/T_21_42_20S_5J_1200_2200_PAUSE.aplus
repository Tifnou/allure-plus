,"MughEP8eQ-GpAU3UAuq4vw","KhwfJTSpQnC9A_jbhCP1oQ","CkXpOTEqSV-8leBx6r4Xcg","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1786924800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a68a133ba18ec460533052d","cycleTheme":"S60_Cote","cycleDescription":"Ce cycle de S60 en côte est le versant \"endurance\" de ton travail au seuil qui nous permet d'adapter votre plan en fonction de votre profil. Faire ce travail en côte plus ou moins proche de ta course nous permet de nous adapter à la spécificité de celle-ci. C'est un cycle exigeant par la longueur des intervalles mais sur lequel on se sent fort, et fier de soi et de ses progrès à son issue.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":598.4959158726041,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.67149441351467,"dvalue":11.60465580828433,"abstract":true,"competitive":false},{"slug":"fast","value":191.99292907785062,"dvalue":5.695605215976205,"abstract":true,"competitive":false},{"slug":"sprint","value":153.71907762424277,"dvalue":3.253784106791965,"abstract":true,"competitive":false},{"slug":"ef","value":327.7982420762829,"dvalue":20.095226636966437,"abstract":false,"competitive":false},{"slug":"tempo","value":299.77855501079915,"dvalue":16.68202364758684,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.1153201523854,"dvalue":13.05855220554909,"abstract":false,"competitive":false},{"slug":"aerobie","value":318.08105357361956,"dvalue":18.89112820516807,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.67149441351467,"dvalue":11.60465580828433,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.901768350837,"dvalue":10.276067769701456,"abstract":false,"competitive":false},{"slug":"vma","value":211.7813132317028,"dvalue":7.376949525020798,"abstract":false,"competitive":false},{"slug":"marathon","value":289.1364037805356,"dvalue":14.253327692093999,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.97948566494557,"dvalue":12.49675753523514,"abstract":false,"competitive":true},{"slug":"10km","value":247.70207526674346,"dvalue":10.872913813181013,"abstract":false,"competitive":true},{"slug":"5km","value":234.3135180039806,"dvalue":9.512792667442518,"abstract":false,"competitive":true},{"slug":"1500m","value":212.7552907730599,"dvalue":7.464818299611742,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":340.4641471334118,"dvalue":21.695557460082043,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":327.7982420762829,"dvalue":20.095226636966437,"abstract":true,"competitive":false},{"slug":"endurance-active","value":318.08105357361956,"dvalue":18.89112820516807,"abstract":true,"competitive":false},{"slug":"vo2max","value":211.7813132317028,"dvalue":7.376949525020798,"abstract":true,"competitive":false},{"slug":"race","value":424,"dvalue":14.718659994643085,"abstract":false,"competitive":true,"race":{"distance":35,"elevation":1500,"goalId":"6a68a133ba18ec460533052d","timeLowerBound":14847,"timeUpperBound":17817}}],"sessions":[{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - AUTRE - SEMAINE 3 SEANCE 1","description":"Séance en 3 blocs. Les deux premiers blocs sont composés respectivement de 3 et 2 séries de 2 exercices enchainés sans pause. Le troisième bloc est composé de 2 séries de 2x2 exercices différents alternés, enchainés sans pause. Prend 1'  de récupération entre les séries des bloc 1 et 2, et 2' entre les séries du bloc 3. ","displayName":"Renforcement","coachAdvice":"Le renforcement régulier améliore ta performance en course, prévient dans une certaine mesure des blessures, mais c'est surtout un investissement primordial pour ta santé ! Je sais que ça vend moins du rêve qu'un RP sur 10km, mais c'est important de le rappeler.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":3,"exercises":[{"_t":"SmartPPGExercise","name":"Extension de Mollet"