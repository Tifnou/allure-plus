, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing léger avec quelques lignes droites en accélération progressive pour garder le rythme, sans forcer.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_44","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":44,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":209,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":337,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1794182400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":2640,"pace":{"value":324}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"RECOVER","duration":45,"pace":{"value":337}},{"kind":"Z5","duration":15,"pace":{"value":209}},{"kind":"REC