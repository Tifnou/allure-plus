P","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci ! (je me répète, mais c'est important !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_45","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":45,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1785715200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":328}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Sprint_600_Cote_1","description":"Séance d'endurance de force **EN COTE** où tu vas répéter 5 efforts de 30\" à très haute intensité séparés par 3' de récupération courues très lentement et/ou marchées entre les efforts.","displayName":"Sprint en côte","coachAdvice":"Bienvenue dans ta première séance de Sprint. Cette zone est simple : théoriquement, tu donnes tout, c’est à fond ! Mais sur cette première séance, prends ton temps pour y aller progressivement afin d'éviter les blessures et laisser à ton corps le temps de s’adapter. C'est pour ça aussi qu'il y a très très peu de séries.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartTrailV2Exercise","name":"Sprint_Cote_30","exerciseType":"running","pace":{"name":"Sprint","value":154,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"sprint","context":"intensity","perception":"maximal"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_3","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":341,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":10,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":5,"weekDate":1785715200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2850},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":328}},{"kind":"Z5","duration":30,"pace":{"value":154}},{"kind":"RECOVER","duration":180,"pace":{"value":341}},{"kind":"Z5","duration":30,"pace":{"value":154}},{"kind":"RECOVER","duration":180,"pace":{"value":341}},{"kind":"Z5","duration":30,"pace":{"value":154}},{"kind":"RECOVER","duration":180,"pace":{"value":341}},{"kind":"Z5","duration":30,"pace":{"value":154}},{"kind":"RECOVER","duration":180,"pace":{"value":341}},{"kind":"Z5","duration":30,"pace":{"value":154}},{"kind":"RECOVER","duration":180,"pace":{"value":341}},{"kind":"RECOVER","duration":600,"pace":{"value":328}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_60","description":"Sortie longue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Sortie Longue","coachAdvice":"Une sortie longue d'une heure qui devrait bien se passer. Selon ta forme actuelle, ça te paraîtra plus ou moins facile. Dans les deux cas, on y va sans forcer, quitte à courir plus lentement que l'allure prévue !","test":false,"importance":true,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_60","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":60,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":6,"weekDate":1785715200000,"status":"t