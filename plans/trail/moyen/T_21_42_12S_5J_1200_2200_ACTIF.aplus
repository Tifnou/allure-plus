mentale","value":326.7690771533701,"dvalue":20.032135077226055,"abstract":true,"competitive":false},{"slug":"endurance-active","value":317.0823970191865,"dvalue":18.831817067988503,"abstract":true,"competitive":false},{"slug":"vo2max","value":211.1163984428805,"dvalue":7.353788639101579,"abstract":true,"competitive":false},{"slug":"race","value":423,"dvalue":14.664330216478085,"abstract":false,"competitive":true,"race":{"distance":35,"elevation":1500,"goalId":"6a689fb7ba63bbdf0cae24cf","timeLowerBound":14797,"timeUpperBound":17756}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Comme l'indique la description de l'entrainement, si tu te sens très fatigué(e), n'hésite pas à supprimer les lignes droites et rentre directement te reposer ! Elles sont optionnelles, pour garder le corps habitué à des intensités très élevées, mais le principal est de ne pas générer de fatigue inutile ici.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_44","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":44,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":211,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":2640,"pace":{"value":327}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}},{"kind":"Z5","duration":15,"pace":{"value":211}},{"kind":"RECOVER","duration":45,"pace":{"value":339}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S60_4x5_Cote_Affutage","description":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **4 répétitions de 5' (dont les 3ère minutes courues à plat)** à l'allure cible entrecoupées de 2' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"Maîtrise ton effort : Une séance avec quelques intervalles de 5 minutes à S60, tu sais que tu dois avoir de la marge ! Garde un bon contrôle sur ton effort pour ne pas trop solliciter ton corps à 5 semaines de 