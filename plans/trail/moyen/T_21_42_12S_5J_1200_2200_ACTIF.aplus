:"M5026Ab3Q401vJOFGhcl12k2vHGGcBQTdL","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730152399-dsc3808.png","muxPlaybackId":"F7y9xZJd7bQBiTwtbhIrhoGpSQkNRTDQ","format":"mobile"}]}],"gear":"nothing","name":"Bond sur place"}},{"_t":"SmartPPGExercise","name":"Récupération","exerciseType":"recuperation","sport":"ppg","difficulty":"recovery","repeat":1,"durations":[{"value":2,"timeUnit":"minutes"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":3,"trainingIndex":0,"weekDate":1785110400000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Et l'amélioration de tes capacités cardio-respiratoires dans tout ça ? À ce stade de ta préparation, tu devrais vraiment être très à l'aise à ton allure de footing !\nQuand on est en forme, les footings deviennent presque des séances où l'on a l'impression d'être aussi frais en rentrant qu'au moment de partir. C'est un excellent signe que ton endurance et ton efficacité cardiovasculaire progressent.\nEt si tu es déjà parti(e) avec un peu de fatigue, par exemple à cause d'une séance de fractionné la veille, tu ne devrais pas te sentir plus fatigué(e) en rentrant. Si c'est le cas, mieux vaut raccourcir le footing et privilégier la récupération plutôt que d'accumuler de la fatigue inutilement.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_45","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":45,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1785110400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":329}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S60_600_Cote6'+_1","description":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **3 répétitions de 5'** à l'allure cible entrecoupées de 4' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"C’est plaisant de te dire que tu es capable, chaque semaine, d’en faire un peu plus sans que ce soit plus difficile, non ? Doucement, mais sûrement, c’est ça le vrai dicton des coureurs qui progressent !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_5","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_4","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":342,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":4,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":2,"weekDate":1785110400000,"status":"todo","nutritionTraining":{"_id":"6a689fbeba18ec460532e088","userId":"642ab60364e5867bee895c04","weekDate":1785110400000,"sessionIndex":2,"choRecommendation":1,"formSuggestions":["liquid","semi-liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":200,"metric":"mL"},"cho":{"value":12,"metric":"g"},"sodium":{"value":820,"metric":"mg"}}}],[{"datoId":"UMD5Rt1ESQ25KBXonqCm0A","name":"Jus de pomme","form":"liquid","info":{"quantity":{"value":110,"metric":"mL"},"waterQuantity":{"value":90,"metr