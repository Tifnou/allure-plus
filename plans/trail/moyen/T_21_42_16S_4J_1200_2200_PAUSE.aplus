ti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument se retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_35","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":35,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1794787200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":324}}]}],"weekStats":{"expectedDistance":0,"realDistance":0,"expectedDuration":5700,"realDuration":0},"exportStatus":"NotAvailable","coach":{"name":"Mathieu","image":"https://www.datocms-assets.com/89756/1765362554-mathieu-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a68a137ce2d2a7e262ea64f","articles":["ObXpXK6XSy-fr8_aJhItFQ","QB1sNGPsRy-aei2soIIDqw","dgsePT-nShKX46VBnUlUXw","PZ79_sDhQ92F1pymQ4jURg","IR41UZMyTvy6zATk95KoCQ"],"weekDate":1795392000000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a68a133ba18ec460533052d","cycleTheme":"post-competition","cycleDescription":"Ce \"bloc\" permet de t'octroyer le repos nécessaire (et mérité) après ta course, puis de reprendre progressivement avant la suite de ton plan d'entrainement.","isStatic":true},"estimatedPaces":[{"slug":"slow","va