","_id":"6a68a137ce2d2a7e262ea641","articles":["KhwfJTSpQnC9A_jbhCP1oQ","JZ0pBc-cQD2GTbh_DhOYFQ","Yx4bBDCtSQ6jE-YU2wD3Pg","R42mZwR8TZSX6PAemoh0GA","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1786924800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a68a133ba18ec460533052d","cycleTheme":"S60_Cote","cycleDescription":"Ce cycle de S60 en côte est le versant \"endurance\" de ton travail au seuil qui nous permet d'adapter votre plan en fonction de votre profil. Faire ce travail en côte plus ou moins proche de ta course nous permet de nous adapter à la spécificité de celle-ci. C'est un cycle exigeant par la longueur des intervalles mais sur lequel on se sent fort, et fier de soi et de ses progrès à son issue.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":598.8725944470133,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.83177837354552,"dvalue":11.61195949255426,"abstract":true,"competitive":false},{"slug":"fast","value":192.11376469410754,"dvalue":5.69918988948233,"abstract":true,"competitive":false},{"slug":"sprint","value":153.8158246219806,"dvalue":3.255831958291495,"abstract":true,"competitive":false},{"slug":"ef","value":328.0045502084598,"dvalue":20.107874077193344,"abstract":false,"competitive":false},{"slug":"tempo","value":299.9672282427214,"dvalue":16.69252290199975,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.28406532489845,"dvalue":13.06677093636777,"abstract":false,"competitive":false},{"slug":"aerobie","value":318.2812459469159,"dvalue":18.90301781552728,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.83177837354552,"dvalue":11.61195949255426,"abstract":false,"competitive":false},{"slug":"seuil30","value":242.05401536010294,"dvalue":10.282535273414295,"abstract":false,"competitive":false},{"slug":"vma","value":211.9146031690925,"dvalue":7.381592395183953,"abstract":false,"competitive":false},{"slug":"marathon","value":289.33297225410166,"dvalue":14