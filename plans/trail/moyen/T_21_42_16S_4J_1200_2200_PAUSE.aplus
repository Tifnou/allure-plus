perBound":17636}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Qu'en est-il de l'amélioration de tes capacités cardio-respiratoires ? Tu devrais vraiment être très à l'aise à ton allure de footing arrivé(e) à ce stade de ta préparation ! Lorsqu'on est en forme, les footings, ce sont des entraînements où on a presque l'impression d'être aussi frais en revenant qu'avant d'être parti ! (et si tu es parti déjà fatigué(e) à cause de l'entraînement fractionné de la veille par exemple... alors tu ne devrais pas être plus fatigué(e) encore en rentrant sinon mieux vaut raccourcir le footing avant de rentrer dans cet état d'accumulation de fatigue supplémentaire!)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1794182400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S30_5x1-2_Cote_Affutage","description":"Séance de seuil 30' **EN COTE** où tu vas enchaîner **5 répétitions de 1'** à l'allure cible entrecoupées de 2' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 30","coachAdvice":"Sortie i