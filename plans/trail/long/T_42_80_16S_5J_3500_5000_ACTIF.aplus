"value":0,"metric":"mg"}}}],[{"datoId":"CobrX8IwSw2uKueLLZanOQ","name":"Velouté de tomates","form":"liquid","info":{"quantity":{"value":150,"metric":"mL"},"cho":{"value":9.6,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}},{"datoId":"cIWG8YzzRH-IaDrPzZ58_Q","name":"Pâte de fruit","form":"solid","info":{"quantity":{"value":1,"metric":"item"},"cho":{"value":21,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}]]}}},"stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2460},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":325}},{"kind":"Z4","duration":180,"pace":{"value":253}},{"kind":"Z4","duration":120,"pace":{"value":253}},{"kind":"RECOVER","duration":120,"pace":{"value":338}},{"kind":"Z4","duration":180,"pace":{"value":253}},{"kind":"Z4","duration":120,"pace":{"value":253}},{"kind":"RECOVER","duration":120,"pace":{"value":338}},{"kind":"Z4","duration":180,"pace":{"value":253}},{"kind":"Z4","duration":120,"pace":{"value":253}},{"kind":"RECOVER","duration":120,"pace":{"value":338}},{"kind":"RECOVER","duration":300,"pace":{"value":325}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Qu'en est-il de l'amélioration de tes capacités cardio-respiratoires ? Tu devrais vraiment être très à l'aise à ton allure de footing arrivé(e) à ce stade de ta préparation ! Lorsqu'on est en forme, les footings, ce sont des entraînements où on a presque l'impression d'être aussi frais en revenant qu'avant d'être parti ! (et si tu es parti déjà fatigué(e) à cause de l'entraînement fractionné de la veille par exemple... alors tu ne devrais pas être plus fatigué(e) encore en rentrant sinon mieux vaut raccourcir le footing avant de rentrer dans cet état d'accumulation de fatigue supplémentaire!)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":325}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_45+5LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing / lignes droites, c'est un classique des coureurs ! Ça ne fatigue pas mais ça permet de garder le corps en mode \"entraînement\". Pas de rythmes précis sur les lignes droites, vas y progressivement, selon tes sensations !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":5,"ex