allure cible entrecoupées de 3' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"Les séances sont maintenant bien longues, ça en fait du temps passé dans cette zone ! Être capable de mener cette séance à son terme, c’est la preuve que tu as énormément progressé depuis le début de ton entraînement. Alors vas-y, termine cette séance et sois fier de toi et du chemin parcouru.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_4","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":4,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_3","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":tr