vant d'attaquer le bloc suivant !","displayName":"Variation d'allure","coachAdvice":"Sortie intense de ta semaine. Fais en sorte d'y arriver le plus reposé(e) possible pour la valider sans soucis.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EA_Plat_6","exerciseType":"running","pace":{"name":"Endurance active","value":318,"kind":"abstract","zoneKind":"Z3","abstract":true,"slug":"endurance-active","context":"pace","perception":"moderate"},"durations":[{"value":6,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"S30_Cote_2","exerciseType":"running","pace":{"name":"Seuil 30","value":242,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil30","context":"intensity","perception":"high"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"VMA_Cote_0.5","exerciseType":"running","pace":{"name":"VO2max","value":212,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":340,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncli