32146498,"dvalue":18.733378694958308,"abstract":false,"competitive":false},{"slug":"seuil60","value":252.54487163737306,"dvalue":11.50775165570921,"abstract":false,"competitive":false},{"slug":"seuil30","value":239.88177859364606,"dvalue":10.190257931350496,"abstract":false,"competitive":false},{"slug":"vma","value":210.01284297036912,"dvalue":7.315348642226735,"abstract":false,"competitive":false},{"slug":"marathon","value":286.52930463318063,"dvalue":14.11329244145727,"abstract":false,"competitive":true},{"slug":"half-marathon","value":260.6082394853419,"dvalue":12.37337079681856,"abstract":false,"competitive":true},{"slug":"10km","value":245.46858318210047,"dvalue":10.764979619874106,"abstract":false,"competitive":true},{"slug":"5km","value":232.20074851174616,"dvalue":9.417867172348203,"abstract":false,"competitive":true},{"slug":"1500m","value":210.83690854959315,"dvalue":7.389665805832356,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":337.62111669759116,"dvalue":21.51438969043452,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":325.0609777068097,"dvalue":19.927422357353933,"abstract":true,"competitive":false},{"slug":"endurance-active","value":315.424932146498,"dvalue":18.733378694958308,"abstract":true,"competitive":false},{"slug":"vo2max","value":210.01284297036912,"dvalue":7.315348642226735,"abstract":true,"competitive":false},{"slug":"race","value":694,"dvalue":17.629352072260954,"abstract":false,"competitive":true,"race":{"distance":70,"elevation":5000,"goalId":"6a71f13f66243566f733f28a","timeLowerBound":48604,"timeUpperBound":58325}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_60+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Du footing et quelques lignes droites en accélération progressive, sans forcer, c'est tout ! Les lignes droites c'est vraiment censé faire du bien ! L'accélération progressive permet d'adapter le rythme à comment tu sens ton corps et au fur et à mesure des lignes droites d'allonger la foulée et de sentir que tout se met en place, que tu es plus à l'aise !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_54","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":54,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":210,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":338,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3600},"paceZones":[{"kind":"Z2","duration":3240,"pace":{"value":325}},{"kind":"Z5","duration":15,"pace":{"value":210}},{"kind"