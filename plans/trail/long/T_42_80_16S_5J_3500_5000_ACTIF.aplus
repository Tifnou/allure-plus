","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Objectif de ta semaine ? La récup, la récup et la récup ! Interdit d'accélérer aujourd'hui c'est endurance fondamentale stricte... et même si ça te semble rabat-joie, c'est pour ton bien, tu nous remercieras quand tu seras au top de ta forme à la fin du plan ! :)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":328}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30+5LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"On démarre de manière classique par un bon footing et en fin de séance un peu de piment avec quelques accélérations. Rien de difficile, c'est court, c'est rapide, mais pas à fond et tu as suffisament de récupération ensuite pour que le cardio ne s'affole pas !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_25","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":25,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":212,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":341,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1500,"pace":{"value":328}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":341}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":341}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":341}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":341}},{"kind":"Z5","duration":15,"pace":{"value":212}},{"kind":"RECOVER","duration":45,"pace":{"value":341}}]},{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - AUTRE - SEMAINE 2 SEANCE 2","description":"Séance en 3 blocs. Les deux premiers blocs sont composés respectivement de 3 et 2 séries de 2 exercices enchainés sans pause. Le troisième bloc est composé de 2 séries de 2x2 exercices différents alternés, enchainés sans pause. Prend 1'  de récupération entre les séries des bloc 1 et 2, et 2' entre les séries du bloc 3. ","displayName":"Renforcement","coachAdvice":"Même si les intensités les plus hautes de la séance, n'oublions pas que le renforcement est au service de la course à pied et non à son détriment. Si tu vois que tu as trop de courbatures ou de fatigue le lendemain soit tu peux laisser plus de récupération, soit tu peux diminuer l'intensité de la séance.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":3,"exercises":[{"_t":"SmartPPGExercise","name":"Extension de Mollet","exerciseType":"ppg","sport":"ppg","difficulty":"intense","repeat":12,"durations":[],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Extension de Mollet à 2 pieds","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730394699-dsc4256.png","muxPlaybackId":"LRwmfIIbjAq00CUzgNV9QJD00cjxpce6mY","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730394699-dsc4256.png","muxPlaybackId":"wEJw8kcN6TSOZ2k7EYrOxnzFlrfkS3XX","format":"mobile"}]},{"name":"Extension de Mollet à 1 pied","description":"","variationType":"standard","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730394758-dsc4263.png","muxPlaybackId":"1R00Rw81qTAo69DGhdMVO1ZhipUK5euzU","format":"desktop"},{"thumbnail":"https://image.mux.com/dlCXEee8u01EZxzO1zB7raAYosslztFte/thumbnail.jpg","muxPlaybackId":"dlCXEee8u01EZxzO1zB7raAYosslztFte","format":"mobile"}]},{"name"