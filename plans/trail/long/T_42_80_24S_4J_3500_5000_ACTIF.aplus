u-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a71f2d966243566f73403d4","articles":["ZRLmRmhpR9OMI7QfSdLgaA","GssCR6PsTvu-36aGA22sVQ","AQwjEThpTP6QmbD660yf6A","HlEzYHpMSqaOeUrHN-AINg","AIUsETPtRPO4y4qIFgpyww"],"weekDate":1791158400000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a71f13f66243566f733f28a","cycleTheme":"Var_VMA_S30_SS_Cote","cycleDescription":"La variation de vitesse en côte, un type de travail que nous avons démocratisé à la base sur route avec Campus. Tout en étant très pertinent pour progresser, il est l'un des cycles préférés de nos coureurs et on l'a adapté pour s'adapter aux traileurs ! Dans ta préparation, il permet de renforcer d'une nouvelle façon des qualités déjà travaillées.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":595.24310830195,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.28736238673144,"dvalue":11.541584847786643,"abstract":true,"competitive":false},{"slug":"fast","value":190.94945319663915,"dvalue":5.664649770375585,"abstract":true,"competitive":false},{"slug":"sprint","value":152.88361899171193,"dvalue":3.236099886573992,"abstract":true,"competitive":false},{"slug":"ef","value":326.0166683425368,"dvalue":19.986009675571736,"abstract":false,"competitive":false},{"slug":"tempo","value":298.1492674460924,"dvalue":16.591357343313742,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":266.6581213310223,"dvalue":12.987579361208008,"abstract":false,"competitive":false},{"slug":"aerobie","value":316.3522924714865,"dvalue":18.788455483075413,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.28736238673144,"dvalue":11.541584847786643,"abstract":false,"competitive":false},{"slug":"seuil30","value":240.58703940686564,"dvalue":10.220217645830333,"abstract":false,"competitive":false},{"slug":"vma","value":210.6302880689013,"dvalue":7.336856022915042,"abstract":false,"competitive":false},{"slug":"marathon",