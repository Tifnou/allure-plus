és physiques. Rien de compliqué, on révise juste les bases en générant un minimum de fatigue ! Ne va pas plus vite que les temps prévus, tu dois finir assez \"frais\" en fin de séance signe que la semaine de récup est efficace !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartTrailV2Exercise","name":"VMA_Plat_0.5","exerciseType":"running","pace":{"name":"VO2max","value":211,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"S60_Plat_2","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"EA_Plat_2","exerciseType":"running","pace":{"name":"Endurance active","value":316,"kind":"abstract","zoneKind":"Z3","abstract":true,"slug":"endurance-active","context":"pace","perception":"moderate"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Flat_5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit":