ock block 1/2","description":"Sortie longue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Bloc choc 1/2","coachAdvice":"WEEK END CHOC 1/2 - J'aime bien profiter de certte première sortie d'un week end choc pour travailler mes descentes. Pas trop fort non plus sinon demain ça va être compliqué, mais juste profiter d'être lucide (contrairement à demain) pour gagner en assurance sur cette partie essentielle du trail.","test":false,"importance":true,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_125","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":125,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1789948800000,"status":"todo","nutritionTraining":{"_id":"6a71fca88fada0a2a9c98e80","userId":"642ab60364e5867bee895c04","weekDate":1789948800000,"sessionIndex":4,"choRecommendation":4,"formSuggestions":["liquid","semi-liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":2,"metric":"item"},"cho":{"value":54,"metric":"g"},"sodium":{"value":2,"metric":"mg"}}},{"datoId":"UcYsNX-mTmaYXlFoDFwiAg","name":"Purée énergétique salée pommes de terre","form":"semi-liquid","info":{"quantity":{"value":4,"metric":"item"},"cho":{"value":72,"metric":"g"},"sodium":{"value":640,"metric":"mg"}}},{"datoId":"d2Xmi074S8qN0vgyfiujiw","name":"Eau","form":"liquid","info":{"quantity":{"value":500,"metric":"mL"},"cho":{"value":0,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}],[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"qua