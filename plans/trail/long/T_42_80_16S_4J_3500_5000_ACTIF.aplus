'est un cycle exigeant par la longueur des intervalles mais sur lequel on se sent fort, et fier de soi et de ses progrès à son issue.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":595.7424072689787,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.49982367630756,"dvalue":11.551266104590795,"abstract":true,"competitive":false},{"slug":"fast","value":191.109624500441,"dvalue":5.6694013647065065,"abstract":true,"competitive":false},{"slug":"sprint","value":153.01186009517625,"dvalue":3.238814376348056,"abstract":true,"competitive":false},{"slug":"ef","value":326.29013607944506,"dvalue":20.002774244277962,"abstract":false,"competitive":false},{"slug":"tempo","value":298.39935958354,"dvalue":16.605274426044446,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":266.8817982164384,"dvalue":12.998473540189353,"abstract":false,"competitive":false},{"slug":"aerobie","value":316.61765358301415,"dvalue":18.804215525121972,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.49982367630756,"dvalue":11.551266104590795,"abstract":false,"competitive":false},{"slug":"seuil30","value":240.78884747247943,"dvalue":10.228790519740505,"abstract":false,"competitive":false},{"slug":"vma","value":210.80696795614566,"dvalue":7.343010289268379,"abstract":false,"competitive":false},{"slug":"marathon","value":287.69979597316046,"dvalue":14.17614992952133,"abstract":false,"competitive":true},{"slug":"half-marathon","value":261.67284154353456,"dvalue":12.428754591818699,"abstract":false,"competitive":true},{"slug":"10km","value":246.47133873347275,"dvalue":10.813426656258942,"abstract":false,"competitive":true},{"slug":"5km","value":233.1493040726434,"dvalue":9.460474563433838,"abstract":false,"competitive":true},{"slug":"1500m","value":211.69819139785656,"dvalue":7.423397175566052,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":338.8977689284893,"dvalue":21.595742402798486,"abstract":true,"competit