ation":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci ! (je me répète, mais c'est important !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1789344000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"