":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":327}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Sprint_600_Cote_4","description":"Séance d'endurance de force **EN COTE** où tu vas répéter 6 efforts de 30\" à très haute intensité séparés par 3' de récupération courues très lentement et/ou marchées entre les efforts.","displayName":"Sprint en côte","coachAdvice":"À cette vitesse, les forces générées par l'impact sont énormes. Les bénéfices le sont tout autant, mais cela ne doit jamais se faire au détriment de la douleur ou de l'aggravation d'une blessure. Si tu ressens de la douleur ou si tu n’es pas en forme, ralentis, ce n’est pas grave.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"Sprint_Cote_30","exerciseType":"running","pace":{"name":"Sprint","value":154,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"sprint","context":"intensity",