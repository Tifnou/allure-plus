e":"Boisson isotonique ","form":"liquid","info":{"quantity":{"value":200,"metric":"mL"},"cho":{"value":14,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}},{"datoId":"QwwlR0MuTimqKd6DYhEoSQ","name":"Pâte d'amande","form":"solid","info":{"quantity":{"value":2,"metric":"item"},"cho":{"value":28,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}]]}}},"stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3240},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":323}},{"kind":"Z3","duration":180,"pace":{"value":313}},{"kind":"RECOVER","duration":60,"pace":{"value":335}},{"kind":"Z3","duration":180,"pace":{"value":313}},{"kind":"RECOVER","duration":60,"pace":{"value":335}},{"kind":"Z3","duration":180,"pace":{"value":313}},{"kind":"RECOVER","duration":60,"pace":{"value":335}},{"kind":"Z3","duration":180,"pace":{"value":313}},{"kind":"RECOVER","duration":60,"pace":{"value":335}},{"kind":"Z3","duration":180,"pace":{"value":313}},{"kind":"RECOVER","duration":60,"pace":{"value":335}},{"kind":"Z3","duration":180,"pace":{"value":313}},{"kind":"RECOVER","duration":60,"pace":{"value":335}},{"kind":"RECOVER","duration":600,"pace":{"value":323}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci ! (je me répète, mais c'est important !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":323,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1798416000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":323}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_45+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Quelques lignes droites en plus du traditionnel footing. De quoi te faire plaisir car il n'y a aucun objectif d'allure, juste de sentir que ton corps se libère et te permet d'accélérer progressivement de ligne droite en ligne droite !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_39","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":323,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":39,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":208,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":3,"weekDate":1798416000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2340,"pace":{"value":323}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_95_15AC_Affutage","description":"Sortie longue d'1h35 en endurance confort avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, envie...). Le bloc actif est composé d'15' à allure course en continues","displayName":"Sortie Longue & Active","coachAdvice":"Les 1h30 d'effort qu'on te propose aujourd'hui vont continuer de bien développer ton endurance longue. Essaie encore une fois de courir relâché(e) et de finir ta sortie en ayant l'impression d'en avoir encore sous le pied !