:"trailV2","name":"Sprint_600_Cote_2","description":"Séance d'endurance de force **EN COTE** en **deux blocs identiques**. Il y a **3 intervalles de 30\"** par bloc, chacun suivi par 3' de repos courues très lentement et/ou marchées. À la fin du premier bloc, après le dernier sprint de 30\", prends 5' *(soit 2' de bonus !)* puis recommence une seconde fois ce même bloc.","displayName":"Coup de bourre","coachAdvice":"Même conseil sur cette deuxième séance que pour la première : vas-y progressivement afin d'éviter les blessures et laisser à ton corps le temps de s’adapter. Si tu n'as jamais sprinté, ne cherche pas encore la vitesse max max sur ces quelques intervalles","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"Sprint_Cote_30","exerciseType":"running","pace":{"name":"Sprint","value":154,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"sprint","context":"intensity","perception":"maximal"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_3","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":341,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2","exerciseType":"recuperation","pace":{"name":"Endur