62290c63b4cf01","cycleTheme":"VMA_Cote","cycleDescription":"Le classique du classique en course à pied ! Un cycle qu'on a adapté en volume et dans sa progressivité pour correspondre à tonprofil. Le choix de faire ce travail en côte nous permet aussi d'adapter, quand il le faut, ton programme à la spécificité de ton objectif\n","isStatic":false},"estimatedPaces":[{"slug":"slow","value":600.3808892259234,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":255.47358673877213,"dvalue":11.641204874690503,"abstract":true,"competitive":false},{"slug":"fast","value":192.5976141654835,"dvalue":5.713543624206586,"abstract":true,"competitive":false},{"slug":"sprint","value":154.20321854740337,"dvalue":3.264031956737294,"abstract":true,"competitive":false},{"slug":"ef","value":328.8306483721182,"dvalue":20.158516904677544,"abstract":false,"competitive":false},{"slug":"tempo","value":300.72271281222356,"dvalue":16.73456397279405,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.9597540419081,"dvalue":13.099680344083659,"abstract":false,"competitive":false},{"slug":"aerobie","value":319.08285541433503,"dvalue":18.950626143811395,"abstract":false,"competitive":false},{"slug":"seuil60","value":255.47358673877213,"dvalue":11.641204874690503,"abstract":false,"competitive":false},{"slug":"seuil30","value":242.66364220054774,"dvalue":10.308432424846249,"abstract":false,"competitive":false},{"slug":"vma","value":212.44832218128028,"dvalue":7.4001833565552495,"abstract":false,"competitive":false},{"slug":"marathon","value":290.12017016456724,"dvalue":14.306196385015847,"abstract":false,"competitive":true},{"slug":"half-marathon","value":263.87425496519415,"dvalue":12.543342223207015,"abstract":false,"competitive":true},{"slug":"10km","value":248.54486424701753,"dvalue":10.913665806458258,"abstract":false,"competitive":true},{"slug":"5km","value":235.11075335491716,"dvalue":9.548634306135257,"abstract":false,"competitive":true},{"slug":"1500m",