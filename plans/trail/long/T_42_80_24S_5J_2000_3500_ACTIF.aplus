cile.","displayName":"Endurance Fondamentale","coachAdvice":"Bien que l'EF soit fondamentale pour ta progression (c'est dans le nom), il est important de ne pas te surmener à ce stade. Si tu te sens fatigué, ajuste la durée de tes sorties pour éviter l'épuisement. L'objectif est de rester en forme sans compromettre tes ressources pour la course.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":323,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1796601600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":323}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_55+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing léger avec quelques lignes droites en accélération progressive pour garder le rythme, sans forcer.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_49","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":323,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":49,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":208,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1796601600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3300},"paceZones":[{"kind":"Z2","duration":2940,"pace":{"value":323}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_400_3x70AC_Affutage","description":"Sortie longue de 6h20 en endurance confort avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, envie...). Le bloc actif est composé de 3x70' à allure course, séparées par minimum 5' de récupération en endurance.","displayName":"Sortie Longue & Active","coachAdvice":"Cette sortie longue (la plus longue de tout ton programme) à 4 semaines de la course doit rester spécifique. Alterne entre l'endurance de confort et l'allure de course selon les indications. Profite de cette sortie pour tester ta nutrition et tes équipements comme expliqué dans les articles joints à tes semaines.","test":false,"importance":false,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EC_160","exerciseType":"running","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":160,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"AC_70_Indif","exerciseType":"running","pace":{"name":"Allure course","value":545,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"race","context":"intensity","perception":"target"},"durations":[{"value":70,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_5_Indif","exerciseType":"running","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":323,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":10,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap