","value":283.6244067033225,"dvalue":13.957387538528925,"abstract":false,"competitive":true},{"slug":"half-marathon","value":257.96613508923446,"dvalue":12.236007730701447,"abstract":false,"competitive":true},{"slug":"10km","value":242.97996799475067,"dvalue":10.64482591452882,"abstract":false,"competitive":true},{"slug":"5km","value":229.84664558839307,"dvalue":9.312200631150912,"abstract":false,"competitive":true},{"slug":"1500m","value":208.69939699569642,"dvalue":7.306018161069982,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":334.45107499785405,"dvalue":21.312383627750457,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":322.00886750598096,"dvalue":19.740316881076296,"abstract":true,"competitive":false},{"slug":"endurance-active","value":312.46329811773325,"dvalue":18.55748450853755,"abstract":true,"competitive":false},{"slug":"vo2max","value":208.04095958757472,"dvalue":7.246662297987351,"abstract":true,"competitive":false},{"slug":"race","value":547,"dvalue":16.822130037505104,"abstract":false,"competitive":true,"race":{"distance":70,"elevation":3400,"goalId":"6a68a5100462290c63b4cf01","timeLowerBound":38256,"timeUpperBound":45908}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_65+6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"On accompagne ce footing de quelques lignes droites pour te garder actif dans ta foulée ! Quand tu accélères le rythme, tous tes muscles / tes tendons / tes articulations sont sollicités de manière un peu plus intense et vont ainsi se détendre. C'est contre-intuitif mais comme l'effort est rapide mais pas maximal et qu'il est court, ça ne génère pas de fatigue, juste du positif pour ta foulée !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_59","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":323,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":54,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":208,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1797206400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3600},"paceZones":[{"kind":"Z2","duration":3240,"pace":{"value":323}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","durat