","coachAdvice":"Pour cette sortie longue, concentre-toi sur l’endurance fondamentale et le confort. Ces intensités te permettront de travailler ton endurance tout en évitant une fatigue inutile à trois semaines de l’objectif.","test":false,"importance":false,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EC_60","exerciseType":"running","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":60,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":2,"exercises":[{"_t":"SmartTrailV2Exercise","name":"AC_50_Indif","exerciseType":"running","pace":{"name":"Allure course","value":545,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"race","context":"intensity","perception":"target"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_5_Indif","exerciseType":"running","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":323,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":10,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":5,"weekDate":1797206400000,"status":"todo","nutritionTraining":{"_id":"6a68a6efce2d2a7e262ed88b","userId":"642ab60364e5867bee895c04","weekDate":1797206400000,"sessionIndex":5,"choReco