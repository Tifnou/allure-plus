 . Tes 5' de récupération sont bien méritées avant d'attaquer le bloc suivant !","displayName":"Variation d'allure","coachAdvice":"Sortie intense de ta semaine. Fais en sorte d'y arriver le plus reposé(e) possible pour la valider sans soucis.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":327,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Plat_4","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":4,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"S30_Cote_2","exerciseType":"running","pace":{"name":"Seuil 30","value":241,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil30","context":"intensity","perception":"high"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"VMA_Cote_0.5","exerciseType":"running","pace":{"name":"VO2max","value":211,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":340,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit