ind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_55","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant de speeder pendant tes footings, pas vrai ? On connaît tous ça, c’est tellement simple de se laisser aller. Mais si tu veux vraiment avancer, il faut apprendre à te freiner. Accélérer, même un peu, ça fatigue ton corps et ça risque de te limiter pour ta prochaine séance intense… et donc de ralentir tes progrès. (Je le redis, parce que c’est essentiel !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_55","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":55,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1794182400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3300},"paceZones":[{"kind":"Z2","duration":3300,"pace":{"value":324}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"VarT_600_Cote4'+_4","description":"Séance de variation d'allure avec 3 blocs courus en continu. Première partie du bloc constituée de 6' en endurance active, directement enchaînée *