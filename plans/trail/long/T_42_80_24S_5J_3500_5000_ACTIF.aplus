V2Exercise","name":"EF_55","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":55,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1790553600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3300},"paceZones":[{"kind":"Z2","duration":3300,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S60_600_Cote4'+_3","description":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **5 répétitions de 4'** à l'allure cible entrecoupées de 3' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"L’erreur au S60 est de laisser la fatigue prendre le dessus sur ton efficacité. Plus la séance avance, plus tu fatigues. Plus tu fatigues, moins tu fais attention à ta posture, à ton souffle, à ton gainage. Cela double la fatigue ! Donc, pendant ce cycle, veille à rester concentré sur ces intervalles qui sont longs.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_4","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":4,"timeUnit":"minutes"}],