 objectifs en course à pied, te permet de travailler des muscles, des modes de contraction, ou des amplitude que la course ne sollicite pas directement. C'est cette variété qui va booster l'aspect santé dans ta pratique, et par extenssion, directement ou indirectement, booster tes performances.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":3,"exercises":[{"_t":"SmartPPGExercise","name":"Extension de Mollet","exerciseType":"ppg","sport":"ppg","difficulty":"intense","repeat":12,"durations":[],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Extension de Mollet à 2 pieds","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730394699-dsc4256.png","muxPlaybackId":"LRwmfIIbjAq00CUzgNV9QJD00cjxpce6mY","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730394699-dsc4256.png","muxPlaybackId":"wEJw8kcN6TSOZ2k7EYrOxnzFlrfkS3XX","format":"mobile"}]},{"name":"Extension de Mollet à 1 pied","description":"","variationType":"standard","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730394758-dsc4263.png","muxPlaybackId":"1R00Rw81qTAo69DGhdMVO1ZhipUK5euzU","format":"desktop"},{"thumbnail":"https://image.mux.com/dlCXEee8u01EZxzO1zB7raAYosslztFte/thumbnail.jpg","muxPlaybackId":"dlCXEee8u01EZxzO1zB7raAYosslztFte","format":"mobile"}]},{"name":"Extension Mollet à 1 pied avec charge additionnelle","description":"","variationType":"advanced","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730394833-dsc4270.png","muxPlaybackId":"4IWQj9FusbAG6rA2bIJd6kf3gJzgQCEn","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730394833-dsc4270.png","muxPlaybackId":"01brVbo2iL201c02T5ep7PjTZ00nODTWfkJb","format":"mobile"}]}],"gear":"weights","name":"Extension de Mollet"}},{"_t":"SmartPPGExercise","name":"Gainage Frontal","exerciseType":"ppg","sport":"ppg","difficulty":"intense","durations":[{"val