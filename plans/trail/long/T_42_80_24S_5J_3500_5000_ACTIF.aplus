,"dvalue":7.210294302012781,"abstract":true,"competitive":false},{"slug":"race","value":684,"dvalue":17.333950999106776,"abstract":false,"competitive":true,"race":{"distance":70,"elevation":5000,"goalId":"6a71f13f66243566f733f28a","timeLowerBound":47851,"timeUpperBound":57421}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"À partir de là, tu devrais commencer à voir une amélioration au niveau de ton aisance à courir à cette allure non ? L'endurance fondamentale, c'est une allure extrêmement efficace pour développer ton système cardio-respiratoire. Ses effets commencent à se sentir au bout de quelques semaines seulement donc tu devrais commencer à le sentir ! Sinon, ne perds pas espoir, au contraire, persévère à bien respecter l'allure, ce processus est plus rapide pour certains que d'autres ! :)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":320,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1800230400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":320}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Recup_active_30","description":"La récupération active se fera idéalement sous forme de vélo, de natation, ski de fond ou encore