il en côte plus ou moins proche de ta course nous permet de nous adapter à la spécificité de celle-ci. C'est un cycle exigeant par la longueur des intervalles mais sur lequel on se sent fort, et fier de soi et de ses progrès à son issue.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":589.1594501259741,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":250.69864911720506,"dvalue":11.423624545443532,"abstract":true,"competitive":false},{"slug":"fast","value":188.99786201324562,"dvalue":5.60675444591245,"abstract":true,"competitive":false},{"slug":"sprint","value":151.3210781312138,"dvalue":3.203025458229252,"abstract":true,"competitive":false},{"slug":"ef","value":322.68462813542806,"dvalue":19.781743469928877,"abstract":false,"competitive":false},{"slug":"tempo","value":295.10204488565995,"dvalue":16.42178604489063,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":263.9327527590893,"dvalue":12.85484033027267,"abstract":false,"competitive":false},{"slug":"aerobie","value":313.1190266281018,"dvalue":18.596428831746984,"abstract":false,"competitive":false},{"slug":"seuil60","value":250.69864911720506,"dvalue":11.423624545443532,"abstract":false,"competitive":false},{"slug":"seuil30","value":238.12812927601718,"dvalue":10.11576232367016,"abstract":false,"competitive":false},{"slug":"vma","value":208.47754970663118,"dvalue":7.26186998190552,"abstract":false,"competitive":false},{"slug":"marathon","value":284.26738389960815,"dvalue":13.991884398516486,"abstract":false,"competitive":true},{"slug":"half-marathon","value":258.5509449234947,"dvalue":12.266401259986239,"abstract":false,"competitive":true},{"slug":"10km","value":243.53080415300226,"dvalue":10.671411037347363,"abstract":false,"competitive":true},{"slug":"5km","value":230.36770847389667,"dvalue":9.335579811966625,"abstract":false,"competitive":true},{"slug":"1500m","value":209.17251901896137,"dvalue":7.324524785943495,"abstract":false,"competitive":true},{"slu