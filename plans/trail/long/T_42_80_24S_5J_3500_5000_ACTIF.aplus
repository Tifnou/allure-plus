PP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Cette fois, c'est sûr : le footing est devenu ta sortie la plus agréable ! Avec la forme qui monte, tu dois avoir l'impression de voler pendant tes footings, non ? Si c'est le cas… retiens-toi ! Garde cette allure lente où tu es en total contrôle de ton effort. C'est exactement là que se situe la bonne zone de travail.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1789344000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","spo