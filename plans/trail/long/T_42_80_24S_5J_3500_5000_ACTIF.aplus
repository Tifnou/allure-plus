":1200,"pace":{"value":322}},{"kind":"Z4","duration":60,"pace":{"value":238}},{"kind":"RECOVER","duration":120,"pace":{"value":335}},{"kind":"Z4","duration":60,"pace":{"value":238}},{"kind":"RECOVER","duration":120,"pace":{"value":335}},{"kind":"Z4","duration":60,"pace":{"value":238}},{"kind":"RECOVER","duration":120,"pace":{"value":335}},{"kind":"Z4","duration":60,"pace":{"value":238}},{"kind":"RECOVER","duration":120,"pace":{"value":335}},{"kind":"Z4","duration":60,"pace":{"value":238}},{"kind":"RECOVER","duration":120,"pace":{"value":335}},{"kind":"RECOVER","duration":600,"pace":{"value":322}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_20+3LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Et l'amélioration de tes capacités cardio-respiratoires dans tout ça ? À ce stade de ta préparation, tu devrais vraiment être très à l'aise à ton allure de footing !\nQuand on est en forme, les footings deviennent presque des séances où l'on a l'impression d'être aussi frais en rentrant qu'au moment de partir. C'est un excellent signe que ton endurance et ton efficacité cardiovasculaire progressent.\nEt si tu es déjà parti(e) avec un peu de fatigue, par exemple à cause d'une séance de fractionné la veille, tu ne devrais pas te sentir plus fatigué(e) en rentrant. Si c'est le cas, mieux vaut raccourcir le footing et privilégier la récupération plutôt que d'accumuler de la fatigue inutilement.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"trail_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_17","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":322,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":17,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"LD","exerciseType":"running","pace":{"name":"VO2max","value":208,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":15,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Indif_0.75","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":335,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":45,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1799625600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":1020,"pace":{"value":322}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}},{"kind":"Z5","duration":15,"pace":{"value":208}},{"kind":"RECOVER","duration":45,"pace":{"value":335}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"Competition_XL","description":"Le mot du jour : gestion. La course sera suffisamment longue pour que chaque erreur de rythme se paie plus tard. Prends le temps de trouver ton allure dès le départ et n'hésite pas à marcher dans les montées les plus raides si cela te permet d'économiser ton énergie. Pense à boire et à t'alimenter régulièrement, sans attendre les premiers signes de fatigue. Aujourd'hui, ce n'est pas le plus rapide au départ qui sera récompensé, mais celui ou celle qui saura rester efficace jusqu'au bout. Sois patient(e), régulier(ère) et profite du terrain.","displayName":"Jour de course","coachAdvice":"L'équipe CAMPUS te souhaite bon courage pour ta compétition ! On est tous derrière toi :)","test":false,"importance":false,"trainingType":"Competition","trainingCategory":"trail_competition","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"","exerciseType":"running","pace":{"name":"course","value":684,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"race","context":"intensity","perception":"target"},"durations":[{"value":47880,"timeUnit":"seconds"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":5,"trainingIndex":3,"weekDate":1799625600000,"status":"todo","nutritionTraining":{"_id":"6a71f1d7acae7cee22794abc","userId":"642ab60364e5867bee895c04","weekDate":1799625600000,"sessionIndex":3,"choRecommendation":7,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":6650,"metric":"mL"},"cho":{"value":399,"metric":"g"},"sodium":{"value":27265,"metric":"mg"}}},{"datoId":"OZbi5vJqRs6phchCZtARQQ","name":"Gel énergétique","form":"semi-liquid","info":{"quantity":{"value":5,"metric":"item"},"cho":{"value":122,"metric":"g"},"sodium":{"value":25,"metric":"mg"}}},{"datoId":"AdSspNUrTa-cUILb7xt-4g","name":"Compote de pommes","form":"semi-liquid","info":{"quantity":{"value":15,"metric":"item"},"cho":{"value":225,"metric":"g"},"sodium":{"value":15,"metric":"mg"}}},{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":7.5,"metric":"item"},"cho":{"value":202.5,"metric":"g"},"sodium":{"value":7.5,"metric":"mg"}}},{"datoId":"UcYsNX-mTmaYX