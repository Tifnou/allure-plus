":"vma","value":208.25914023983162,"dvalue":7.254262154813597,"abstract":false,"competitive":false},{"slug":"marathon","value":283.94571330384963,"dvalue":13.974625383500719,"abstract":false,"competitive":true},{"slug":"half-marathon","value":258.2583744732849,"dvalue":12.251195126301019,"abstract":false,"competitive":true},{"slug":"10km","value":243.2552301572001,"dvalue":10.658110238735821,"abstract":false,"competitive":true},{"slug":"5km","value":230.10702954192854,"dvalue":9.323882940451382,"abstract":false,"competitive":true},{"slug":"1500m","value":208.93582408799134,"dvalue":7.315265654322779,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":334.80182685862087,"dvalue":21.33473475403958,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":322.3465707394415,"dvalue":19.761019319775915,"abstract":true,"competitive":false},{"slug":"endurance-active","value":312.7909905410177,"dvalue":18.57694646488666,"abstract":true,"competitive":false},{"slug":"vo2max","value":208.25914023983162,"dvalue":7.254262154813597,"abstract":true,"competitive":false},{"slug":"race","value":688,"dvalue":17.457499176405147,"abstract":false,"competitive":true,"race":{"distance":70,"elevation":5000,"goalId":"6a71f13f66243566f733f28a","timeLowerBound":48166,"timeUpperBound":57799}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_65","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant d’accélérer pendant tes footings, on connaît tous ça ! Mais si tu veux progresser, il faut vraiment résister. Aller plus vite fatigue ton corps (même un peu) et ça t’empêche de donner le meilleur sur ta prochaine séance intense, freinant ainsi tes progrès.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"t