uration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_55","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"Qu'en est-il de l'amélioration de tes capacités cardio-respiratoires ? Tu devrais vraiment être très à l'aise à ton allure de footing arrivé(e) à ce stade de ta préparation ! Lorsqu'on est en forme, les footings, ce sont des entraînements où on a presque l'impression d'être aussi frais en revenant qu'avant d'être parti ! (et si tu es parti déjà fatigué(e) à cause de l'entraînement fractionné de la veille par exemple... alors tu ne devrais pas être plus fatigué(e) encore en rentrant sinon mieux vaut raccourcir le footing avant de rentrer dans cet état d'accumulation de fatigue supplémentaire!)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_55","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":55,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1792368000000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3300},"paceZones":[{"kind":"Z2","duration":3300,"pace":{"value":325}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"VarT_600_Cote4'+_2","description":"Séance de variation d'allure avec 3 blocs courus en continu. Première partie du bloc constituée de 6' en endurance active, directement enchaînée **EN COTE** par la deuxième partie et son 2' au Seuil 30, pour finir (toujours sans pause) par 30\" à VMA. Tes 5' de récupération sont bien méritées avant d'attaquer le bloc suivant !","displayName":"Variation d'allure","coachAdvice":"Sortie intense de ta semaine. Fais en sorte d'y arriver le plus reposé(e) possible pour la valider sans soucis.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EA_Plat_6","exerciseType":"running","pace":{"name":"Endurance active","value":315,"kind":"abstract","zoneKind":"Z3","abstract":true,"slug":"endurance-active","context":"pace","perception":"moderate"},"durations":[{"value":6,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"S30_Cote_2","exerciseType":"running","pace":{"name":"Seuil 30","value":240,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil30","context":"intensity","perception":"high"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"VMA_Cote_0.5","exerciseType":"running","pace":{"name":"VO2max","value":210,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"vo2max","context":"intensity","perception":"very-high"},"durations":[{"value":30,"timeUnit":"seconds"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise"