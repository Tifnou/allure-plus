scription":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **9 répétitions de 3'** à l'allure cible entrecoupées de 2'30 de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"Avec toutes ces séances réalisées, tes sensations doivent commencer à être plus précises. Quelle que soit la longueur des intervalles, tu dois normalement réussir à ne pas te faire surprendre en partant trop vite et à lisser ton effort sur toute la séance. N'oublie pas que si on impose de travailler aux sensations, c'est parce que ce sera ton meilleur allié le jour J.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":9,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_3","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2.5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":336,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":150,"timeUnit":"seconds"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":324,"kind":"abstract","zoneKind":"RECOVER","abstract":