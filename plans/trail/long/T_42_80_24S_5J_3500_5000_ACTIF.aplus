alId":"6a71f13f66243566f733f28a","cycleTheme":"S60_Cote","cycleDescription":"Ce cycle de S60 en côte est le versant \"endurance\" de ton travail au seuil qui nous permet d'adapter votre plan en fonction de votre profil. Faire ce travail en côte plus ou moins proche de ta course nous permet de nous adapter à la spécificité de celle-ci. C'est un cycle exigeant par la longueur des intervalles mais sur lequel on se sent fort, et fier de soi et de ses progrès à son issue.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":591.6348385717478,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":251.75197439148053,"dvalue":11.471621582922271,"abstract":true,"competitive":false},{"slug":"fast","value":189.79194776338275,"dvalue":5.630311557948486,"abstract":true,"competitive":false},{"slug":"sprint","value":151.9568626345907,"dvalue":3.2164831600604438,"abstract":true,"competitive":false},{"slug":"ef","value":324.0404067789592,"dvalue":19.86485764082478,"abstract":false,"competitive":false},{"slug":"tempo","value":296.34193366632553,"dvalue":16.49078315496973,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":265.04168190637114,"dvalue":12.908850705934162,"abstract":false,"competitive":false},{"slug":"aerobie","value":314.43461482837847,"dvalue":18.674562832742648,"abstract":false,"competitive":false},{"slug":"seuil60","value":251.75197439148053,"dvalue":11.471621582922271,"abstract":false,"competitive":false},{"slug":"seuil30","value":239.12863876406433,"dvalue":10.158264300292709,"abstract":false,"competitive":false},{"slug":"vma","value":209.3534805223667,"dvalue":7.292381160236074,"abstract":false,"competitive":false},{"slug":"marathon","value":285.55771448907524,"dvalue":14.061132676784334,"abstract":false,"competitive":true},{"slug":"half-marathon","value":259.72454489333234,"dvalue":12.327413635789807,"abstract":false,"competitive":true},{"slug":"10km","value":244.63622554101178,"dvalue":10.724779382350201,"abstract":fals