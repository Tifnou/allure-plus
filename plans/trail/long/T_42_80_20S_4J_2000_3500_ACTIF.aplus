oupées de 1'30 de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 30","coachAdvice":"C'est ta première séance de Seuil 30, tu vas commencer à prendre tes repères avec cette allure qui te demande un effort constant, mais qui reste tenable sur une certaine durée. Imagine que, quand tu seras bien reposé et en forme, tu devrais être capable de tenir cette intensité pendant 30 minutes. Apprendre à gérer cette douleur et à rester performant, c’est un processus, et tu démarres dès aujourd’hui.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":8,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S30_Cote_1","exerciseType":"running","pace":{"name":"Seuil 30","value":243,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil30","context":"intensity","perception":"high"},"durations":[{"value":1,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_1.5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":342,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":90,"timeUnit":"seconds"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"com