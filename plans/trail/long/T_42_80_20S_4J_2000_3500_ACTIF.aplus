oment de forcer. Reste calme et contrôlé sur ta séance d’endurance fondamentale pour préserver tes réserves et ne pas brûler de cartouches avant l’objectif.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_30","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":30,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1794787200000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":325}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"VO2_7x60-90_Cote_Affutage","description":"Séance VMA **EN COTE**. Sur cette séance, tu enchaînes **7 fois** 1' rapides et 1'30 lentes pour te laisser le temps de redescendre.","displayName":"VO2max","coachAdvice":"Lors de cette séance de 1min à VO2, rappelle-toi que tu devrais être capable de tenir cette intensité pendant environ 5 minutes en condition idéale. Si tu te sens épuisé après seulement 30 secondes, il faudra ajuster ton effort. Tu as maintenant l'expérience nécessaire pour bien gérer cette intensité.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":325,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":7,"exercises":[{"_t":"S