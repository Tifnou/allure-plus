 mot d'ordre : relax ! La séance d'endurance fondamentale, c'est celle où il faut en profiter pour te détendre pour bien récupérer du fractionné. Aller trop vite sur cette séance est contre-productif, ne tombe pas dans le piège !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_45","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":45,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1785110400000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":329}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"SL_70","description":"Sortie longue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Sortie Longue","coachAdvice":"Une autre \"petite\" sortie longue de 1h10. On sait que ça parait peu pour certains... Le fait est qu'en dehors d'un prépa spécifique semi ou marathon, pas besoin d'en faire beaucoup plus, on se concentre sur les entraînements du coeur de la semaine !","test":false,"importance":true,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_70","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":329,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":70,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1785110400000,"status":"todo","nutritionTraining":{"_id":"6a68a