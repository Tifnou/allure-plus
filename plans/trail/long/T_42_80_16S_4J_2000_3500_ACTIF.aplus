il 60","coachAdvice":"Maîtrise ton effort : Une séance avec quelques intervalles de 5 minutes à S60, tu sais que tu dois avoir de la marge ! Garde un bon contrôle sur ton effort pour ne pas trop solliciter ton corps à 5 semaines de la course. L’objectif est de rester efficace sans épuiser trop de réserves avant les sorties longues restantes.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Plat_3","exerciseType":"running","pace":{"name":"Seuil 60","value":253,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"S60_Cote_2","exerciseType":"running","pace":{"name":"Seuil 60","value":253,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":2,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_2","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":120,"timeUnit":"seconds"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":326,"kind"