:"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_50","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"La 3ème semaine d'un cycle d'entraînement, c'est celle où les séances d'intensité sont les plus dures... et en même temps là où la fatigue est la plus importante... profite du footing pour écouter tes sensations et estimer ton niveau de fatigue. Si tu le sens vraiment haut, mets les bouchées doubles sur la récup en rentrant (voir ici pour approfondir le sujet : https://www.running-addict.fr/conseil-running/sentrainer-regresser-la-recuperation-fait-progresser/ )","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_50","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":50,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":328}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"S60_600_Cote6'+_4","description":"Séance de seuil 60' **EN COTE** où tu vas enchaîner **4 répétitions de 5'** à l'allure cible entrecoupées de 4' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Seuil 60","coachAdvice":"8ème séance de Seuil 60! Ne prends pas cette séance à la légère. Un intervalle à S60, c’est gérable, mais enchaîner les répétitions, c’est une autre histoire. Concentre-toi sur l’efficacité : posture bien droite, respiration contrôlée, gainage solide. C’est là que tu feras la différence, surtout quand la fatigue arrive.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_5","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_4","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":340,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":4,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":2,"weekDate":1787529600000,"status":"todo","nutritionTraining":{"_id":"6a68a5190462290c63b4cf13","userId":"642ab60364e5867bee895c04","weekDate":