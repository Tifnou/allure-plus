false},{"slug":"endurance-active","value":315.3592022090494,"dvalue":18.72947493312993,"abstract":true,"competitive":false},{"slug":"vo2max","value":209.96907936887473,"dvalue":7.313824230680075,"abstract":true,"competitive":false},{"slug":"race","value":552,"dvalue":17.004627997070017,"abstract":false,"competitive":true,"race":{"distance":70,"elevation":3400,"goalId":"6a68a5100462290c63b4cf01","timeLowerBound":38640,"timeUpperBound":46368}}],"sessions":[{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le rythme doit être confortable. Adapte ton allure à la forme du jour pour que le ressenti de la séance reste vraiment facile.","displayName":"Endurance Fondamentale","coachAdvice":"C’est tentant de speeder pendant tes footings, pas vrai ? On connaît tous ça, c’est tellement simple de se laisser aller. Mais si tu veux vraiment avancer, il faut apprendre à te freiner. Accélérer, même un peu, ça fatigue ton corps et ça risque de te limiter pour ta prochaine séance intense… et donc de ralentir tes progrès. (Je le redis, parce que c’est essentiel !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"trail_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_40","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":40,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionTrailV2ExpectedStats","expectedDistance":0,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":326}}]},{"_t":"SmartTrailV2SessionWithStats","sport":"trailV2","name":"EA_6x3_Plat_Affutage","description":"Séance de endurance active où tu vas enchaîner **6 répétitions de 3'** à l'allure cible entrecoupées d'1' de footing lent pour récupérer.","displayName":"Endurance Active","coachAdvice":"Sortie intense de ta semaine. Fais en sorte d'y arriver le plus reposé(e) possible pour la valider sans soucis.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_20 ","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":20,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":6,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EA_Plat_3","exerciseType":"running","pace":{"name":"Endurance active","value":316,"kind":"abstract","zoneKind":"Z3","abstract":true,"slug":"endurance-active","context":"pace","perception":"moderate"},"durations":[{"value":3,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Flat_1","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":339,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":1,"timeUnit":"minutes"}],"terrainIncline":"flat","manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":326,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":10,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":1,"weekDate":1793577600000,"status":"todo","nutritionTraining":{"_id":"6a68a5190462290c63b4cf29"