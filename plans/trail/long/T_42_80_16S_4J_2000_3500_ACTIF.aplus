":"SL_145","description":"Sortie longue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Sortie Longue","coachAdvice":"On continue d'enchaîner les heures ! 2h25, oui c'est long. Mais ça fait partie du travail indispensable pour être \"prêt\" à affronter les senties pendant plusieurs heures le jour de la course !","test":false,"importance":true,"trainingType":"SL","trainingCategory":"trail_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"EF_145","exerciseType":"running","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":145,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1786924800000,"status":"todo","nutritionTraining":{"_id":"6a68a5190462290c63b4cf12","userId":"642ab60364e5867bee895c04","weekDate":1786924800000,"sessionIndex":5,"choRecommendation":3,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":1800,"metric":"mL"},"cho":{"value":108,"metric":"g"},"sodium":{"value":7380,"metric":"mg"}}}],[{"datoId":"UMD5Rt1ESQ25KBXonqCm0A","name":"Jus de pomme","form":"liquid","info":{"quantity":{"value":1000,"metric":"mL"},"waterQuantity":{"value":800,"metric":"mL"},"cho":{"value":110,"metric":"g"},"sodium":{"value":20,"metric":"mg"}}}],[{"datoId":"AILrY6kmTTaa9W-jLuoFFQ","name":"Jus de raisin","form":"liquid","info":{"quantity":{"value":720,"metric":"mL"},"waterQuantity":{"value":1080,"metric":"mL"},"cho":{"value":108,"metric":"g"},"sodium":{"value":36,"metric":"mg"}}}]],"commercial":[[{"datoId":"DcjMZ0kQTV6TCPfZj1KbpA","name":"Boisson d’effort aux fruits","form":"liquid","info":{"quantity":{"value":1800,"metric":"mL"},"cho":{"value":108,