ance de seuil 60' **EN COTE** où tu vas enchaîner **3 répétitions de 6'** à l'allure cible entrecoupées de 5' de footing lent pour récupérer et te laisser le temps de redescendre.","displayName":"Free Solo","coachAdvice":"Déjà ta 6ᵉ séance de seuil 60, bravo pour ton parcours ! Là, ça commence à devenir sérieux. T’entraîner à rester concentré sur de longues périodes, continuer à rester connecté avec tes sensations, ce sont des qualités importantes pour un coureur.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"trail_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"Z2","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":15,"timeUnit":"minutes"}],"terrainIncline":"indifferent","manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartTrailV2Exercise","name":"S60_Cote_6","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"abstract","zoneKind":"Z4","abstract":true,"slug":"seuil60","context":"pace","perception":"steady"},"durations":[{"value":6,"timeUnit":"minutes"}],"terrainIncline":"uphill","manualLap":false},{"_t":"SmartTrailV2Exercise","name":"Recup_Down_5","exerciseType":"recuperation","pace":{"name":"Endurance confort","value":341,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-confort","context":"pace","perception":"easy"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainIncline":"downhill","manualLap":true}]},{"repeat":1,"exercises":[{"_t":"SmartTrailV2Exercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"Endurance Fondamentale","value":328,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"endurance-fondamentale","context":"pace","perception":"comfortable"},"durations":[{"value":5,"timeUnit":"minutes"}],"terrainInclin