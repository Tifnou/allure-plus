3834359,"dvalue":19.92907698417697,"abstract":false,"competitive":false},{"slug":"tempo","value":297.29995132403377,"dvalue":16.54409475099139,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":265.8985117453129,"dvalue":12.950582588978861,"abstract":false,"competitive":false},{"slug":"aerobie","value":315.4511227166596,"dvalue":18.734934177163627,"abstract":false,"competitive":false},{"slug":"seuil60","value":252.5658411090458,"dvalue":11.50870717490386,"abstract":false,"competitive":false},{"slug":"seuil30","value":239.90169661505905,"dvalue":10.191104055540794,"abstract":false,"competitive":false},{"slug":"vma","value":210.0302808946992,"dvalue":7.315956055060479,"abstract":false,"competitive":false},{"slug":"marathon","value":286.5550032551141,"dvalue":14.114672272468093,"abstract":false,"competitive":true},{"slug":"half-marathon","value":260.63161326425734,"dvalue":12.374586555155576,"abstract":false,"competitive":true},{"slug":"10km","value":245.49059909535512,"dvalue":10.766043093968625,"abstract":false,"competitive":true},{"slug":"5km","value":232.22157444177202,"dvalue":9.418802448307241,"abstract":false,"competitive":true},{"slug":"1500m","value":210.85581837108364,"dvalue":7.390406228355281,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":337.64915027592855,"dvalue":21.516176087371598,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":325.0879683834359,"dvalue":19.92907698417697,"abstract":true,"competitive":false},{"slug":"endurance-active","value":315.4511227166596,"dvalue":18.734934177163627,"abstract":true,"competitive":false},{"slug":"vo2max","value":210.0302808946992,"dvalue":7.315956055060479,"abstract":true,"competitive":false},{"slug":"race","value":287,"dvalue":14.114672272468093,"abstract":false,"competitive":true,"race":{"distance":42.195,"elevation":0,"goalId":"6a675372ba63bbdf0c9d5e48"}}],"sessions":[{"_t":"SmartSessionWithStats","sport":"road","name":"EF_35","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Lors des footings en endurance fondamentale, on veut être vraiment \"facile\" du début à la fin. Tellement en aisance que quand tu termines la sortie, tu devrais avoir l'impression de pouvoir continuer de courir comme ça pendant encore un moment sans problème.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_35","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.158357771260997,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_42_600_S4_HARD1","description":"Séance d'allure 42 km où tu vas enchaîner **3 répétitions de 3'** à l'allure cible entrecoupées de 3' de footing lent pour récupérer.","displayName":"Allure 42","coachAdvice":"Sortie intense de ta semaine. Fais en sorte d'y arriver le plus reposé(e) possible pour la valider sans soucis.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"