muxPlaybackId":"4IWQj9FusbAG6rA2bIJd6kf3gJzgQCEn","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730394833-dsc4270.png","muxPlaybackId":"01brVbo2iL201c02T5ep7PjTZ00nODTWfkJb","format":"mobile"}]}],"gear":"weights","name":"Extension de Mollet"}},{"_t":"SmartPPGExercise","name":"Récupération","exerciseType":"recuperation","sport":"ppg","difficulty":"recovery","repeat":1,"durations":[{"value":60,"timeUnit":"seconds"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":3,"trainingIndex":3,"weekDate":1790553600000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_60","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Autant on se fait mal sur les séances intenses et les sorties longues avec allure marathon, autant là, sur les EF, on est comme un coq en pâte. Confortable, détendu(e), et on fait le job tout en douceur.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_60","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":60,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1790553600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":10.557184750733137,"expectedDuration":3600},"paceZones":[{"kind":"Z2","duration":3600,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40_6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Quelques lignes droites en plus du traditionnel footing. De quoi te faire plaisir car il n'y a aucun objectif d'allure, juste de sentir que ton corps se libère et te permet d'accélérer progressivement de ligne droite en ligne droite !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1790553600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.9073903931688285,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":326}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":595}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":595}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":595}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":595}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":595}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":595}},{"kind":"Z2","duration":240,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_42_S2_LONG_105","description":"Séance d'allure spécifique 42 km en pyramide avec des intervalles qui augmentent puis qui redescendent en fin de séance. Après un long échauffement de 45', commence par 10' à ton allure 42 km (voir ci-dessous), suivies de 2' de récupération en footing lent. Puis le sommet de la pyramide avec 30' d'allure 42 km et 2' de récupération. On termine en redescendant la pyramide avec à nouveau 10' d'allure 42 km.","displayName":"Long + Allure 42 km","coachAdvice":"Ces séances sont cruciales pour \"apprendre\" à courir à ton allure de compétition. On te fait faire de l'allure marathon après un long échauffement pour te mettre le plus possible en condition de course. Autant physiquement que psychologiquement. Physiquement, tu vas habituer ton corps et rendre ta foulée plus économique à cette allure. Psychologiquement, tu vas apprendre à connaître le bon rythme pour maîtriser les sensations que tu dois avoir sans regarder la montre toutes les 10 secondes !\nN'oublie pas de consulter l'article de conseil ***«Séances d'affûtage : On t'explique tout»*** qui s'affiche avec ta semaine d'entraînement pour maximiser la réussite de ces séances !","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_45","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"A42_10","exerciseType":"running","pace":{"name":"Marathon","value":287,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"marathon"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"A42_30","exerciseType":"running","pace":{"name":"Marathon","value":287,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"marathon"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2.2","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"}