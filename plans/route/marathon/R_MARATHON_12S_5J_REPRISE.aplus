gue & Active","coachAdvice":"On continue d'enchaîner les kilomètres ! 2h15, oui c'est long. Mais ça fait partie du travail indispensable pour être \"prêt(e)\" à affronter le bitume pendant plusieurs heures le jour de la course !","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_70","exerciseType":"warm-up","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":70,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"SweetSpot_3","exerciseType":"running","pace":{"name":"Sweet spot","value":267,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"sweet-spot"},"durations":[{"value":3,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Tempo_10","exerciseType":"running","pace":{"name":"Tempo","value":299,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"tempo"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Aerobie_10","exerciseType":"running","pace":{"name":"Aerobie","value":317,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"aerobie"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_5","exerciseType":"recuperation","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_9","exerciseType":"recuperation","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":9,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":6,"weekDate":1788739200000,"status":"todo","nutritionTraining":{"_id":"6a6753bcba18ec460522