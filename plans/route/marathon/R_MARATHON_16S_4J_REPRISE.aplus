_t":"SmartSessionWithStats","sport":"road","name":"Force_A42_600_2","description":"Séance \"mix\" avec une première partie constituée de 3 fractions de 30\" à intensité maximale entrecoupées de 2'30 de récupération en footing très lent. Une grosse récup qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 3 fractions de 12' à ton allure 42 km avec 4' de récupération à chaque fois.","displayName":"Force + Allure 42km","coachAdvice":"2ème séance \"mix\", mais déjà la dernière pour toi. Profites-en encore une fois pour vraiment te donner sur les 30 secondes, sans penser à la suite de la séance ! Son efficacité est vraiment grande sur ta progression si tu réussis à donner le maximum au début et ensuite te mettre en mode \"compétition\" pour la partie allure 42 km et être en gestion de ton allure !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_30","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_2.5","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":150,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"A42_12","exerciseType":"running","pace":{"name":"Marathon","value":286,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"marathon"},"durations":[{"value":12,"timeUnit":"minutes"}],"manualLap":false},