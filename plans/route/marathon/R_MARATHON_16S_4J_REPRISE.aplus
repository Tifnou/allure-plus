n de ton profil et du temps jusqu'à l'objectif, ce cycle S60 sur-mesure commence 3-4 mois avant ton marathon. L'objectif est simple : catapulter ton niveau jusqu'à l'affutage. Un cycle qui repoussera tes limites avec des intervalles longs, mais qui te mettra vraiment en confiance. Tout ce que tu as réalisé avant ce cycle prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":597.9224448457488,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.42747148948305,"dvalue":11.593536377547727,"abstract":true,"competitive":false},{"slug":"fast","value":191.8089639424715,"dvalue":5.690147760904004,"abstract":true,"competitive":false},{"slug":"sprint","value":153.57178599709107,"dvalue":3.250666373047419,"abstract":true,"competitive":false},{"slug":"ef","value":327.4841500507578,"dvalue":20.07597165134536,"abstract":false,"competitive":false},{"slug":"tempo","value":299.4913110861339,"dvalue":16.666039148816672,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.8584155288352,"dvalue":13.046039670134965,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.7762724321305,"dvalue":18.873026971052735,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.42747148948305,"dvalue":11.593536377547727,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.66998121275418,"dvalue":10.26622137479776,"abstract":false,"competitive":false},{"slug":"vma","value":211.57838712319162,"dvalue":7.369881027630956,"abstract":false,"competitive":false},{"slug":"marathon","value":288.8371588585714,"dvalue":14.23724893082835,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.70731213495407,"dvalue":12.482590062275214,"abstract":false,"competitive":true},{"slug":"10km","value":247.44571326177152,"dvalue":10.860520350089343,"abstract":false,"competitive":true},{"slug":"5km","value":234.07101263456514,"dvalue":9.50189267315214