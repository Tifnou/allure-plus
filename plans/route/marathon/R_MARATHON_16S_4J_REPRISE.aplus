tric":"mg"}}},{"datoId":"cIWG8YzzRH-IaDrPzZ58_Q","name":"Pâte de fruit","form":"solid","info":{"quantity":{"value":0.5,"metric":"item"},"cho":{"value":10.5,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}},{"datoId":"eYGAVJrKTQO3qdBF7j3n_g","name":"Gum de l'effort","form":"solid","info":{"quantity":{"value":1,"metric":"item"},"cho":{"value":7.6,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}]]}}},"stats":{"_t":"SessionExpectedStats","expectedDistance":6.31626438078051,"expectedDuration":2280},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":326}},{"kind":"Z3","duration":180,"pace":{"value":286}},{"kind":"RECOVER","duration":180,"pace":{"value":594}},{"kind":"Z3","duration":180,"pace":{"value":286}},{"kind":"RECOVER","duration":180,"pace":{"value":594}},{"kind":"Z3","duration":180,"pace":{"value":286}},{"kind":"RECOVER","duration":180,"pace":{"value":594}},{"kind":"RECOVER","duration":300,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_20_3LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Vas-y doucement sur l'endurance fondamentale sur cette sortie. Aucune fatigue ne doit être générée et les lignes droites finales ne sont là que pour garder le corps habitué à une grande amplitude de mouvement (en endurance fondamentale, tous les gestes sont \"restreints\" pour garder l'allure basse, on vient rééquilibrer ça avec les lignes droites)","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_15","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":594,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_2","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1794182400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.4540771675546207,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":326}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":594}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":594}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":594}},{"kind":"Z2","duration":120,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"MARATHON","description":"Aujourd'hui, la clé sera la maîtrise. Les premiers kilomètres doivent presque te sembler trop faciles. Résiste à l'envie d'accélérer et respecte ton allure cible dès le départ. Pense à t'hydrater et à t'alimenter régulièrement, même si tu ne ressens pas encore le besoin. Le marathon commence réellement lorsque la fatigue s'installe, et chaque effort économisé au début sera précieux à la fin. Tu as investi des mois de travail pour arriver jusqu'ici. Fais confiance à ta préparation, reste patient(e) et profite de cette journée unique. Bonne course ! 🏅🏃‍♂️🏃‍♀️","displayName":"MARATHON","coachAdvice":"L'équipe CAMPUS te souhaite bon courage pour ta compétition ! On est tous derrière toi :)","test":false,"importance":true,"trainingType":"Competition","trainingCategory":"road_competition","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"","exerciseType":"running","pace":{"name":"course","value":286,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"race"},"durations":[{"value":12068,"timeUnit":"seconds"}],"manualLap":false}]}],"difficulty":5,"trainingIndex":3,"weekDate":1794182400000,"status":"todo","nutritionTraining":{"_id":"6a675420ce2d2a7e261e394f","userId":"642ab60364e5867bee895c04","weekDate":1794182400000,"sessionIndex":3,"choRecommendation":5,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"AdSspNUrTa-cUILb7xt-4g","name":"Compote de pommes","form":"semi-liquid","info":{"quantity":{"value":6,"metric":"item"},"cho":{"value":90,"metric":"g"},"sodium":{"value":6,"metric":"mg"}}},{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":5,"metric":"item"},"cho":{"value":135,"metric":"g"},"sodium":{"value":5,"metric":"mg"}}},{"datoId":"d2Xmi074S8qN0vgyfiujiw","name":"Eau","form":"liquid","info":{"quantity":{"value":1700,"metric":"mL"},"cho":{"value":0,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}],[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":1700,"metric":"mL"},"cho":{"value":102,"metric":"g"},"sodium":{"value":6970,"metric":"mg"}}},{"datoId":"ORyYoh_PQvCycnU_NLPIZg","name":"Purée énergétique salée patates douces","form":"semi-liquid","info":{"quantity":{"value":7,"metric":"item"},"cho":{"value":140,"metri