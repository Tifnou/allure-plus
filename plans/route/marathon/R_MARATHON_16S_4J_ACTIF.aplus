riations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":4,"trainingIndex":0,"weekDate":1785715200000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"À partir de là, tu devrais commencer à voir une amélioration au niveau de ton aisance à courir à cette allure non ? L'endurance fondamentale, c'est une allure extrêmement efficace pour développer ton système cardio-respiratoire. Ses effets commencent à se sentir au bout de quelques semaines seulement donc tu devrais commencer à le sentir ! Sinon, ne perds pas espoir, au contraire, persévère à bien respecter l'allure, ce processus est plus rapide pour certains que d'autres ! :)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1785715200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.976744186046512,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":329}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EnduForce_600_2","description":"Séance d'endurance de force en **deux blocs**. Il y a 3 intervalles par bloc, respectivement de **35\", 25\" et 15\"**, séparés par 3' de repos courues très lentement et/ou marchées. À la fin du premier bloc, après le dernier sprint de 15\", prends 5' *(soit 2' de bonus !)* puis repars sur le second bloc avec autant d'intensité que sur le premier.","displayName":"Endurance de Force","coachAdvice":"Le but est d'imposer à ton corps des contraintes mécaniques élevées (impact). Mais cela ne doit jamais déclencher de douleur / en aggraver. Prends ton temps à l'échauffement, puis sur les premiers intervalles pour te permettre de t'exprimer pleinement sur les sprints suivants.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_35","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":35,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"ENDU_FORCE_25","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":25,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3.2","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"FORCE_15","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_5","exerciseType":"recuperation","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":2,"weekDate":1785715200000,"status":"todo","nutritionTraining":{"_id":"6a674f2eba63bbdf0c9d0f37","userId":"642ab60364e5867bee895c04","weekDate":1785715200000,"sessionIndex":2,"choRecommendation":1,"formSuggestions":[