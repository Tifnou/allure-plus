":"seconds"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":3,"trainingIndex":0,"weekDate":1789948800000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"À partir de là, tu devrais commencer à voir une amélioration au niveau de ton aisance à courir à cette allure non ? L'endurance fondamentale, c'est une allure extrêmement efficace pour développer ton système cardio-respiratoire. Ses effets commencent à se sentir au bout de quelques semaines seulement donc tu devrais commencer à le sentir ! Sinon, ne perds pas espoir, au contraire, persévère à bien respecter l'allure, ce processus est plus rapide pour certains que d'autres ! :)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1789948800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.894736842105263,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Force_A42_600_1","description":"Séance \"mix\" avec une première partie constituée de 3 fractions de 30\" à intensité maximale entrecoupées de 2'30 de récupération en footing très lent. Une grosse récupération qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 4 fractions de 8' à ton allure 42 km avec 3' de récupération à chaque fois.","displayName":"Force + Allure 42km","coachAdvice":"Un type de séance que tu n'as pas dû voir souvent... c'est normal, on utilise les protocoles les plus récents en terme d'optimisation de l'entraînement ! Un mélange de travail d'endurance de force pour stimuler cette qualité essentielle... avant de faire un peu d'allure spécifique compétition avec la fatigue de la première partie de séance dans les jambes... parfait pour simuler le dernier tiers de ton marathon, quand ce sera vraiment dur ! Concernant ton allure marathon, on est encore loin de la course, donc on te conseille de [lire cet article](https://app.campus.coach/knowledges/understand-and-adjust-your-specific-race-pace-v2) avant de te lancer dans la séance ! :)","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":