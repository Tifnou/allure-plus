756/1765362553-tristan-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a6752f6ba63bbdf0c9d59c8","articles":["UELIztpsQmCsPJwF-vCeYQ","cw4hkSgOSHuTSl7Mw-OHow","OSlq_sGrQoyWCglg_yifdg","YkQgU8A7RQiZ45i9Zht6Rw","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1792368000000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a675219ba18ec460522493a","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure marathon, contrastée avec des intensités plus hautes (S60, Sweetspot) pour conserver ton niveau de forme. L'objectif : se préparer spécifiquement à l'effort de ton objectif. Ton plus gros volume hebdomadaire du bloc sera quant à lui atteint 3 semaines avant la course, avec ta séance test sur la sortie longue, pour se laisser le temps d'effacer la fatigue PROGRESSIVEMENT jusqu'à la course (oui, on ne coupe pas tout du jour au lendemain. Tu vas avoir des séances intenses jusqu'à l'avant-dernière semaine).","isStatic":true},"estimatedPaces":[{"slug":"slow","value":592.6506657337941,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":252.18422833768622,"dvalue":11.491318166079495,"abstract":true,"competitive":false},{"slug":"fast","value":190.11781737603246,"dvalue":5.639978709100616,"abstract":true,"competitive":false},{"slug":"sprint","value":152.21777003635216,"dvalue":3.222005808064295,"abstract":true,"competitive":false},{"slug":"ef","value":324.59677875935336,"dvalue":19.89896527047426,"abstract":false,"competitive":false},{"slug":"tempo","value":296.8507478298018,"dvalue":16.51909755493419,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":265.49675405899256,"dvalue":12.931014987553443,"abstract":false,"competitive":false},{"slug":"aerobie","value":314.9744938240121,"dvalue":18.706626746035237,"abstract":false,"competitive":false},{"slug":"seuil60","value":252.18422833768622,"dvalue":11.491318166079495,"abstract":false,"compet