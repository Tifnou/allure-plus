":"road","name":"Recup_S60_21_42_600_1","description":"Petite séance avec du seuil pour garder tes jambes actives sans trop pousser pendant la récupération. Enchaine 8 fois 1' au seuil 60 et 1' lent.","displayName":"Séance intense facile","coachAdvice":"En semaine de récupération, la séance de fractionné est une séance que l'on appelle \"d'entretien\". La priorité n'est pas de progresser mais d'évacuer la fatigue. La séance est donc volontairement abordable pour garder le corps en action (pour éviter de régresser) mais sans générer de fatigue.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":8,"exercises":[{"_t":"SmartExercise","name":"S60_1","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":5,"weekDate":1786924800000,"status":"todo","nutritionTraining":{"_id":"6a6752f9ba18ec46052269b9","userId":"642ab60364e5867bee895c04","weekDate":1786924800000,"sessionIndex":5,"choRecommendation":2,"formSuggestions":["liquid","semi-liquid"],"recip