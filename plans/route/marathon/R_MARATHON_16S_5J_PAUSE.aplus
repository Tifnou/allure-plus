tion de ton profil et du temps jusqu'à l'objectif, ce cycle S60 sur-mesure commence 3-4 mois avant ton marathon. L'objectif est simple : catapulter ton niveau jusqu'à l'affutage. Un cycle qui repoussera tes limites avec des intervalles longs, mais qui te mettra vraiment en confiance. Tout ce que tu as réalisé avant ce cycle prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":598.4389316367849,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.64724652792455,"dvalue":11.603550901090065,"abstract":true,"competitive":false},{"slug":"fast","value":191.97464896923807,"dvalue":5.695062923702933,"abstract":true,"competitive":false},{"slug":"sprint","value":153.70444166109405,"dvalue":3.2534743061802476,"abstract":true,"competitive":false},{"slug":"ef","value":327.76703161714306,"dvalue":20.09331332209968,"abstract":false,"competitive":false},{"slug":"tempo","value":299.75001237346555,"dvalue":16.68043531198709,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.08979224780785,"dvalue":13.057308869381522,"abstract":false,"competitive":false},{"slug":"aerobie","value":318.05076831137154,"dvalue":18.88932953540944,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.64724652792455,"dvalue":11.603550901090065,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.87873630158265,"dvalue":10.275089360570234,"abstract":false,"competitive":false},{"slug":"vma","value":211.76114902343443,"dvalue":7.376247147911421,"abstract":false,"competitive":false},{"slug":"marathon","value":289.1066676082417,"dvalue":14.251729872085985,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.95243959536305,"dvalue":12.49534964540227,"abstract":false,"competitive":true},{"slug":"10km","value":247.67660039920213,"dvalue":10.871682212020442,"abstract":false,"competitive":true},{"slug":"5km","value":234.28942007977926,"dvalue":9.511709