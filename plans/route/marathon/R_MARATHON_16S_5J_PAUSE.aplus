lue":593}},{"kind":"Z3","duration":1800,"pace":{"value":285}},{"kind":"RECOVER","duration":120,"pace":{"value":593}},{"kind":"RECOVER","duration":660,"pace":{"value":325}}]}],"weekStats":{"expectedDistance":64.7241501730718,"realDistance":0,"expectedDuration":21210,"realDuration":0},"exportStatus":"NotAvailable","goalDuration":{"durationInWeeks":16,"index":13},"coach":{"name":"Tristan","image":"https://www.datocms-assets.com/89756/1765362553-tristan-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a6752f6ba63bbdf0c9d59c9","articles":["JnjrIwEBRnGdJgnXPwv8Og","cw4hkSgOSHuTSl7Mw-OHow","OSlq_sGrQoyWCglg_yifdg","CVn3qAw6TIef3lxj0ydPGQ","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1792972800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a675219ba18ec460522493a","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure marathon, contrastée avec des intensités plus hautes (S60, Sweetspot) pour conserver ton niveau de forme. L'objectif : se préparer spécifiquement à l'effort de ton objectif. Ton plus gros volume hebdomadaire du bloc sera quant à lui atteint 3 semaines avant la course, avec ta séance test sur la sortie longue, pour se laisser le temps d'effacer la fatigue PROGRESSIVEMENT jusqu'à la course (oui, on ne coupe pas tout du jour au lendemain. Tu vas avoir des séances intenses jusqu'à l'avant-dernière semaine).","isStatic":true},"estimatedPaces":[{"slug":"slow","value":592.0109909349142,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":251.91203443853192,"dvalue":11.478915064114448,"abstract":true,"competitive":false},{"slug":"fast","value":189.91261457508259,"dvalue":5.633891223748753,"abstract":true,"competitive":false},{"slug":"sprint","value":152.05347447901354,"dvalue":3.2185281507588623,"abstract":true,"competitive":false},{"slug":"ef","value":324.2464267034542,"dvalue":19.87748741287064,"abstract":false,"competitive":fals