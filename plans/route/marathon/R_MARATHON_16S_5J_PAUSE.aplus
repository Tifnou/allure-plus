ectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40_6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing léger avec quelques lignes droites en accélération progressive pour garder le rythme, sans forcer.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":190,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":593,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.928996183544865,"expectedDuration":240