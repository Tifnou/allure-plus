nchaîner **6 répétitions de 5'** à l'allure cible entrecoupées de 2' de footing lent pour récupérer.","displayName":"Seuil 60","coachAdvice":"Ne néglige pas cette séance. Un intervalle à S60 ça passe, mais répétition après répétition, ce n'est pas la même limonade. Reste efficace : posture, souffle, gainage. Surtout quand la fatigue commence à se faire sentir.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"S60_5","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":594,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":5,"trainingIndex":5,"weekDate":1791158400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":11.80035650623886,"expectedDuration":3720},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":325}},{"kind":"Z4","duration":300,"pace":{"value":255}},{"kind":"RECOVER","duration":120,"pace":{"value":594}},{"kind":"Z4","duration":300,"pace":{"value":255}},{"kind":"RECOVER","duration":120,"pace":{"value":594}},{"kind":"Z4","durati