 réaliser la progression que tu as pu avoir ! Quoi qu'il arrive, donne ton maximum sur cette séance, c'est le principal.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"S60_7","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":7,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_3","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":3,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":5,"weekDate":1790553600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":11.317380911308804,"expectedDuration":3600},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":326}},{"kind":"Z4","duration":420,"pace":{"value":255}},{"kind":"RECOVER","duration":180,"pace":{"value":595}},{"kind":"Z4","duration":420,"pace":{"value":255}},{"kind":"RECOVER","duration":180,"pace":{"value":595}},{"kind":"Z4","duration":420,"pace":{"value":255}},{"kind":"RECOVER","duration":180,"pace":{"value":595}},{"kind":"Z4","duration":420,"pace":{"value":255}},{"kind":"RECOVER","duration":180,"pace":{"value":595}},{"kind":"RECOVER","duration":300,"pace":{"value":32