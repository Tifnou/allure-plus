d":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_50","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Doucement mais sûrement, voilà ton objectif du jour ! Puisque je suis dans les expressions, j'y associerais le célèbre dicton : \"qui veut voyager loin ménage sa monture\"... très adapté au coureur !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_50","exerciseType":"running","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":50,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":8.849557522123893,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":324}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"S60_600_9","description":"Séance de seuil 60' où tu vas enchaîner **4 répétitions de 8'** à l'allure cible entrecoupées de 3'30 de footing lent pour récupérer.","displayName":"Seuil 60 : \"Le Sunrise\"","coachAdvice":"Être capable de mener \"Le SunRise\" à son terme, c'est la preuve que tu as tellement progressé depuis le début de ton entraînement ! Alors vas-y, boucle cette séance et sois fier(e) de toi et du chemin parcouru.","test":true,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"S60_8","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":8,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_3.5","exerciseType":"running","pace":{"name":"Lent","value":591,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"slow"},"durations":[{"value":210,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":5,"trainingIndex":5,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":12.52019792391411,"expectedDuration":3960},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":324}},{"kind":"Z4","duration":480,"pace":{"value":254}},{"kind":"Z1","duration":210,"pace":{"value":591}},{"kind":"Z4","duration":480,"pace":{"value":254}},{"kind":"Z1","duration":210,"pace":{"value":591}},{"kind":"Z4","duration":480,"pace":{"value":254}},{"kind":"Z1","duration":210,"pace":{"value":591}},{"kind":"Z4","duration":480,"pace":{"value":254}},{"kind":"Z1","duration":210,"pace":{"value":591}},{"kind":"RECOVER","duration":300,"pace":{"value":324}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"SL_135_HARD_2","description":"Sortie longue en endurance fondamentale avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, manque d'envie...). Le bloc actif est une pyramide composée de : 10' d'allure active, 10' Tempo, 4' au SweetSpot, puis la redescente, 10' Tempo, 10' d'allure active.","displayName":"Sortie Longue & Active","coachAdvice":"Comment évaluer la progression de ton endurance et de ta capacité à durer sur le marathon ? Avec ce genre de sortie ! Au fur et à mesure, tu dois sentir que tu vas de plus en plus loin dans la sortie sans fatiguer... et c'est exactement l'objectif (et lorsque tu seras reposé(e) au départ du marathon, ce sera encore plus intéressant !)","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_80","exerciseType":"warm-up","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":80,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"Aerobie_10","exerciseType":"running","pace":{"name":"Aerobie","value":314,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"aerobie"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Tempo_10","exerciseType":"running","pace":{"name":"Tempo","value":296,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"tempo"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"SweetSpot_4","exerciseType":"running","pace":{"name":"Sweet spot","value":265,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"sweet-spot"},"durations":[{"value":4,"timeUnit":"minu