4 mois avant ton marathon. L'objectif est simple : catapulter ton niveau jusqu'à l'affutage. Un cycle qui repoussera tes limites avec des intervalles longs, mais qui te mettra vraiment en confiance. Tout ce que tu as réalisé avant ce cycle prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":593.9320896066789,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":252.72949877985613,"dvalue":11.516164589580415,"abstract":true,"competitive":false},{"slug":"fast","value":190.52888838958606,"dvalue":5.6521734197088564,"abstract":true,"competitive":false},{"slug":"sprint","value":152.54689391265856,"dvalue":3.228972399683521,"abstract":true,"competitive":false},{"slug":"ef","value":325.29861895867003,"dvalue":19.941990631985824,"abstract":false,"competitive":false},{"slug":"tempo","value":297.4925958136927,"dvalue":16.554814997247664,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":266.07080872305573,"dvalue":12.958974310412138,"abstract":false,"competitive":false},{"slug":"aerobie","value":315.65552880646027,"dvalue":18.747074044046474,"abstract":false,"competitive":false},{"slug":"seuil60","value":252.72949877985613,"dvalue":11.516164589580415,"abstract":false,"competitive":false},{"slug":"seuil30","value":240.05714817065763,"dvalue":10.197707689450239,"abstract":false,"competitive":false},{"slug":"vma","value":210.1663763635873,"dvalue":7.320696649918692,"abstract":false,"competitive":false},{"slug":"marathon","value":286.7555757772122,"dvalue":14.125441930104094,"abstract":false,"competitive":true},{"slug":"half-marathon","value":260.81404085901954,"dvalue":12.384075635204637,"abstract":false,"competitive":true},{"slug":"10km","value":245.662428824561,"dvalue":10.774343603029877,"abstract":false,"competitive":true},{"slug":"5km","value":232.38411659368796,"dvalue":9.426102375821605,"abstract":false,"competitive":true},{"slug":"1500m","value":211.00340568524