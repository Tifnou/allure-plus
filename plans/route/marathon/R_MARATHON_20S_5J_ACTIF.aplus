":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1792368000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.9411764705882355,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"S60_600_7","description":"Séance de seuil 60' où tu vas enchaîner **4 répétitions de 7'** à l'allure cible entrecoupées de 3' de footing lent pour récupérer.","displayName":"Seuil 60","coachAdvice":"Oui les intervalles sont longs, très longs même à cette allure, on ne va pas te mentir. Les séances à ce moment de ce cycle commencent à être vraiment difficiles. Mais c'est le moment de voir où tu en es, de réaliser la progression que tu as pu avoir ! Quoi qu'il arrive, donne ton maximum sur cette séance, c'est le principal.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"S60_7","exerciseType":"running","pace":{"name":"Seuil 60","value":254,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":7,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_3","exerciseType":"recuperation","pace":{"name":"Lent","value":593,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":3,"timeUnit":"minu