'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Quelques lignes droites en plus du traditionnel footing. De quoi te faire plaisir car il n'y a aucun objectif d'allure, juste de sentir que ton corps se libère et te permet d'accélérer progressivement de ligne droite en ligne droite !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":323,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":189,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":590,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":323,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1795996800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.969320553414425,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":323}},{"kind":"Z5","duration":15,"pace":{"value":189}},{"kind":"RECOVER","duration":45,"pace":{"value":590}},{"kind":"Z5","duration":15,"pace":{"value":189}},{"kind":"RECOVER","duration":45,"pace":{"value":590}},{"kind":"Z5","duration":15,"pace":{"value":189}},{"kind":"RECOVER","duration":45,"pace":{"value":590}},{"kind":"Z5",