e, avec ta séance test sur la sortie longue, pour se laisser le temps d'effacer la fatigue PROGRESSIVEMENT jusqu'à la course (oui, on ne coupe pas tout du jour au lendemain. Tu vas avoir des séances intenses jusqu'à l'avant-dernière semaine).","isStatic":true},"estimatedPaces":[{"slug":"slow","value":588.1874151190744,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":250.28502957317116,"dvalue":11.404777079003875,"abstract":true,"competitive":false},{"slug":"fast","value":188.68604059025603,"dvalue":5.597504044182749,"abstract":true,"competitive":false},{"slug":"sprint","value":151.0714184080372,"dvalue":3.1977408907446407,"abstract":true,"competitive":false},{"slug":"ef","value":322.1522412668665,"dvalue":19.749106215029215,"abstract":false,"competitive":false},{"slug":"tempo","value":294.61516562372975,"dvalue":16.39469227442144,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":263.4972986980633,"dvalue":12.833631547478015,"abstract":false,"competitive":false},{"slug":"aerobie","value":312.602421734225,"dvalue":18.56574718890151,"abstract":false,"competitive":false},{"slug":"seuil60","value":250.28502957317116,"dvalue":11.404777079003875,"abstract":false,"competitive":false},{"slug":"seuil30","value":237.7352494236541,"dvalue":10.099072656555448,"abstract":false,"competitive":false},{"slug":"vma","value":208.1335893807395,"dvalue":7.249888858906549,"abstract":false,"competitive":false},{"slug":"marathon","value":283.7608158855984,"dvalue":13.964705582909822,"abstract":false,"competitive":true},{"slug":"half-marathon","value":258.090203923618,"dvalue":12.242455279907855,"abstract":false,"competitive":true},{"slug":"10km","value":243.09682923080877,"dvalue":10.65046553701709,"abstract":false,"competitive":true},{"slug":"5km","value":229.95719035193443,"dvalue":9.317160137740535,"abstract":false,"competitive":true},{"slug":"1500m","value":208.7997709882472,"dvalue":7.309943998338404,"abstract":false,"competitive":true},{"slu