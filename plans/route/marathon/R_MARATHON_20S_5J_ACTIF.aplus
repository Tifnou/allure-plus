BRnGdJgnXPwv8Og","cw4hkSgOSHuTSl7Mw-OHow","CVn3qAw6TIef3lxj0ydPGQ","OSlq_sGrQoyWCglg_yifdg","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1795392000000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a674f70ce2d2a7e261dded9","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure marathon, contrastée avec des intensités plus hautes (S60, Sweetspot) pour conserver ton niveau de forme. L'objectif : se préparer spécifiquement à l'effort de ton objectif. Ton plus gros volume hebdomadaire du bloc sera quant à lui atteint 3 semaines avant la course, avec ta séance test sur la sortie longue, pour se laisser le temps d'effacer la fatigue PROGRESSIVEMENT jusqu'à la course (oui, on ne coupe pas tout du jour au lendemain. Tu vas avoir des séances intenses jusqu'à l'avant-dernière semaine).","isStatic":true},"estimatedPaces":[{"slug":"slow","value":589.4591885921217,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":250.8261935850662,"dvalue":11.429436384154359,"abstract":true,"competitive":false},{"slug":"fast","value":189.09401582908092,"dvalue":5.609606916457269,"abstract":true,"competitive":false},{"slug":"sprint","value":151.39806365329133,"dvalue":3.2046550169805856,"abstract":true,"competitive":false},{"slug":"ef","value":322.8487959094764,"dvalue":19.79180755265573,"abstract":false,"competitive":false},{"slug":"tempo","value":295.25217985213146,"dvalue":16.43014072877023,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":264.0670301579517,"dvalue":12.861380308749354,"abstract":false,"competitive":false},{"slug":"aerobie","value":313.2783278440003,"dvalue":18.605889878417173,"abstract":false,"competitive":false},{"slug":"seuil60","value":250.8261935850662,"dvalue":11.429436384154359,"abstract":false,"competitive":false},{"slug":"seuil30","value":238.24927841518576,"dvalue":10.12090877949321,"abstract":false,"competitive":false},{"slug":"vma","value":