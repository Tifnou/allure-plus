ompetitive":false},{"slug":"endurance-active","value":314.9744938240121,"dvalue":18.706626746035237,"abstract":true,"competitive":false},{"slug":"vo2max","value":209.71293696089674,"dvalue":7.304902057207651,"abstract":true,"competitive":false},{"slug":"race","value":286,"dvalue":14.089564493163573,"abstract":false,"competitive":true,"race":{"distance":42.195,"elevation":0,"goalId":"6a674f70ce2d2a7e261dded9"}}],"sessions":[{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - FORCE + AS  - SEMAINE 1 SEANCE 1","description":"Séance en 2 blocs. Le premier est composé de 5 séries de 3 exercices enchainés sans pause. Le second est composé de 3 séries de 2 exercices enchainés sans pause. Prend 1'30  de récupération entre les séries des bloc 1, et 1' entre les séries du bloc 2. ","displayName":"Renforcement","coachAdvice":"Tu viens de rentrer dans le bloc spécifique de ta course. A partir de maintenant, les entrainements vont commencer à devenir difficiles. C'est pour cela que tes séances de renforcement ce mois-ci sont paramétrées pour te laisser le moins de fatigue résiduelle possible. Très peu de répétitions sur les exercices principaux, mais je veux beaucoup d'intensité. Donc on utilise les variantes d'exercices les plus difficiles possibles et on met un maximum d'intensité. Tu auras très peu de courbatures (normalement), mais les adaptations nerveuses et structurelles seront bien là.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartPPGExercise","name":"Split Squat avec charge additionnelle","exerciseType":"ppg","sport":"ppg","difficulty":"maximal","repeat":2,"durations":[],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Fente arrière","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"hb4BQg4cqbEo2jFyobgiiaVMM9Lvq227","format":"desktop"},{"thumbnail":"https://ww