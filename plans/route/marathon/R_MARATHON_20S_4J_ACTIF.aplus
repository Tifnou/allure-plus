Id":"642ab60364e5867bee895c04","_id":"6a674f74ce2d2a7e261ddefb","articles":["d24sqbiDSCmDmweymRaGhw","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1795996800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a674f70ce2d2a7e261dded9","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure marathon, contrastée avec des intensités plus hautes (S60, Sweetspot) pour conserver ton niveau de forme. L'objectif : se préparer spécifiquement à l'effort de ton objectif. Ton plus gros volume hebdomadaire du bloc sera quant à lui atteint 3 semaines avant la course, avec ta séance test sur la sortie longue, pour se laisser le temps d'effacer la fatigue PROGRESSIVEMENT jusqu'à la course (oui, on ne coupe pas tout du jour au lendemain. Tu vas avoir des séances intenses jusqu'à l'avant-dernière semaine).","isStatic":true},"estimatedPaces":[{"slug":"slow","value":591.1175989045155,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":251.53187898977376,"dvalue":11.461592461336918,"abstract":true,"competitive":false},{"slug":"fast","value":189.6260212196698,"dvalue":5.625389230379554,"abstract":true,"competitive":false},{"slug":"sprint","value":151.82401360012142,"dvalue":3.213671133839373,"abstract":true,"competitive":false},{"slug":"ef","value":323.75711285972915,"dvalue":19.847490691338553,"abstract":false,"competitive":false},{"slug":"tempo","value":296.0828552734329,"dvalue":16.47636600669619,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":264.80996791251175,"dvalue":12.897565079719842,"abstract":false,"competitive":false},{"slug":"aerobie","value":314.1597188200017,"dvalue":18.65823650434616,"abstract":false,"competitive":false},{"slug":"seuil60","value":251.53187898977376,"dvalue":11.461592461336918,"abstract":false,"competitive":false},{"slug":"seuil30","value":238.91957937561037,"dvalue":10.149383387770682,"abstract":false,"competitive":false},{"slug":"vm