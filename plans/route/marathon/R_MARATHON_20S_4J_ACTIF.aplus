uivi par 3' au SweetSpot, enchainé sans repos**. ","displayName":"Séance S60 alternative : \"Big Five\"","coachAdvice":"Mettre des petites accélérations en course c'est la signature des coureurs Kenyans. Reproduire cette variation d'allure poncutellement à l'entrainement a pour avantage d'apprendre à maitriser différentes allures sans récupération et ainsi d'étendre notre zone de confort.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"S30_2","exerciseType":"running","pace":{"name":"Seuil 30","value":241,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil30"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"SweetSpot_3","exerciseType":"running","pace":{"name":"Sweet spot","value":268,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"sweet-spot"},"durations":[{"value":3,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":597,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":2,"weekDate":1788739200000,"status":"todo","nutritionTraining":{"_id":"6a674f79ba18ec4605221221","userId":"642ab60364e5867bee895c04","weekDate":1788739200000