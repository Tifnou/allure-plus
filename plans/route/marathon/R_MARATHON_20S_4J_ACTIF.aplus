me":"S60","cycleDescription":"En fonction de ton profil et du temps jusqu'à l'objectif, ce cycle S60 sur-mesure commence 3-4 mois avant ton marathon. L'objectif est simple : catapulter ton niveau jusqu'à l'affutage. Un cycle qui repoussera tes limites avec des intervalles longs, mais qui te mettra vraiment en confiance. Tout ce que tu as réalisé avant ce cycle prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":596.2460838566786,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.71414772746462,"dvalue":11.561032242143186,"abstract":true,"competitive":false},{"slug":"fast","value":191.2712001115955,"dvalue":5.674194618802302,"abstract":true,"competitive":false},{"slug":"sprint","value":153.141225556876,"dvalue":3.24155266550352,"abstract":true,"competitive":false},{"slug":"ef","value":326.56600145403564,"dvalue":20.019685796910398,"abstract":false,"competitive":false},{"slug":"tempo","value":298.6516444123069,"dvalue":16.619313527271242,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.1074361965534,"dvalue":13.00946323425537,"abstract":false,"competitive":false},{"slug":"aerobie","value":316.8853412571105,"dvalue":18.820113743873087,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.71414772746462,"dvalue":11.561032242143186,"abstract":false,"competitive":false},{"slug":"seuil30","value":240.99242489717082,"dvalue":10.237438556614201,"abstract":false,"competitive":false},{"slug":"vma","value":210.98519689030934,"dvalue":7.3492185133612455,"abstract":false,"competitive":false},{"slug":"marathon","value":287.96254306931274,"dvalue":14.19026287484278,"abstract":false,"competitive":true},{"slug":"half-marathon","value":261.91181904793257,"dvalue":12.441189676995409,"abstract":false,"competitive":true},{"slug":"10km","value":246.69643318763437,"dvalue":10.824304412523649,"abstract":false,"competitive":true},{"slug":"5km","value":233