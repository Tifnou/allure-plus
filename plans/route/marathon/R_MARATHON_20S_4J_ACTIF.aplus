D","exerciseType":"running","pace":{"name":"Rapide","value":190,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":592,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_2","exerciseType":"running","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1796601600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.4737322033258224,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":324}},{"kind":"Z5","duration":15,"pace":{"value":190}},{"kind":"RECOVER","duration":45,"pace":{"value":592}},{"kind":"Z5","duration":15,"pace":{"value":190}},{"kind":"RECOVER","duration":45,"pace":{"value":592}},{"kind":"Z5","duration":15,"pace":{"value":190}},{"kind":"RECOVER","duration":45,"pace":{"value":592}},{"kind":"Z2","duration":120,"pace":{"value":324}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"MARATHON","description":"Aujourd'hui, la clé sera la maîtrise. Les premiers kilomètres doivent presque te sembler trop faciles. Résiste à l'envie d'accélérer et respecte ton allure cible dès le départ. Pense à t'hydrater et à t'alimenter régulièrement, même si tu ne ressens pas encore le besoin. Le marathon commence réellement lorsque la fatigue s'installe, et chaque effort économisé au début sera précieux à la fin. Tu as investi des mois de travail pour arriver jusqu'ici. Fais confiance à ta préparation, reste patient(e) et profite de cette journée unique. Bonne course ! 🏅🏃‍♂️🏃‍♀️","displayName":"MARATHON","coachAdvice":"L'équipe CAMPUS te souhaite bon courage pour ta compétition ! On est tous derrière toi :)","test":false,"importance":true,"trainingType":"Competition","trainingCategory":"road_competition","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"","exerciseType":"running","pace":{"name":"course","value":285,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"race"},"durations":[{"value":12026,"timeUnit":"seconds"}],"manualLap":false}]}],"difficulty":5,"trainingIndex":3,"weekDate":1796601600000,"status":"todo","nutritionTraining":{"_id":"6a674f79ba18ec460522123c","userId":"642ab60364e5867bee895c04","weekDate":1796601600000,"sessionIndex":3,"choRecommendation":6,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"AdSspNUrTa-cUILb7xt-4g","name":"Compote de pommes","form":"semi-liquid","info":{"quantity":{"value":9,"metric":"item"},"cho":{"value":135,"metric":"g"},"sodium":{"value":9,"metric":"mg"}}},{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":5,"metric":"item"},"cho":{"value":135,"metric":"g"},"sodium":{"value":5,"metric":"mg"}}},{"datoId":"d2Xmi074S8qN0vgyfiujiw","name":"Eau","form":"liquid","info":{"quantity":{"value":1650,"metric":"mL"},"cho":{"value":0,"metric":"g"},"sodium":{"value":0,"metric":"mg"}}}],[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":1650,"metric":"mL"},"cho":{"value":99,"metric":"g"},"sodium":{"value":6765,"metric":"mg"}}},{"datoId":"AdSspNUrTa-cUILb7xt-4g","name":"Compote de pommes","form":"semi-liquid","info":{"quantity":{"value":2,"metric":"item"},"cho":{"value":30,"metric":"g"},"sodium":{"value":2,"metric":"mg"}}},{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":5,"metric":"item"},"cho":{"value":135,"metric":"g"},"sodium":{"value":5,"metric":"mg"}}}]