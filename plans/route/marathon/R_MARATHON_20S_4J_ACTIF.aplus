nd":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Comment minimiser ta progression ? À cause de footings courus trop rapidement et qui génèrent une fatigue qui va s'ajouter à celle des entraînements fractionnés ! Le programme qu'on te donne a été étudié pour que ces séances soient courues à allure lente, sinon la charge d'entraînement va être trop forte et tu vas soit te blesser, soit t'entraîner plus fort que ce que ton corps peut accepter... et donc ne pas progresser !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1790553600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.038123167155425,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"SL_90_HARD_1","description":"Sortie longue en endurance fondamentale avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, manque d'envie...). Le bloc actif est composé de 2 séries de 15' Tempo, séparées par 2' de repos.","displayName":"Sortie Longue & Active","coachAdvice":"Les choses sérieuses commencent vraiment avec cette sortie longue ! Pas que sur des sorties plus courtes, ce soit \"hyper facile\", mais quand tu arrives à 1h30 et plus, c'est la zone où tu vas potentiellement épuiser tes réserves énergétiques... et donc le moment où le ravitaillement devient important.","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_45","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"Tempo_15","exerciseType":"running","pace":{"name":"Tempo","value":298,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"tempo"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_11","exerciseType":"recuperation","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":11,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":5,"weekDate":1790553600000,"status":"todo","nutritionTraining":{"_id":"6a674f79ba18ec4605221228","userId":"642ab60364e5867bee895c04","weekDate":1790553600000,"sessionIndex":5,"choRecommendation":4,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[],"commercial":[]},"2":{"homemade":[[{"datoId":"YbBFRyt1QkiVKE6SJD1x-Q","name":"Compote de pommes énergétique","form":"semi-liquid","info":{"quantity":{"value":2,"metric":"item"},"cho":{"value":54,"metric":"g"},"sodium":{"value":2,"metric":"mg"}}},{"datoId":