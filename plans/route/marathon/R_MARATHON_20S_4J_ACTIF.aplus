elle variante d'exercice, ou que tu as changé d'objectif de renforcement et que tu es confronté à des nouveaux exercices, commence par l'exécuter lentement pour bien en maîtriser la technique. Quitte à faire une séance plus facile que prévu. Une fois maîtrisé, tu pourras te rapprocher de l'intensité cible des séances proposées.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartPPGExercise","name":"Split Squat avec charge additionnelle","exerciseType":"ppg","sport":"ppg","difficulty":"maximal","repeat":3,"durations":[],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Fente arrière","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"hb4BQg4cqbEo2jFyobgiiaVMM9Lvq227","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"K3t4gDQOM02dAnQYrsSalA01mNjkty8xiu","format":"mobile"}]},{"name":"Split Squat","description":"","variationType":"standard","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730393345-dsc4097.png","muxPlaybackId":"Xh02xvMtrbJimagSnxQkz00TA2tvuktddc","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730393345-dsc4097.png","muxPlaybackId":"sWHMMIyy4h2UCt1nRa02ESjPpivqnf018d","format":"mobile"}]},{"name":"Split Squat avec charge additionnelle","description":"","variationType":"advanced","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730393398-dsc4101.png","muxPlaybackId":"dic02Ysz02AmD200oMRCvd900hIc3lw01Jh85","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730393398-dsc4101.png","muxPlaybackId":"jhDR01T1PHx5t1KEXnb2U1G2Hcejfp01IY","format":"mobile"}]}],"gear":"weights","name":"Split Squat avec charge additionnelle"}},{"_t":"SmartPPGExercise","name":"Bond sur place","exerciseType":"ppg","sport":"ppg","difficulty":"maximal","r