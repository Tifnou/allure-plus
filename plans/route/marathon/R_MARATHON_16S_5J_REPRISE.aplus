"Z2","duration":2700,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"S60_600_6","description":"Séance de seuil 60' où tu vas enchaîner **7 répétitions de 4'** à l'allure cible entrecoupées de 2' de footing lent pour récupérer.","displayName":"Seuil 60","coachAdvice":"On connait la musique, sur le premier intervalle ça va, le 2ème faut commencer à forcer, le 3ème va déjà te sembler long, le 4ème est difficile... et ensuite, comme souvent, tout au mental, ne lâche rien !","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":7,"exercises":[{"_t":"SmartExercise","name":"S60_4","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":5,"weekDate":1790553600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":11.519061583577711,"expectedDuration":3720},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":326}},{"kind":"Z4","duration":240,"pace":{"value":255}},{"kind":"RECOVER","duration":120,"pace"