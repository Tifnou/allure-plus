e).","isStatic":true,"userControlledTraining":null},"stats":{"expectedDistance":64.7241501730718,"realDistance":0,"expectedDuration":21210,"realDuration":0}},{"_id":"6a6753efba18ec46052277e5","weekDate":1792972800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a675372ba63bbdf0c9d5e48","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure marathon, contrastée avec des intensités plus hautes (S60, Sweetspot) pour conserver ton niveau de forme. L'objectif : se préparer spécifiquement à l'effort de ton objectif. Ton plus gros volume hebdomadaire du bloc sera quant à lui atteint 3 semaines avant la course, avec ta séance test sur la sortie longue, pour se laisser le temps d'effacer la fatigue PROGRESSIVEMENT jusqu'à la course (oui, on ne coupe pas tout du jour au lendemain. Tu vas avoir des séances intenses jusqu'à l'avant-dernière semaine).","isStatic":true,"userControlledTraining":null},"stats":{"expectedDistance":58.02275851318605,"realDistance":0,"expectedDuration":18960,"realDuration":0}},{"_id":"6a6753efba18ec46052277e6","weekDate":1793577600000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a675372ba63bbdf0c9d5e48","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure marathon, contrastée avec des intensités plus hautes (S60, Sweetspot) pour conserver ton niveau de forme. L'objectif : se préparer spécifiquement à l'effort de ton objectif. Ton plus gros volume hebdomadaire du bloc sera quant à lui atteint 3 semaines avant la course, avec ta séance test sur la sortie longue, pour se laisser le temps d'effacer la fatigue PROGRESSIVEMENT jusqu'à la course (oui, on ne coupe pas tout du jour au lendemain. Tu vas avoir des séances intenses jusqu'à l'avant-dernière semaine).","isStatic":true,"userControlledTraining":null},"stats":{"expectedDistance":45.84615218236047,"realDistance":0,