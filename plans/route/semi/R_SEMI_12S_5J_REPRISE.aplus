:"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_35","exerciseType":"running","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":6,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.104651162790698,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":329}}]}],"weekStats":{"expectedDistance":32.15894987347873,"realDistance":0,"expectedDuration":11100,"realDuration":0},"exportStatus":"NotAvailable","goalDuration":{"durationInWeeks":12,"index":3},"coach":{"name":"Tristan","image":"https://www.datocms-assets.com/89756/1765362553-tristan-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a672af080da796757bbb5ae","articles":["dRjoMr7tTeGIijBTlk27Mw","MXQV-M2JSCeEk22qKm_-zA","Q9NwIGUhR2GO4MDbDODzqw","SDCSkSizQpqYMMaLDOV_rQ","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1786924800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a672aed80da796757bbb5a4","cycleTheme":"Force_A21","cycleDescription":"Premier cycle d'entrainement spécifique à ton allure de course Semi. Nous sommes à moins de 2 mois de ton échéance, une période idéale pour commencer à optimiser ton aisance et ton économie de course à cette allure spécifique.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":598.6976076896065,"dvalue":40,"abstract":true,"competitive":false},{"slug":"