dDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1785110400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.976744186046512,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":329}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EnduForce_600_1_Alternative1","description":"Cette séance comporte un total de 5 intervalles à très haute intensité, séparés par 3' de récupération à allure très lente ou marchée pour récupérer totalement avant de repartir sur le sprint suivant. \nLa durée des 5 sprints forme une pyramide qui s'enchaine de la manière suivante : 15\" 25\" 35\" 25\" 15\".","displayName":"Endurance de Force","coachAdvice":"Tu découvres peut-être pour la première fois cet effort. Le repos peut paraître long sur le papier. Mais sur le terrain, si on se donne vraiment à fond, on aimerait que ça dure plus longtemps. Savoure-en chaque seconde.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"FORCE_15","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"ENDU_FORCE_25","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstra