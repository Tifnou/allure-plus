y":"performance","backgroundGoal":"speed","goalId":"6a67284a91815bf735ca3a22","cycleTheme":"S60","cycleDescription":"En fonction de ton profil et du temps jusqu'à l'objectif, ce cycle S60 sur mesure commence 3-4 mois avant ton semi-marathon. L'objectif est simple : catapulter ton niveau jusqu'à l'affutage. Un cycle qui repoussera tes limites avec des intervalles longs, mais qui te mettra vraiment en confiance. Tout ce que tu as réalisé avant ce cycle prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":599.0855519007631,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.9223958557279,"dvalue":11.616088673534493,"abstract":true,"competitive":false},{"slug":"fast","value":192.18207982246497,"dvalue":5.701216505791961,"abstract":true,"competitive":false},{"slug":"sprint","value":153.87052110777992,"dvalue":3.2569897232152902,"abstract":true,"competitive":false},{"slug":"ef","value":328.12118772782253,"dvalue":20.115024382122126,"abstract":false,"competitive":false},{"slug":"tempo","value":300.07389576721175,"dvalue":16.698458717408272,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.37946640346314,"dvalue":13.07141744431142,"abstract":false,"competitive":false},{"slug":"aerobie","value":318.39442588592385,"dvalue":18.909739676870576,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.9223958557279,"dvalue":11.616088673534493,"abstract":false,"competitive":false},{"slug":"seuil30","value":242.1400891047672,"dvalue":10.286191714784657,"abstract":false,"competitive":false},{"slug":"vma","value":211.98995942135983,"dvalue":7.384217269215037,"abstract":false,"competitive":false},{"slug":"marathon","value":289.4441077862557,"dvalue":14.269862425664412,"abstract":false,"competitive":true},{"slug":"half-marathon","value":263.2593530220243,"dvalue":12.511326855332648,"abstract":false,"competitive":true},{"slug":"10km","value":247.9656841371