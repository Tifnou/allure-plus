rends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing léger avec quelques lignes droites en accélération progressive pour garder le rythme, sans forcer.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_20","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1786924800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.116076989108698,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":328}},{"kind":"Z5","duration":15,"pace":{"value":193}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":193}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":193}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":193}},{"kind":"RECOVER","duration":45,"pace":{"value":598