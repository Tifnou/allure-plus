f735ca3a49","articles":["fXsuskqsRJKyUegAH67w7g","TtFFvq-sTtqyp8eScxhAdw","fEpB0tbSTe2MTzTxUedhPQ","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1788739200000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a67284a91815bf735ca3a22","cycleTheme":"S60","cycleDescription":"En fonction de ton profil et du temps jusqu'à l'objectif, ce cycle S60 sur mesure commence 3-4 mois avant ton semi-marathon. L'objectif est simple : catapulter ton niveau jusqu'à l'affutage. Un cycle qui repoussera tes limites avec des intervalles longs, mais qui te mettra vraiment en confiance. Tout ce que tu as réalisé avant ce cycle prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":596.5032553922823,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.8235791497279,"dvalue":11.566018720872972,"abstract":true,"competitive":false},{"slug":"fast","value":191.35369878048598,"dvalue":5.676641999813158,"abstract":true,"competitive":false},{"slug":"sprint","value":153.20727808989363,"dvalue":3.2429508047941527,"abstract":true,"competitive":false},{"slug":"ef","value":326.7068551759194,"dvalue":20.02832064329024,"abstract":false,"competitive":false},{"slug":"tempo","value":298.78045817575696,"dvalue":16.626481732641803,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.2226443822297,"dvalue":13.015074447021224,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.0220195381554,"dvalue":18.82823119350132,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.8235791497279,"dvalue":11.566018720872972,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.0963692142197,"dvalue":10.241854145857518,"abstract":false,"competitive":false},{"slug":"vma","value":211.0761985564718,"dvalue":7.3523883619552,"abstract":false,"competitive":false},{"slug":"marathon","value":288.09670561040645,"dvalue":14.197469569782657,"abstract":false,"competit