543859649122,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"S30_600_1","description":"Séance pour commencer à prendre tes marques sur le seuil 30' où tu vas enchaîner **8 répétitions de 1'** à l'allure cible entrecoupées de 1' de footing lent pour récupérer.","displayName":"Seuil 30","coachAdvice":"On commence par prendre ses marques avec cette vitesse qui à la fois est inconfortable et à la fois peut être maintenue relativement longtemps (30 minutes sur le papier). Résister à la douleur ça s'apprend, et tu démarres aujourd'hui l'apprentissage.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":8,"exercises":[{"_t":"SmartExercise","name":"S30_1","exerciseType":"running","pace":{"name":"Seuil 30","value":242,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil30"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":5,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":8.049304554401289,"expectedDuration":2760},"paceZ