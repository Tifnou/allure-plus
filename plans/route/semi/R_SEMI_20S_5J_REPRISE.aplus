é des séances fractionnées afin de correspondre à l'intensification de tes semaines de travail. Mais la séance doit rester \"facile\". Ne cherche pas à te mettre le plein tarif, cette séance est juste là pour conclure un beau bloc de travail ainsi que stimuler (juste ce qu'il faut) ton corps.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"S60_2","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":591,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":5,"weekDate":1794182400000,"status":"todo","nutritionTraining":{"_id":"6a6743f6ba18ec4605217a91","userId":"642ab60364e5867bee895c04","weekDate":1794182400000,"sessionIndex":5,"choRecommendation":3,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":550,"metric":"mL"},"cho":{"value":33,"metric":"g"},"sodium":{"value":2255,"metric":"mg"}}}],[{"datoId":"U