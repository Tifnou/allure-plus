ie...). Le bloc actif est composé de 2 séries de 14' Tempo, séparées par 2' de repos.","displayName":"Sortie Longue & Active","coachAdvice":"La sortie longue, comme sur les footings, c'est le moment de penser à bien courir, à travailler les petits défauts techniques s'il y en a ! Il n'y a aucune sortie sans objectif quand on veut progresser ! :)","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_35","exerciseType":"warm-up","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"Tempo_14","exerciseType":"running","pace":{"name":"Tempo","value":299,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"tempo"},"durations":[{"value":14,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":597,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_8","exerciseType":"recuperation","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":8,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":6,"weekDate":1788134400000,"status":"todo","nutritionTraining":{"_id":"6a6743f6ba18ec4605217a7e","userId":"642ab60364e5867bee895c04","weekDate":1788134400000,"sessionIndex":6,"choRecommendation":2,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":600,"metric":"mL"},"cho":{"value":36,"metric":"g"},"sodium":{"v