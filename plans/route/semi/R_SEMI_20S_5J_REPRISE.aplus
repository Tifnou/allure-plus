-dsc3776.png","muxPlaybackId":"jsjIbumZpQmjvhi01woS5pLCN00wyUe4Bu","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730152226-dsc3776.png","muxPlaybackId":"Kb8mEGZ2xlAkiqRAZu3TV1DSWbZdHwj4","format":"mobile"}]},{"name":"Bond sur place à 1 pied","description":"","variationType":"standard","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730152399-dsc3808.png","muxPlaybackId":"M5026Ab3Q401vJOFGhcl12k2vHGGcBQTdL","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730152399-dsc3808.png","muxPlaybackId":"F7y9xZJd7bQBiTwtbhIrhoGpSQkNRTDQ","format":"mobile"}]}],"gear":"nothing","name":"Bond sur place"}},{"_t":"SmartPPGExercise","name":"Récupération","exerciseType":"recuperation","sport":"ppg","difficulty":"recovery","repeat":1,"durations":[{"value":2,"timeUnit":"minutes"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":3,"trainingIndex":0,"weekDate":1789344000000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_30_2","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Objectif de ta semaine ? La récup, la récup et la récup ! Interdit d'accélérer aujourd'hui c'est endurance fondamentale stricte... et même si ça te semble rabat-joie, c'est pour ton bien, tu nous remercieras quand tu seras au top de ta forme à la fin du plan ! :)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1789344000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.278592375366569,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_30_6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"L'objectif de ces séances mêlant footing et ligne droite n'est pas de générer de la fatigue inutile. On reste sur une sortie à faible intensité, qui devrait te permettre de rentrer \"en forme\". La petite intensité que tu fournis pendant les lignes droites permet de garder ta \"vitesse\" intacte. Ne les cours pas à allure max pour autant, ce n'est pas une séance de sprint, juste une \"piqure de rappel\" de vitesse. Cours à une bonne allure, rapide mais où tu restes en contrôle !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_20","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1789344000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.144644034521443,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":326}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":"Z2","duration":240,"pace":{"value":326}}]},{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - AUTRE - SEMAINE 5 SEANCE 2","description":"Circuit de 9 exercices. Prendre 20\" entre chaque exercice. Répéter le circuit 3 fois en séparant les circuits par 2' de récupération.","displayName":"Renforcement","coachAdvice":"Comme tu es en charge de sélectionner les variantes d'exercices, j'en profite pour te rappeler d'être progressif si tu veux passer à une variante d'exercice plus difficile. Commence par une série, puis deux etc... C'est le meilleur moyen d'éviter les problèmes.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":3,"exercises":[{"_t":"SmartPPGExercise","name":"Split Squat avec charge additionnelle","exerciseType":"ppg","sport":"ppg","difficulty":"moderate","repeat":10,"durations":[],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Fente arrière","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"hb4BQg4cqbEo2jFyobgiiaVMM9Lvq227","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"K3t4gDQOM02dAnQYrsSalA01mNjkty8xiu","format":"mobile"}]},{"name":"Split Squat","description":"","variationType":"standard","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730393345-dsc4097.png","muxPlaybackId":"Xh02xvMtrbJimagSnxQkz00TA2tvuktddc","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730393345-dsc4097.png","muxPlaybackId":"sWHMMIyy4h2UCt1nRa02ESjPpivqnf018d","format":"mobile"}]},{"name":"Split Squat avec charge additionnelle","description":"","variationType":"advanced","videos":[{"thumbnail":"https://www.datocms-asset