ce fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Dernières lignes droites de la reprise pour valider  que tout va bien quand on met de la vitesse. Comme ça, on reprend la semaine prochaine les fractionnés","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_25","exerciseType":"running","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":25,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.124066152548499,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1500,"pace":{"value":329}},{"kind":"Z5","duration":15,"pace":{"value":193}},{"kind":"RECOVER","duration":45,"pace":{"value":600}},{"kind":"Z5","duration":15,"pace":{"value":193}},{"kind":"RECOVER","duration":45,"pace":{"value":600}},{"kind":"Z5","duration":15,"pace":{"value":193}},{"kind":"RECOVER","duration":45,"pace":{"value":600}},{"kind":"Z5","durati