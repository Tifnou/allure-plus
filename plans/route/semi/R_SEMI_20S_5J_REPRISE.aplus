ui s'enchaine de la manière suivante : 15\" 25\" 35\" 25\" 15\".","displayName":"Endurance de Force","coachAdvice":"Tu découvres peut-être pour la première fois cet effort. Le repos peut paraître long sur le papier. Mais sur le terrain, si on se donne vraiment à fond, on aimerait que ça dure plus longtemps. Savoure-en chaque seconde.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"FORCE_15","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3","exerciseType":"recuperation","pace":{"name":"Lent","value":599,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"ENDU_FORCE_25","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":25,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3.2","exerciseType":"recuperation","pace":{"name":"Lent","value":599,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"ENDU_FORCE_35","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":35,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3.3"