":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1791158400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.0588235294117645,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"S30_600_3_Alternative1","description":"Séance mix seuil 30' & VMA. Tu vas commencer par **2 répétitions de 1'** à VMA avec 1' de récupération puis **4 répétitions de 2'** toujours avec 1' de récupération. ","displayName":"Séance S30 alternative : \"Coup de bélier\"","coachAdvice":"On commence avec quelques intervalles à  VMA aujourd'hui ce qui permet, en plus d'un petit rappel, de créer un contraste ensuite avec le S30. Essaie mentalement d'utiliser ce contraste à ton avantage pour trouver le S30 \"facile\" et gagner en efficacité gestuelle, au lieu de trouver ça intense et désagréable.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"VMA_1","exerciseType":"running","pace":{"name":"VMA","value":210,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"vma"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1","exerciseType":"recuperation","pace":{"name":"Lent","value":594,"kind":"abst