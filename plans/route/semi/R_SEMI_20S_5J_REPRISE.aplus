kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Sur ce footing, pense en particulier à ton économie de course. Essaye de ressentir l'énergie \"perdue\" au moment de l'impact au sol et de minimiser cette énergie perdue avec une foulée plus légère.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1792972800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.964601769911504,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":324}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Force_A21_600_2","description":"Séance \"mix\" avec une première partie constituée de 3 fractions de 30\" à intensité maximale entrecoupées de 2'30 de récupération en footing très lent. Une grosse récup qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 4 fractions de 8' à ton allure 21 km avec 2'30 de récupération à chaque fois.","displayName":"Force + Allure 21km","coachAdvice":"2ème séance \"mix\", mais déjà la dernière pour toi. Profites-en encore une fois pour vraiment te donner sur les 30 secondes, sans penser à la suite de la séance ! Son efficacité est vraiment grande sur ta progression si tu réussis à donner le maximum au début et ensuite te mettre en mode \"compétition\" pour la partie allure 21 km !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_30","exerciseType":"running","pace":{"name":"Rapide","value":190,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_2.5","exerciseType":"recuperation","pace":{"name":"Lent","value":592,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":150,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"A21_8","exerciseType":"running","pace":{"name":"Semi Marathon","value":258,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"half-marathon"},"durations":[{"value":8,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2.5","exerciseType":"recuperation","pace":{"name":"Lent","value":592,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":150,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":2,"weekDate"