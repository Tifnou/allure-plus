ue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Sortie Longue","coachAdvice":"Quelle que soit la durée de la sortie longue, cela doit toujours te paraître assez facile. Si jamais ça te semble un peu difficile, peut-être que tu as couru un peu plus vite que prévu ? A l'instar du jour de course, 5 ou 10 secondes /km trop vite sur ces durées, ça commence logiquement à se faire sentir donc si c'est ton cas, attention ! :)","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_80","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":80,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":2,"trainingIndex":6,"weekDate":1790553600000,"status":"todo","nutritionTraining":{"_id":"6a6743f6ba18ec4605217a86","userId":"642ab60364e5867bee895c04","weekDate":1790553600000,"sessionIndex":6,"choRecommendation":3,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":1000,"metric":"mL"},"cho":{"value":60,"metric":"g"},"sodium":{"value":4100,"metric":"mg"}}}],[{"datoId":"UMD5Rt1ESQ25KBXonqCm0A","name":"Jus de pomme","form":"liquid","info":{"quantity":{"value":550,"metric":"mL"},"waterQuantity":{"value":450,"metric":"mL"},"cho":{"value":60.5,"metric":"g"},"sodium":{"value":11,"metric":"mg"}}}],[{"datoId":"AILrY6kmTTaa9W-jLuoFFQ","name":"Jus de raisin","form":"liquid","info":{"quantity":{"value":400,"metric":"mL"},"waterQuantity":{"value":600,"metric":"mL"},"cho":{"value":60,"metric":"g"},"sodium":{"value":20,"metric":"mg"}}}]],"commercial":[[{"datoId":"CobrX8IwSw2uKueLLZanOQ","name":"Velouté de tomates","form":"liquid","info":{"quantity":{"value":1000,"metric":"mL"},"cho":{"value":64,"metric":"g"},"sodium":{"val