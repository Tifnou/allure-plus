 prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":597.4059020879769,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.20767263612169,"dvalue":11.583520768827213,"abstract":true,"competitive":false},{"slug":"fast","value":191.64326096200256,"dvalue":5.685232065495872,"abstract":true,"competitive":false},{"slug":"sprint","value":153.43911595846194,"dvalue":3.2478581356457212,"abstract":true,"competitive":false},{"slug":"ef","value":327.2012378312015,"dvalue":20.058628101439965,"abstract":false,"competitive":false},{"slug":"tempo","value":299.232581765817,"dvalue":16.65164142567168,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.6270137377796,"dvalue":13.034769249753015,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.50174680839524,"dvalue":18.856722640142983,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.20767263612169,"dvalue":11.583520768827213,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.46120350313242,"dvalue":10.257352428086445,"abstract":false,"competitive":false},{"slug":"vma","value":211.39560541878888,"dvalue":7.363514217514894,"abstract":false,"competitive":false},{"slug":"marathon","value":288.56763956997804,"dvalue":14.22276855735844,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.46217508903277,"dvalue":12.469831038954807,"abstract":false,"competitive":true},{"slug":"10km","value":247.21481709568482,"dvalue":10.849359036069094,"abstract":false,"competitive":true},{"slug":"5km","value":233.85259664870338,"dvalue":9.49207640265411,"abstract":false,"competitive":true},{"slug":"1500m","value":212.33677690411673,"dvalue":7.448416622484496,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":339.84407504318574,"dvalue":21.656044313760578,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":327.20123783