N","format":"mobile"}]}],"gear":"nothing","name":"Gainage Latéral"}},{"_t":"SmartPPGExercise","name":"Récupération","exerciseType":"recuperation","sport":"ppg","difficulty":"recovery","repeat":1,"durations":[{"value":2,"timeUnit":"minutes"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":4,"trainingIndex":3,"weekDate":1793577600000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Les footings sont clés sur ce type de semaine, ne vas surtout pas trop vite ! On est en fin de cycle d'entraînement et la fatigue est logiquement importante. Pas le moment de jouer les héros, garde ton énergie pour les séances intenses ! D'ailleurs en phase aiguë d'entraînement, si tu te sens vraiment très fatigué(e), tu peux même t'arrêter au bout de 25 à 30 minutes : privilégie la vraie récup, dans le canapé ou dans ton lit afin de revenir le plus en forme possible pour la prochaine séance !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.964601769911504,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":324}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Substitution_600_1_EvilKenivel_14","description":"Séance en pyramide. D'abord la montée, chaque série est séparée par 30\" de repos, 2 séries de 2' à S60, 2 séries de 1' à S30 puis 2 séries de 30\" à VMA. Une fois la montée terminée, prends 5' de repos, puis on refait les même blocs, mais dans l'autre sens. On commence par les 2 séries à VMA pour finir par les 2 séries à S60.","displayName":"Evel Knievel","coachAdvice":"Séance permettant de travailler à différentes allures et de mettre au point ton référentiel de vitesse. Important pour apprendre à écouter ton corps pendant l'effort.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":324,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"