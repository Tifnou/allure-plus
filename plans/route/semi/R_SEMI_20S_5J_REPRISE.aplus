 plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing léger avec quelques lignes droites en accélération progressive pour garder le rythme, sans forcer pendant cette reprise","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_25","exerciseType":"running","pace":{"name":"EF","value":329,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":25,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"Recup_1","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false}],"blockType":"cool-down"}],"difficulty":1,"trainingIndex":2,"weekDate":1785715200000,"status":"todo","nutritionTraining":{"_id":"6a6743d8ba18ec4605217a1e","userId":"642ab60364e5867bee895c04","weekDate":1785715200000,"sessionIndex":2,"choRecommendation":1,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOm