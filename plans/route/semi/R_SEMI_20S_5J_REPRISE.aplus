ch":{"name":"Tristan","image":"https://www.datocms-assets.com/89756/1765362553-tristan-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a6743f2ba63bbdf0c9c5df2","articles":["TtFFvq-sTtqyp8eScxhAdw","fXsuskqsRJKyUegAH67w7g","fEpB0tbSTe2MTzTxUedhPQ","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1789948800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a6743eeba63bbdf0c9c5de1","cycleTheme":"S60","cycleDescription":"En fonction de ton profil et du temps jusqu'à l'objectif, ce cycle S60 sur mesure commence 3-4 mois avant ton semi-marathon. L'objectif est simple : catapulter ton niveau jusqu'à l'affutage. Un cycle qui repoussera tes limites avec des intervalles longs, mais qui te mettra vraiment en confiance. Tout ce que tu as réalisé avant ce cycle prendra son sens ici, c'est ici qu'on aligne toutes les planètes.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":595.4735672216029,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.38542707842342,"dvalue":11.546053376927098,"abstract":true,"competitive":false},{"slug":"fast","value":191.0233826618917,"dvalue":5.666842939936199,"abstract":true,"competitive":false},{"slug":"sprint","value":152.94281059456137,"dvalue":3.2373528000027187,"abstract":true,"competitive":false},{"slug":"ef","value":326.14289147410636,"dvalue":19.993747613455877,"abstract":false,"competitive":false},{"slug":"tempo","value":298.26470121947443,"dvalue":16.59778098137958,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":266.76136274902706,"dvalue":12.992607732753592,"abstract":false,"competitive":false},{"slug":"aerobie","value":316.47477386864324,"dvalue":18.795729766628106,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.38542707842342,"dvalue":11.546053376927098,"abstract":false,"competitive":false},{"slug":"seuil30","value":240.6801869434115,"dvalue":10.224174584238229,"abstract":false,"competitive":false},{"slug":"vma","value":