y emmener progressivement. Profite bien de ce nouveau cycle d'entraînement, moins tu manqueras de séances de seuil, plus tu pourras profiter des bénéfices exceptionnels de ce cycle !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"S60_3","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":3,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1.5","exerciseType":"recuperation","pace":{"name":"Lent","value":599,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":90,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":2,"weekDate":1786924800000,"status":"todo","nutritionTraining":{"_id":"6a6743f6ba18ec4605217a79","userId":"642ab60364e5867bee895c04","weekDate":1786924800000,"sessionIndex":2,"choRecommendation":1,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":200,"metric":"mL"},"cho":{"value":12,"metric":"g"},"sodium":{"value":820,"metric":"mg"}}}],[{"datoId":"UMD5Rt1ESQ25KBXonqCm0A","name":"Jus de pomme","form":"liquid","info":{"quantity":{"value":110,"metric":"mL"},"wat