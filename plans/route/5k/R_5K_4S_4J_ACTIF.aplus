ation":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Le mot d'ordre : relax ! La séance d'endurance fondamentale, c'est celle où il faut en profiter pour se détendre pour permettre la récupéreration. Le reste de la semaine est rude. Ne tombez pas dans le piège en voulant trop forcer !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1786924800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.871720116618076,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_5_600_S1_HARD1","description":"Séance d'allure 5km. Réalise 3 fois 2' à allure 5km suivies par 1'20 en footing lent. Prends 2'30 de footing lent supplémentaire. Recommence un second bloc identique.","displayName":"Allure 5km","coachAdvice":"Ces séances sont cruciales pour apprendre à courir à ton allure de compétition, aussi bien physiquement que mentalement.\nPhysiquement, elles permettent à ton corps de s'habituer à cette allure et rendent ta foulée plus économique. Mentalement, elles t'aident à identifier le bon rythme et à reconnaître les sensations que tu dois ressentir, sans avoir besoin de regarder ta montre toutes les 10 secondes !\nN'oublie pas de consulter l'article de conseil « Séances d'affûtage : on t'explique tout », disponible avec ta semaine d'entraînement, pour mettre toutes les chances de ton côté et tirer le meilleur parti de ces séances.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"A5_2","exerciseType":"running","pace":{"name":"5km","value":234,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"5km"},"durations":[{"value":120,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1.33","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":80,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"Recup_2.5","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":150,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"A5_2","exerciseType":"running","pace":{"name":"5km","value":234,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"5km"},"durations":[{"value":120,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1.33","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":80,"timeUnit":"sec