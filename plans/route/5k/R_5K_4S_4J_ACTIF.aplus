":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Comment minimiser ta progression ? À cause de footings courus trop rapidement et qui génèrent une fatigue qui va s'ajouter à celle des entraînements fractionnés ! Le programme qu'on te donne a été étudié pour que ces séances soient courues à allure lente, sinon la charge d'entraînement va être trop forte et tu vas soit te blesser, soit t'entraîner plus fort que ce que ton corps peut accepter... et donc ne pas progresser !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1786924800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.997084548104956,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"S'il y a un moment où tu peux travailler ta technique de course, c'est bien en footing ! Prends le temps de penser à un détail que tu souhaites améliorer (voir ici pour 10 points techniques intéressants : https://youtu.be/pP7TCO3kqoM) et concentre toi dessus. Pas sur plusieurs, sur un seul à la fois pour que ce soit vraiment efficace !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":5,"weekDate":1786924800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.997084548104956,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":328}}]}],"weekStats":{"expectedDistance":31.244137406515406,"realDistance":0,"expectedDuration":10650,"realDuration":0},"exportStatus":"OK","goalDuration":{"durationInWeeks":4,"index":1},"coach":{"name":"Tristan","image":"https://www.datocms-assets.com/89756/1765362553-tristan-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a8308eaa5465acfb3ed39ad","articles":["aVIFk3yhR0KaZGfNvIvYLw","OSlq_sGrQoyWCglg_yifdg","cw4hkSgOSHuTSl7Mw-OHow","CVn3qAw6TIef3lxj0ydPGQ","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1787529600000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a83085ced61b9f01c19be57","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure 