on":60,"pace":{"value":234}},{"kind":"RECOVER","duration":60,"pace":{"value":598}},{"kind":"Z5","duration":60,"pace":{"value":234}},{"kind":"RECOVER","duration":60,"pace":{"value":598}},{"kind":"Z5","duration":60,"pace":{"value":234}},{"kind":"RECOVER","duration":60,"pace":{"value":598}},{"kind":"RECOVER","duration":600,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_20_3LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Le fameux \"shakeout run\" à faire soit la veille soit l'avant-veille. Il n'y a pas de bonne solution, que des préférences personnelles. De toute façon, ce n'est plus ça qui fera la différence : tu es prêt(e).","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_15","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_2","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.4338884413058106,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":328}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z2","duration":120,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"5KM","description":"Le travail est fait, il est temps de t'amuser ! Sur 5 km, la difficulté est souvent de trouver le bon équilibre entre partir assez vite sans se mettre dans le rouge trop tôt. Fais confiance à l'entraînement : les premières minutes doivent te sembler rapides, mais maîtrisées. Reste concentré(e) sur tes sensations et accepte l'inconfort qui arrivera progressivement. Aujourd'hui, il n'y a plus rien à construire, seulement à exprimer ce que tu as développé ces dernières semaines. Bonne course !","displayName":"5KM","coachAdvice":"L'équipe CAMPUS te souhaite bon courage pour ta compétition ! On est tous derrière toi :)","test":false,"importance":true,"trainingType":"Competition","trainingCategory":"road_competition","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"","exerciseType":"running","pace":{"name":"course","value":234,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"race"},"durations":[{"value":1170,"timeUnit":"seconds"}],"manualLap":false}]}],"difficulty":5,"trainingIndex":3,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5,"expe