ights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":4,"trainingIndex":3,"weekDate":1789948800000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci ! (je me répète, mais c'est important !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1789948800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.038123167155425,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"S30_600_5","description":"Séance de seuil 30' en **2 blocs**. Dans le premier bloc, enchaîne **2 répétitions de 4'** séparées par 2' de footing lent pour récupérer. Après le deuxième intervalle, prends 4' à footing lent *(soit 2' de bonus !)* puis repars sur le deuxième bloc.","displayName":"Seuil 30","coachAdvice":"Il faut vraiment gérer le début de chaque intervalle, ne pas t'enflammer ! Sur le premier ça va aller, le deuxième va déjà te sembler long, le troisième c'est difficile... et sur le dernier, ce sera comme souvent tout au mental, ne lâche rien !","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"S30_4","exerciseType":"running","pace":{"name":"Seuil 30","value":242,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil30"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug