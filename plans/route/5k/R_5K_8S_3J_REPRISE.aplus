ion":3000},"paceZones":[{"kind":"Z2","duration":3000,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_50_6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Ajouter des lignes droites en accélération progressive dans les footings, c'est vraiment une bonne manière d'entretenir ta vitesse, de te permettre de courir avec une belle amplitude de mouvement et de travailler à avoir une foulée efficace. En plus ça se fait assez naturellement sur des lignes droites ! Concentre-toi sur le fait de te relâcher... et le reste va suivre !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":597,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":8.640309552146698,"expectedDuration":3000},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":327}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z2","duration":240,"pace":{"value":327}}]},{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - AUTRE - SEMAINE 1 SEANCE 2","description":"Séance en 2 blocs. Le premier est composé de 4 séries de 3 exercices enchainés sans pause. Le second est composé de 4 séries de 2 exercices enchainés sans pause à la spécifité que les durées et répétitions diminuent de série en série et que l'intensité diminue. Prend 2'  de récupération entre les séries. ","displayName":"Renforcement","coachAdvice":"Comme tu es en charge de sélectionner les variantes d'exercices, j'en profite pour te rappeler d'être progressif si tu veux passer à une variante d'exercice plus difficile. Commence par une série, puis deux etc... C'est le meilleur moyen d'éviter les problèmes.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":4,"exercises":[{"_t":"SmartPPGExercise","name":"Split Squat avec charge additionnelle","exerciseType":"ppg","sport":"ppg","difficulty":"intense","repeat":10,"durations":[],"gearVariation":{"difficultyA