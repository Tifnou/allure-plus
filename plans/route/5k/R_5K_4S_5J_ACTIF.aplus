ois 4' à allure 5km suivies par 2' de recupération lente. Entre ces 2 blocs, prends au moins 2' de récupération supplémentaire.","displayName":"S30 + Allure 5km","coachAdvice":"Sur le papier la séance te paraîtra abordable, il n'y pas tant d'allure 5km que ça. Mais ne sous-estime pas la pré-fatigue ! Donc on en fait pas trop, on reste en contrôle malgré le cardio très élevé, et on reste efficace sur l'allure de course","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"S30_3","exerciseType":"running","pace":{"name":"Seuil 30","value":242,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil30"},"durations":[{"value":3,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1.5.2","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":90,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"A5_4","exerciseType":"running","pace":{"name":"5km","value":234,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"5km"},"durations":[{"value":240,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"sl