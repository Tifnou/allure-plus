èrent une fatigue qui va s'ajouter à celle des entraînements fractionnés ! Le programme qu'on te donne a été étudié pour que ces séances soient courues à allure lente, sinon la charge d'entraînement va être trop forte et tu vas soit te blesser, soit t'entraîner plus fort que ce que ton corps peut accepter... et donc ne pas progresser !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":6,"weekDate":1789344000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.038123167155425,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":326}}]}],"weekStats":{"expectedDistance":42.37778952741523,"realDistance":0,"expectedDuration":14190,"realDuration":0},"exportStatus":"NotAvailable","goalDuration":{"durationInWeeks":8,"index":5},"coach":{"name":"Tristan","image":"https://www.datocms-assets.com/89756/1765362553-tristan-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a8309d9ed61b9f01c19ca9b","articles":["aVIFk3yhR0KaZGfNvIvYLw","CVn3qAw6TIef3lxj0ydPGQ","cw4hkSgOSHuTSl7Mw-OHow","OSlq_sGrQoyWCglg_yifdg","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1789948800000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a83097fba8e8236710bece9","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure 5km pour se préparer spécifiquement à l'effort de ton objectif, et une dernière semaine pour faire du jus avant le jour J.","isStatic":true},"estimatedPaces":[{"slug":"slow","value":595.3674358108544,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.34026612700745,"