ois 2' à S30 suivies par 1' de footing lent. Un second bloc de 2 fois 4' à allure 5km suivies par 2' de recupération lente. Entre ces 2 blocs, prends au moins 2' de récupération supplémentaire.","displayName":"S30 + Allure 5km","coachAdvice":"L'objectif de la séance est de te préfatiguer avec des intervalles à S30 avant de travailler ton allure 5km. L'objectif est d'être capable de relancer et de retrouver ton allure après ces premiers intervalles.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"S30_2","exerciseType":"running","pace":{"name":"Seuil 30","value":241,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil30"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"A5_4","exerciseType":"running","pace":{"name":"5km","value":232,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"5km"},"durations":[{"value":240,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RE