ance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_20","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Le mot d'ordre ? RÉCUPÈRE ! Donc sur cette sortie on fait juste tourner les jambes pour garder le corps habitué à courir mais on veut revenir frais, sans avoir forcé à aucun moment !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_20","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.508771929824561,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_20_3LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Footing léger avec quelques lignes droites en accélération progressive pour garder le rythme, sans forcer.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_15","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":597,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_2","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.444188887858047,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":327}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z2","duration":120,"pace":{"value":327}}]},{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - AUTRE - SEMAINE 1 SEANCE 2","description":"Séance en 2 blocs. Le premier est composé de 4 séries de 3 exercices enchainés sans pause. Le second est composé de 4 séries de 2 exercices enchainés sans pause à la spécifité que les durées et répétitions diminuent de série en série et que l'intensité diminue. Prend 2'  de récupération entre les séries. ","displayName":"Renforcement","coachAdvice":"Le renforcement est important pour la santé et pour la performance. Mais si tu veux conserver cette habitude longtemps, le mieux est qu'elle n'ait que peu d'impact sur le reste de tes entrainements. De ce fait, n'hésite pas à abaisser ton référentiel d'intensité sur le renforcement. Pour le dire autrement : \"à fond\" en renforcement, c'est moins \"à fond\" qu'en course à pied.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":4,"exercises":[{"_t":"SmartPPGExercise","name":"Split Squat avec charge additionnelle","exerciseType":"ppg","sport":"ppg","difficulty":"intense","repeat":10,"durations":[],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Fente arrière","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"hb4BQg4cqbEo2jFyobgiiaVMM9Lvq227","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"K3t4gDQOM02dAnQYrsSalA01mNjkty8xiu","format":"mobile"}]},{"name":"Split Squat","description":"","variationType":"standard","videos":[{"t