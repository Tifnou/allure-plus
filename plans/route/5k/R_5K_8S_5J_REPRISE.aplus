ve","value":315.623452822451,"dvalue":18.745169021664875,"abstract":true,"competitive":false},{"slug":"vo2max","value":210.14501987617533,"dvalue":7.319952742312936,"abstract":true,"competitive":false},{"slug":"race","value":232,"dvalue":9.424956791544002,"abstract":false,"competitive":true,"race":{"distance":5,"elevation":0,"goalId":"6a830ca0ed61b9f01c19e536"}}],"sessions":[{"_t":"SmartSessionWithStats","sport":"road","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Te détendre, penser au relâchement, à une foulée efficace, à travailler un détail technique ou tout simplement profiter de ton environnement... Les objectifs sont multiples en footing, choisis celui qui te fait le plus envie aujourd'hui... mais surtout cours lentement, contrôle ton allure !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.294117647058823,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_35","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Tu dois commencer à te sentir bien mieux après une semaine tranquille. Même si tu as l'impression que ton corps est totalement remis, prenons une petite semaine encore légère afin de se reposer mentalement aussi.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_35","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.176470588235294,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Recup_S60_21_42_600_1","description":"Petite séance avec du seuil pour garder tes jambes actives sans trop pousser pendant la récupération. Enchaine 8 fois 1' au seuil 60 et 1' lent.","displayName":"Séance intense facile","coachAdvice":"Une petite pointe d'intensité pour se remettre dedans. Rien de bien méchant, ne regarde pas trop ta montre, c'est juste pour relancer la machine, rien de plus.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":8,"exercises":[{"_t":"SmartExercise","name":"S60_1","exerciseType":"running","pace":{"name":"Seuil 60","value":253,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"se