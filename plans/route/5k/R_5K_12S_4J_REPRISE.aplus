56/1765362553-tristan-tete.png"},"access":"allowed"},{"userId":"642ab60364e5867bee895c04","_id":"6a830e06b915b301869538ad","articles":["fEpB0tbSTe2MTzTxUedhPQ","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1790553600000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a830ca0ed61b9f01c19e536","cycleTheme":"S30","cycleDescription":"Ce cycle de S30 est la colonne vertébrale de ta préparation 5km, en parallèle du cycle VMA. Ces deux intensités \"entourent\" ton allure de course 5km. Un combo gagant qui permet de te préparer parfaitement à l'objectif tout en progressant à vitesse grand V.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":595.617451629645,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.44665265448344,"dvalue":11.548843252325115,"abstract":true,"competitive":false},{"slug":"fast","value":191.06953968354546,"dvalue":5.66821222043287,"abstract":true,"competitive":false},{"slug":"sprint","value":152.97976619927334,"dvalue":3.23813504226651,"abstract":true,"competitive":false},{"slug":"ef","value":326.22169745217155,"dvalue":19.99857870705643,"abstract":false,"competitive":false},{"slug":"tempo","value":298.3367709843425,"dvalue":16.60179150682147,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":266.8258203553431,"dvalue":12.995747139396395,"abstract":false,"competitive":false},{"slug":"aerobie","value":316.5512437373408,"dvalue":18.800271382914797,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.44665265448344,"dvalue":11.548843252325115,"abstract":false,"competitive":false},{"slug":"seuil30","value":240.73834254952408,"dvalue":10.226645053774996,"abstract":false,"competitive":false},{"slug":"vma","value":210.76275166545432,"dvalue":7.341470109260823,"abstract":false,"competitive":false},{"slug":"marathon","value":287.63461457728414,"dvalue":14.172649006055845,"abstract":false,"competitive":true},{"slug":"half-marathon","value":261.61355682622343,"dvalue":12.42566989