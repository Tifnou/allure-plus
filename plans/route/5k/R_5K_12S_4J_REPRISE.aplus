tion":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Le mot d'ordre : relax ! La séance d'endurance fondamentale, c'est celle où il faut en profiter pour se détendre pour permettre la récupéreration. Le reste de la semaine est rude. Ne tombez pas dans le piège en voulant trop forcer !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.9178885630498534,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_5_600_S1_HARD1","description":"Séance d'