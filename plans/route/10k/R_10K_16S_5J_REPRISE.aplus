":3,"weekDate":1792368000000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Comment minimiser ta progression ? À cause de footings courus trop rapidement et qui génèrent une fatigue qui va s'ajouter à celle des entraînements fractionnés ! Le programme qu'on te donne a été étudié pour que ces séances soient courues à allure lente, sinon la charge d'entraînement va être trop forte et tu vas soit te blesser, soit t'entraîner plus fort que ce que ton corps peut accepter... et donc ne pas progresser !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1792368000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.0588235294117645,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_10_600_S1_ HARD2","description":"Séance d'allure spécifique 10 km avec **3 intervalles de 7'** à ton allure 10 km entrecoupés de 4' de récupération.","displayName":"Allure 10 km","coachAdvice":"Il n’y a que 3 fractions dans cette séance, mais elle n’est pas facile pour autant. Surtout que l’allure 10 km peut sembler « relativement » facile en début de séance (comme en début de course !), donc reste bien concentré pour ne pas te laisser influencer par cette sensation de pouvoir courir plus vite.\nRappelle-toi que l’objectif est que la dernière série soit aussi bien maîtrisée que la première. Pas question de finir à genoux parce que tu auras tout donné : sur les séances à allure spécifique, tu dois rester en contrôle. Si ce n’est pas le cas, c’est probablement que l’allure est trop rapide.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"A10_7","exerciseType":"running","pace":{"name":"10km","value":244,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"10km"},"durations":[{"value":7,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_4","exerciseType":"recuperation","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":5,"trainingIndex":5,"weekDate":1792368000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":12.575699132111861,"expectedDuration":3780},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":325}},{"kind":"Z4","duration":420,"pace":{"value":244}},{"kind":"RECOVER","duration":240,"pace":{"value":325}},{"kind":"Z4","duration":420,"pace":{"value":244}},{"kind":"RECOVER","duration":240,"pace":{"value":325}},{"kind":"Z4","duration":420,"pace":{"value":244}},{"kind":"RECOVER","duration":240,"pace":{"value":325}},{"kind":"RECOVER","duration":600,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"SL_75","description":"Sortie longue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Sortie Longue","coachAdvice":"On cherche simplement à conserver un bon niveau d'endurance avec cette sortie longue. 10km ça passe vite, pas besoin de faire plus.","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_75","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":75,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":2,"trainingIndex":6,"weekDate":1792368000000,"status":"todo","nutritionTraining":{"_id":"6a689c34ba18ec460532b8a9","userId":"642ab60364e5867bee895c04","weekDa