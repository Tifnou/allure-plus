Advice":"L'erreur serait de laisser la fatigue prendre le dessus sur ton efficacité. Plus la séance avance, plus tu fatigues. Plus tu fatigues moins tu fais attention à ta posture, ton souffle, ton gainage. Cela double la fatigue ! Donc concentre-toi sur tous tes intervalles et ne dégrade pas ta technique.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"S60_4","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":2,"weekDate":1787529600000,"status":"todo","nutritionTraining":{"_id":"6a689c34ba18ec460532b898","userId":"642ab60364e5867bee895c04","weekDate":1787529600000,"sessionIndex":2,"choRecommendation":1,"formSuggestions":["liquid","semi-liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":200,"metric":"mL"},"cho":{"value":12,"metric":"g"},"sodium":{"value":820,"metric":"mg"}}}],[{"