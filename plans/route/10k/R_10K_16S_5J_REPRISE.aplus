}],"gear":"weights","name":"Extension de Mollet"}},{"_t":"SmartPPGExercise","name":"Récupération","exerciseType":"recuperation","sport":"ppg","difficulty":"recovery","repeat":1,"durations":[{"value":60,"timeUnit":"seconds"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":4,"trainingIndex":0,"weekDate":1791158400000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Un autre footing ? Oui mais sur celui-là écoute encore plus tes sensations que d'habitude ! Es-tu aussi facile que d'habitude ? Ou est-ce que la fatigue pointe le bout de son nez et rend la fin de footing plus difficile ? Si c'est le cas, fais attention à la suite de la semaine, tu es dans un état qui fait progresser mais qui peut aussi vite se retourner contre toi si tu vas trop loin dans cette fatigue !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1791158400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.9178885630498534,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Force_A10_600_3","description":"Séance \"mix\" avec une première partie constituée de 3x30\" à intensité maximale entrecoupées de 2'30 de récupération en footing très lent. Une grosse récup qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 3 fractions de 9' à ton allure 10 km avec 3'30 de récupération à chaque fois.","displayName":"Force + Allure 10km","coachAdvice":"Dernière séance mix, maintenant que tu l'as vécue 2 fois, tu dois te rendre compte qu'elle n'est pas si terrible que cela ! Il faut juste prendre l'habitude de courir à allure 10 km avec les jambes \"lourdes\" ! Mais tu t'en rappelleras à ta compétition, vers le 7ème km quand ça brûlera de partout... ce sera du connu pour toi !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"man