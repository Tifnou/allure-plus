g","name":""}}]}],"status":"todo","difficulty":3,"trainingIndex":0,"weekDate":1789948800000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci ! (je me répète, mais c'est important !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1789948800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.9178885630498534,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Force_A10_600_1","description":"Séance \"mix\" avec une première partie constituée de 3 fractions de 30\" à intensité maximale entrecoupées de 2'30 de récupération en footing très lent. Une grosse récup qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 5 fractions de 4' à ton allure 10 km avec 1'30 de récupération à chaque fois.","displayName":"Force + Allure 10km","coachAdvice":"Un type de séance que tu n'as pas dû voir souvent... c'est normal, on utilise les protocoles les plus récents en terme d'optimisation de l'entraînement ! Un mélange de travail d'endurance de force pour stimuler cette qualité essentielle... avant de faire un peu d'allure spécifique compétition avec la fatigue de la première partie de séance dans les jambes... parfait pour simuler le dernier tiers de ton 10km, quand ce sera vraiment dur ! Concernant ton allure 10km en tant que telle, on est encore loin de la course, donc on te conseille de [lire cet article](https://app.campus.coach/knowledges/understand-and-adjust-your-specific-race-pace-v2) avant de te lancer dans la séance ! :)","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_30","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_2.5","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":150,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"A10_4","exerciseType":"running","pace":{"name":"10km","value":244,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"10km"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1.5","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":90,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_5","exerciseType":"recuperation","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":2,"weekDate":1789948800000,"status":"todo","nutritionTraining":{"_id":"6a689a00ba63bbdf0cadd5d5","userId":"642ab60364e5867bee895c04","weekDate":1789948800000,"sessionIndex":2,"choRecommendation":3,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":700,"metric":"mL"},"cho":{"value":42,"metric":"g"},"sodium":{"value":2870,"metric":"mg"}}}],[{"datoId":"UMD5Rt1ESQ25KBXonqCm0A","name":"Jus de pomme","form":"liquid","info":{"quantity":{"value":400,"metric":"mL"},"w