30\" rapides et 30\" lentes, puis tu prendras 4' *(soit 3'30 de bonus !)* pour repartir ensuite sur le second bloc identique.","displayName":"Vitesse Maximale Aérobie (VMA)","coachAdvice":"La VMA est une allure élevée, qui va te faire monter haut dans les tours au niveau du cardio... Mais cette séance est assez simple vu ton niveau. Simple ne veut pas dire que tu dois accélérer. Remplis le contrat, ni plus, ni moins.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"VMA_0.5","exerciseType":"running","pace":{"name":"VMA","value":212,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"vma"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.5","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"Recup_3.5","exerciseType":"running","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"slow"},"durations":[{"value":210,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"VMA_0.5","exerciseType":"running","pace":{"name":"VMA","value":212,"kind":"single-value","zoneKind":"Z5","abstract":false,"slug":"vma"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.5","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"}