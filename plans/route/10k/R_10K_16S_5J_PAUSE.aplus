 catapulter ton niveau vers de nouveaux horizons (ce qui ne manquera pas de te mettre en confiance), soit plus tôt dans la préparation, en étant plus court, pour te mettre le pied à l'étrier et te préparer à la suite.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":597.147784135442,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.09783849529686,"dvalue":11.578515939357768,"abstract":true,"competitive":false},{"slug":"fast","value":191.56045868977233,"dvalue":5.6827756778785,"abstract":true,"competitive":false},{"slug":"sprint","value":153.37282034552683,"dvalue":3.246454851062878,"abstract":true,"competitive":false},{"slug":"ef","value":327.059865753556,"dvalue":20.049961477963222,"abstract":false,"competitive":false},{"slug":"tempo","value":299.1032939548543,"dvalue":16.64444684058958,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.5113815744755,"dvalue":13.02913738716387,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.3645655376277,"dvalue":18.84857531748956,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.09783849529686,"dvalue":11.578515939357768,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.35687666061708,"dvalue":10.252920589033787,"abstract":false,"competitive":false},{"slug":"vma","value":211.3042688574076,"dvalue":7.3603327035615775,"abstract":false,"competitive":false},{"slug":"marathon","value":288.43296697867817,"dvalue":14.215533472929806,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.3396857437614,"dvalue":12.463456045382099,"abstract":false,"competitive":true},{"slug":"10km","value":247.0994435906182,"dvalue":10.843782353207667,"abstract":false,"competitive":true},{"slug":"5km","value":233.7434592027312,"dvalue":9.487171781929376,"abstract":false,"competitive":true},{"slug":"1500m","value":212.23768074760883,"dvalue":7.4445335398948425,"abstract":false,"competitive":true},{"slug":"endurance-confort","