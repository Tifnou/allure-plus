ance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"L'envie d'accélérer sur les footings ? Elle est naturelle, on l'a tous car le footing c'est facile ! Mais il faut absolument te retenir de le faire si tu veux progresser ! Courir plus vite, c'est générer de la fatigue (même un peu) qui va t'empêcher d'être à 100% sur la séance d'intensité suivante... et donc minimiser les progrès de celle-ci ! (je me répète, mais c'est important !)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1790553600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.9178885630498534,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_10_600_S3_ HARD2","description":"Séance d'allure spécifique 10 km avec **3 intervalles de 5'** à ton allure 10 km entrecoupés de 3' de récupération.","displayName":"Allure 10 km","coachAdvice":"Une dernière séance à allure 10 km, qui n'est pas très difficile. À ce stade, l'entraînement est terminé : on n'est plus dans une logique de progression, mais plutôt d'entretien de la forme.\nMême si tu te sens bien, ne cours pas plus vite que ton allure prévue. Essaie plutôt de te relâcher et de courir de manière économique, en pensant au jour J et à la fin de course, où tu auras besoin de toute l'énergie économisée au début.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"A10_5","exerciseType":"running","pace":{"name":"10km","value":246,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"10km"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_3","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":3,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":4,"trainingIndex":