":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120},{"kind":"GPP","duration":30},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":40},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_35","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"En semaine de récupération, on y va encore plus molo sur le footing pour être sûr de réduire la fatigue à zéro avant de reprendre des semaines plus intenses.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_35","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1786924800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.122448979591836,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_35_6LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Du footing et quelques lignes droites en accélération progressive, sans forcer, c'est tout ! Les lignes droites c'est vraiment censé faire du bien ! L'accélération progressive permet d'adapter le rythme à comment se sent ton corps. Puis, au fur et à mesure des lignes droites d'allonger la foulée et de sentir que tout se met en place, que tu es plus à l'aise !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_25","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":25,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1786924800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.9931413140985015,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":1500,"pace":{"value":328}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z2","duration":240,"pace":{"value":328}}]},{"_t":"SmartPPGSessionWithStats","name":"PERF - MID - FORCE + AS  - SEMAINE 4 SEANCE 2","description":"Séance en 2 blocs. Le premier est composé de 5 séries de 3 exercices enchainés sans pause. Le second est composé de 3 séries de 2 exercices enchainés sans pause. Prend 1'30  de récupération entre les séries des bloc 1, et 1' entre les séries du bloc 2. ","displayName":"Renforcement","coachAdvice":"Le renforcement régulier améliore ta performance en course, prévient dans une certaine mesure des blessures, mais c'est surtout un investissement primordial pour ta santé ! Je sais que ça vend moins du rêve qu'un RP sur 10km, mais c'est important de le rappeler.","importance":true,"trainingType":"PPG","trainingCategory":"gpp","exercisesBlocks":[{"repeat":5,"exercises":[{"_t":"SmartPPGExercise","name":"Split Squat avec charge additionnelle","exerciseType":"ppg","sport":"ppg","difficulty":"maximal","repeat":4,"durations":[],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[{"name":"Fente arrière","description":"","variationType":"simplified","videos":[{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"hb4BQg4cqbEo2jFyobgiiaVMM9Lvq227","format":"desktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730151937-dsc3692.png","muxPlaybackId":"K3t4gDQOM02dAnQYrsSalA01mNjkty8xiu","format":"mobile"}]},{"name":"Split Squat","description":"","variationType":"stan