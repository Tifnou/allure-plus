ue":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_2","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1789344000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.4425836487120813,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":327}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":598}},{"kind":"Z2","duration":120,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"10 BORNES","description":"Tu es prêt(e). Le piège du 10 km est souvent de se laisser emporter par l'ambiance du départ et de partir plus vite que prévu. Respecte ton allure dès les premiers kilomètres et laisse la course venir à toi. Si tu gères bien le début, tu pourras accélérer ou maintenir ton effort jusqu'à l'arrivée sans subir. Fais confiance à ton plan, à ton entraînement et aux sensations que tu as travaillées pendant les séances spécifiques. Bonne cours