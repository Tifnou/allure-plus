:"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120},{"kind":"GPP","duration":20},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":30},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Qu'en est-il de l'amélioration de tes capacités cardio-respiratoires ? Tu devrais vraiment être très à l'aise à ton allure de footing arrivé(e) à ce stade de ta préparation ! Lorsqu'on est en forme, les footings, ce sont des entraînements où on a presque l'impression d'être aussi frais en revenant qu'avant d'être parti ! (et si tu es parti déjà fatigué(e) à cause de l'entraînement fractionné de la veille par exemple... alors tu ne devrais pas être plus fatigué(e) encore en rentrant sinon mieux vaut raccourcir le footing avant de rentrer dans cet état d'accumulation de fatigue supplémentaire!)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.997084548104956,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Force_A10_600_2","description":"Séance \"mix\" avec une première partie constituée de 3 fractions de 30\" à intensité maximale entrecoupées de 2'30 de récupération en footing très lent. Une grosse récup qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 4 fractions de 6' à ton allure 10 km avec 2'30 de récupération à chaque fois.","displayName":"Force + Allure 10km","coachAdvice":"2ème séance \"mix\", profites-en encore une fois pour vraiment te donner sur les 30 secondes, sans penser à la suite de la séance ! Son efficacité est vraiment grande sur ta progression si tu réussis à donner le maximum au début et ensuite te mettre en mode \"compétition\" pour la partie allure 10 km !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_30","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_2.