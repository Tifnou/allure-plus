priority":"performance","backgroundGoal":"speed","goalId":"6a6894d00462290c63b3d6c2","cycleTheme":"S60","cycleDescription":"Le cycle de S60 est un cycle complémentaire au cycle de S30 sur ta préparation 10km, qui s'organiseront pour répondre à la logique de spécificité de ton plan. En fonction de ton chrono objectif, ce cycle S60 arrivera soit pendant les derniers mois de préparation pour catapulter ton niveau vers de nouveaux horizons (ce qui ne manquera pas de te mettre en confiance), soit plus tôt dans la préparation, en étant plus court, pour te mettre le pied à l'étrier et te préparer à la suite.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":598.8269876429015,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.8123718034244,"dvalue":11.611075190338994,"abstract":true,"competitive":false},{"slug":"fast","value":192.0991343788872,"dvalue":5.698755870895913,"abstract":true,"competitive":false},{"slug":"sprint","value":153.80411086475095,"dvalue":3.255584012248013,"abstract":true,"competitive":false},{"slug":"ef","value":327.97957120723675,"dvalue":20.106342773402435,"abstract":false,"competitive":false},{"slug":"tempo","value":299.9443844079136,"dvalue":16.691251692348178,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.2636343034641,"dvalue":13.06577584380886,"abstract":false,"competitive":false},{"slug":"aerobie","value":318.25700741843593,"dvalue":18.901578266884332,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.8123718034244,"dvalue":11.611075190338994,"abstract":false,"competitive":false},{"slug":"seuil30","value":242.0355818733056,"dvalue":10.281752212749412,"abstract":false,"competitive":false},{"slug":"vma","value":211.89846493220406,"dvalue":7.381030254185146,"abstract":false,"competitive":false},{"slug":"marathon","value":289.3091719660676,"dvalue":14.262611354172082,"abstract":false,"competitive":true},{"slug":"half-marathon","value":263.1366242610421,"dvalue":12.504937