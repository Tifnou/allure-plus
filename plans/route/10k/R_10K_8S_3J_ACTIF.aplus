kUi_2WZNQ","YkQgU8A7RQiZ45i9Zht6Rw","cuudnKMZTVaBojvr_lkm8g","ObIuIhepQ2aI7aVHR8-vLg"],"weekDate":1791158400000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a7dbba0755f101affa7d942","cycleTheme":"affutage","cycleDescription":"On rentre dans le Money Time. Dernier mois de préparation. 3 semaines d'allure 10km, avec des intervalles courts et des longs, et une \"séance test\" en semaine 3. L'objectif : se préparer spécifiquement à l'effort de ton objectif.","isStatic":true},"estimatedPaces":[{"slug":"slow","value":595.8674414205013,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.55302810657435,"dvalue":11.553690479184215,"abstract":true,"competitive":false},{"slug":"fast","value":191.14973450344846,"dvalue":5.670591256143858,"abstract":true,"competitive":false},{"slug":"sprint","value":153.04397415633164,"dvalue":3.2394941372691224,"abstract":true,"competitive":false},{"slug":"ef","value":326.3586177081106,"dvalue":20.006972417641553,"abstract":false,"competitive":false},{"slug":"tempo","value":298.46198750843706,"dvalue":16.608759533656976,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":266.937811249571,"dvalue":13.001201654035818,"abstract":false,"competitive":false},{"slug":"aerobie","value":316.68410515535453,"dvalue":18.808162145514554,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.55302810657435,"dvalue":11.553690479184215,"abstract":false,"competitive":false},{"slug":"seuil30","value":240.83938412871288,"dvalue":10.230937333746255,"abstract":false,"competitive":false},{"slug":"vma","value":210.85121202883857,"dvalue":7.3445514370025995,"abstract":false,"competitive":false},{"slug":"marathon","value":287.7650194208845,"dvalue":14.179653178264896,"abstract":false,"competitive":true},{"slug":"half-marathon","value":261.73216450844484,"dvalue":12.43184134095385,"abstract":false,"competitive":true},{"slug":"10km","value":246.52721541709352,"dvalue":10.816126825968267,"abstract":false,"competitive":true},{"slug":"5km","value":233.20216056284227,"dvalue":9.462849292333422,"abstract":false,"competitive":true},{"slug":"1500m","value":211.7461847788501,"dvalue":7.425277241021553,"abstract":false,"competitive":true},{"slug":"endurance-confort","value":338.9688966415309,"dvalue":21.600274907610835,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":326.3586177081106,"dvalue":20.006972417641553,"abstract":true,"competitive":false},{"slug":"endurance-active","value":316.68410515535453,"dvalue":18.808162145514554,"abstract":true,"competitive":false},{"slug":"vo2max","value":210.85121202883857,"dvalue":7.3445514370025995,"abstract":true,"competitive":false},{"slug":"race","value":247,"dvalue":10.816126825968267,"abstract":false,"competitive":true,"race":{"distance":10,"elevation":0,"goalId":"6a7dbba0755f101affa7d942"}}],"sessions":[{"_t":"SmartSessionWithStats","sport":"road","name":"EF_35","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"La semaine de course est arrivée ! Tu commences à être bien reposé(e), alors ne gâche pas tout en voulant te « tester » sur cette séance. Respecte ton endurance fondamentale : elle est simplement là pour te garder actif(ve) et éviter le désentraînement. Le travail est fait, fais-toi confiance.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_35","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1791158400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.140350877192983,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_20_3LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Le fameux \"shakeout run\" à faire soit la veille soit l'avant-veille. Il n'y a pas de bonne solution, que des préférences personnelles. De toute façon, ce n'est plus ça qui fera la différence : tu es prêt(e).","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_15","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":597,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_2","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1791158400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.4429617936172088,"expectedDuration":1200},"paceZones":[{"kind":"Z2","duration":900,"pace":{"value":327}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z5","duration":15,"pace":{"value":192}},{"kind":"RECOVER","duration":45,"pace":{"value":597}},{"kind":"Z2","duration":120,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"10 BORNES","description":"Tu es prêt(e). Le piège du 10 km est souvent de se laisser emporter par l'ambiance du départ et de partir plus vite que prévu. Respecte ton allure dès les premiers kilomètres et laisse la course venir à toi. Si tu gères bien le début, tu pourras accélérer ou maintenir ton effort jusqu'à l'arrivée sans subir. Fais confiance à ton plan, à ton entraînement et aux sensations que tu as travaillées pendant les séances spécifiques. Bonne course !","displayName":"10 BORNES","coachAdvice":"L'équipe CAMPUS te souhaite bon courage pour ta compétition ! On est tous derrière toi :)","test":false,"importance":true,"trainingType":"Competition","trainingCategory":"road_competition","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"","exerciseType":"running","pace":{"name":"course","value":247,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"race"},"durations":[{"value":2470,"timeUnit":"seconds"}],"manualLap":false}]}],"difficulty":5,"trainingIndex":2,"weekDate":1791158400000,"status":"todo","nutritionTraining":{"_id":"6a7dbba52fa3c259455c1630","userId":"642ab60364e5867bee895c04","weekDate":1791158400000,"sessionIndex":2,"choRecommendation":3,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":