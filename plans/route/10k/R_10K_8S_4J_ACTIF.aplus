ktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730394833-dsc4270.png","muxPlaybackId":"01brVbo2iL201c02T5ep7PjTZ00nODTWfkJb","format":"mobile"}]}],"gear":"weights","name":"Extension de Mollet"}},{"_t":"SmartPPGExercise","name":"Récupération","exerciseType":"recuperation","sport":"ppg","difficulty":"recovery","repeat":1,"durations":[{"value":60,"timeUnit":"seconds"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":4,"trainingIndex":0,"weekDate":1787529600000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de ta forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Le mot d'ordre : relax ! La séance d'endurance fondamentale, c'est celle où il faut en profiter pour se détendre pour permettre la récupéreration. Le reste de la semaine est rude. Ne tombez pas dans le piège en voulant trop forcer !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_45","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":45,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.871720116618076,"expectedDuration":2700},"paceZones":[{"kind":"Z2","duration":2700,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_10_600_S1_HARD1","description":"Séance d'allure spécifique 10 km en pyramide avec des intervalles qui augmentent puis qui redescendent en fin de séance. Commence par 3' à ton allure 10 km (voir ci-dessous), suivies de 2' de récupération en footing lent. On passe ensuite à 5' d'allure 10 km avec 3' de récupération. Puis le sommet de la pyramide avec 8' d'allure 10 km suivies de 4' de récupération. On redescend ensuite la pyramide avec à nouveau 5' allure 10 km récupération 3'. Et pour finir 3' allure 10 km.","displayName":"Allure 10 km","coachAdvice":"Ces séances sont cruciales pour apprendre à courir à ton allure de compétition, aussi bien physiquement que mentalement.\nPhysiquement, elles permettent à ton corps de s'habituer à cette allure et rendent ta foulée plus économique. Mentalement, elles t'aident à identifier le bon rythme et à reconnaître les sensations que tu dois ressentir, sans avoir besoin de regarder ta montre toutes les 10 secondes !\nN'oublie pas de consulter l'article de conseil « Séances d'affûtage : on t'explique tout », disponible avec ta semaine d'entraînement, pour mettre toutes les chances de ton côté et tirer le meilleur parti de ces séances.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exerci