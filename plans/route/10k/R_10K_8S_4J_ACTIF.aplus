:"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Avec la grosse séance test de cette semaine, je serais toi, je respecterai bien l'endurance fondamentale prévue.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1788739200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.997084548104956,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_10_600_S3_ HARD1","description":"C'est l'heure de valider ton allure 10 km pour la compétition ! Cette séance test est donc un enchaînement de 15' avec 1'30 de récupération puis 10' avec 1'30 de récupération pour finir avec 5'.","displayName":"Allure 10 km","coachAdvice":"Séance test sur laquelle tu vas devoir gérer les premières 12' comme si c'était le début de course. On ne part pas trop vite, on se met dans son allure et on essaye de courir \"efficace\". Ensuite, il faut essayer de maintenir ça sur les 8' qui suivent. Si l'allure est bonne ça devrait te sembler dur à la fin de ce 8' mais pas insurmontable. Et sur le dernier intervalle, c'est \"juste\" 4', donc tu ne devrais pas être au bout du bout de ta vie non plus. Sinon c'est que l'allure est peut être un peu ambitieuse. Idem si tu es \"trop facile\" peut-être qu'on peut descendre l'allure de quelques secondes au km ? *(mais attention pas d'excès de confiance non plus, ce serait dommage de le payer le jour de la course !)*","test":true,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"A10_15","exerciseType":"running","pace":{"name":"10km","value":247,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"10km"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1.5","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":90,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"A10_10","exerciseType":"running","pace":{"name":"10km","value":247,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"10km"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1.5.2","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":90,"timeUn