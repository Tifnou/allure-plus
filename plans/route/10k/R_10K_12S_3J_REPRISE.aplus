t":false,"competitive":true,"race":{"distance":10,"elevation":0,"goalId":"6a7dbd32afd2719931e94833"}}],"sessions":[{"_t":"SmartSessionWithStats","sport":"road","name":"Recup_active_30","description":"La récupération active se fera idéalement sous forme de vélo, de natation, ski de fond ou encore une marche bien active en sentier. On ne force pas, ce n'est pas encore le moment de reprendre l'entrainement et encore moins l'impact de la course à pied.","displayName":"Récupération active","coachAdvice":"Certains récupèrent mieux quand cette séance est placée le lendemain de la course. Cependant, dans la majorité des cas, attendre 2-3 jours ne fait jamais de mal.","test":false,"importance":false,"trainingType":"Special","trainingCategory":"road_special","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"LENT_30","exerciseType":"running","pace":{"name":"Lent","value":594,"kind":"abstract","zoneKind":"Z1","abstract":true,"slug":"slow"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1794182400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.0303030303030303,"expectedDuration":1800},"paceZones":[{"kind":"Z1","duration":1800,"pace":{"value":594}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Une première semaine post-course en douceur. Tu t'es donné(e) à 100% sur ta course alors laisse à ton corps le temps de se régénérer pour le remercier.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1794182400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.294117647058823,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":325}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_30_2","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Tu peux toujours continuer à t'entraîner, juste pour retrouver les sensations. Les choses sérieuses reprendront la semaine prochaine.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":325,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1794182400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.294117647058823,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":325}}]}],"weekStats":{"expectedDistance":13.618538324420676,"realDistance":0,"expectedDuration":5400,"realDuration":0},"exportStatus":"NotAvailable","coach":{"name":"Tristan","image":"https://www.datocms-assets.com/89756/1765362553-tristan-tete.png"},"access":"allowed"}]}