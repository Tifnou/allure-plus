ement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Dernières lignes droites de la reprise pour valider  que tout va bien quand on met de la vitesse. Comme ça, on reprend la semaine prochaine les fractionnés","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_25","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":25,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":598,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1788134400000,"status":"todo","nutritionTraining":{"_id":"6a7dbd36c57bc45d294b35b0","userId":"642ab60364e5867bee895c04","weekDate":1788134400000,"sessionIndex":2,"choRecommendation":2,"formSuggestions":["semi-liquid","liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":550,"metric":"mL"},"cho":{"value":33,"metric":"g"},"sodium":{"value":2255,"metric":"mg"}}}],[{"datoId":"UMD5Rt1ESQ25KBXonqCm0A","name":"Jus de pomme","form":"liquid","info"