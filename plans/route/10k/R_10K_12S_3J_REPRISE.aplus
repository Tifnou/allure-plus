le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"On démarre de manière classique par un bon footing et en fin de séance un peu de piment avec quelques accélérations. Rien de difficile, c'est court, c'est rapide, mais pas à fond et tu as suffisament de récupération ensuite pour que le cardio ne s'affole pas !","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_25","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":25,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":6,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":596,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_4","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1791158400000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.026863618897546,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":1500,"pace":{"value":326}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":"Z5","duration":15,"pace":{"value":191}},{"kind":"RECOVER","duration":45,"pace":{"value":596}},{"kind":