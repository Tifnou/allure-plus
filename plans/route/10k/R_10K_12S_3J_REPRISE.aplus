 entrecoupées de 2'30 de récupération en footing très lent. Une grosse récup qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 4 fractions de 6' à ton allure 10 km avec 2'30 de récupération à chaque fois.","displayName":"Force + Allure 10km","coachAdvice":"2ème séance \"mix\", profites-en encore une fois pour vraiment te donner sur les 30 secondes, sans penser à la suite de la séance ! Son efficacité est vraiment grande sur ta progression si tu réussis à donner le maximum au début et ensuite te mettre en mode \"compétition\" pour la partie allure 10 km !","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_30","exerciseType":"running","pace":{"name":"Rapide","value":192,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_2.5","exerciseType":"recuperation","pace":{"name":"Lent","value":597,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":150,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"A10_6","exerciseType":"running","pace":{"name":"10km","value":246,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"10km"},"durations":[{"value":6,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2.5","exerciseType":"recuperation","pace":{"name":"Lent","value":597,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":150,"timeUnit":"seconds"}],"manualLap":false}]},{"repe