11741801948824,"dvalue":21.54601573369748,"abstract":true,"competitive":false},{"slug":"endurance-fondamentale","value":325.5388156883645,"dvalue":19.95671556672037,"abstract":true,"competitive":false},{"slug":"endurance-active","value":315.88860519015964,"dvalue":18.760916666222794,"abstract":true,"competitive":false},{"slug":"vo2max","value":210.3215607798504,"dvalue":7.326102167470613,"abstract":true,"competitive":false},{"slug":"race","value":246,"dvalue":10.783809549311833,"abstract":false,"competitive":true,"race":{"distance":10,"elevation":0,"goalId":"6a7dbd32afd2719931e94833"}}],"sessions":[{"_t":"SmartSessionWithStats","sport":"road","name":"EF_35","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"La semaine de course est arrivée ! Tu commences à être bien reposé(e), alors ne gâche pas tout en voulant te « tester » sur cette séance. Respecte ton endurance fondamentale : elle est simplement là pour te garder actif(ve) et éviter le désentraînement. Le travail est fait, fais-toi confiance.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_35","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.158357771260997,"expectedDuration":2100},"paceZones":[{"kind":"Z2","duration":2100,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_20_3LD","description":"Footing à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Le fameux \"shakeout run\" à faire soit la veille soit l'avant-veille. Il n'y a pas de bonne solution, que des préférences personnelles. De toute façon, ce n'est plus ça qui fera la différence : tu es prêt(e).","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_15","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_0.75","exerciseType":"recuperation","pace":{"name":"Lent","value":595,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":45,"timeUnit":"seconds"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_2","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1793577600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.4536951965844143,"expectedDuration":1200},"paceZones":[{"kind":"Z2","durati