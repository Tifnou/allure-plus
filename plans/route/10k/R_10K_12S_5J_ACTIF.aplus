 de ton chrono objectif, ce cycle S60 arrivera soit pendant les derniers mois de préparation pour catapulter ton niveau vers de nouveaux horizons (ce qui ne manquera pas de te mettre en confiance), soit plus tôt dans la préparation, en étant plus court, pour te mettre le pied à l'étrier et te préparer à la suite.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":599.0855519007631,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.9223958557279,"dvalue":11.616088673534493,"abstract":true,"competitive":false},{"slug":"fast","value":192.18207982246497,"dvalue":5.701216505791961,"abstract":true,"competitive":false},{"slug":"sprint","value":153.87052110777992,"dvalue":3.2569897232152902,"abstract":true,"competitive":false},{"slug":"ef","value":328.12118772782253,"dvalue":20.115024382122126,"abstract":false,"competitive":false},{"slug":"tempo","value":300.07389576721175,"dvalue":16.698458717408272,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":268.37946640346314,"dvalue":13.07141744431142,"abstract":false,"competitive":false},{"slug":"aerobie","value":318.39442588592385,"dvalue":18.909739676870576,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.9223958557279,"dvalue":11.616088673534493,"abstract":false,"competitive":false},{"slug":"seuil30","value":242.1400891047672,"dvalue":10.286191714784657,"abstract":false,"competitive":false},{"slug":"vma","value":211.98995942135983,"dvalue":7.384217269215037,"abstract":false,"competitive":false},{"slug":"marathon","value":289.4441077862557,"dvalue":14.269862425664412,"abstract":false,"competitive":true},{"slug":"half-marathon","value":263.2593530220243,"dvalue":12.511326855332648,"abstract":false,"competitive":true},{"slug":"10km","value":247.96568413711802,"dvalue":10.885658880025124,"abstract":false,"competitive":true},{"slug":"5km","value":234.56287853811423,"dvalue":9.524001961726402,"abstract":false,"competitive":true},{"slug":"1500m","value":212.981