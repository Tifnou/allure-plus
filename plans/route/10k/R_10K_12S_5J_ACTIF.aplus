GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Lors des footings en endurance fondamentale, on veut être vraiment \"facile\" du début à la fin. Tellement en aisance que quand tu termines la sortie, tu devrais avoir l'impression de pouvoir continuer de courir comme ça pendant encore un moment sans problème.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1785715200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.997084548104956,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EnduForce_600_2","description":"Séance d'endurance de force en **deux blocs**. Il y a 3 intervalles par bloc, respectivement de **35\", 25\" et 15\"**, séparés par 3' de repos courues très lentement et/ou marchées. À la fin du premier bloc, après le dernier sprint de 15\", prends 5' *(soit 2' de bonus !)* puis repars sur le second bloc avec autant d'intensité que sur le premier.","displayName":"Endurance de Force","coachAdvice":"Le but est d'imposer à ton corps des contraintes mécaniques élevées (impact). Mais cela ne doit jamais déclencher de douleur / en aggraver. Prends ton temps à l'échauffement, puis sur les premiers intervalles pour te permettre de t'exprimer pleinement sur les sprints suivants.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_35","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":35,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"ENDU_FORCE_25","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":25,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3.2","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"FORCE_15","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":15,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_5","exerciseType":"recuperation","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"d