tion":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":120}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Tu ressens de la fatigue sur ce footing ? C'est logique, on arrive en fin de cycle d'entraînement, ne lâche pas mais en même temps prends en compte cette fatigue ! Dors un peu plus, fais plus attention à ce que tu manges, utilise ton foam roller pour un bon massage des points de tension... Bref fais tout pour accélérer la récupération ! :)","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.997084548104956,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EnduForce_600_3","description":"Séance d'endurance de force en deux blocs. Il y a 3 intervalles par bloc, respectivement de 40\", 30\" et 20\", séparés par 3' de repos courues très lentement et/ou marchés. À la fin du premier bloc, après le dernier sprint de 20\", prends 5' *(soit 2' de bonus !)* activement afin de pouvoir repartir sur le second bloc avec autant d'intensité que sur le premier.","displayName":"Endurance de Force","coachAdvice":"Si tu fais tes séances de sprints toujours au même endroit, prends des repères. Tu devrais savoir quelle distance tu es capable d'atteindre en fonction du nombre de secondes. Et semaine après semaine, essaie de repousser cette distance.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":2,"exercises":[{"_t":"SmartExercise","name":"ENDU_FORCE_40","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":40,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3","exerciseType":"recuperation","pace":{"name":"Lent","value":599,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"ENDU_FORCE_30","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":30,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recuppassive_3.2","exerciseType":"recuperation","pace":{"name":"Lent","value":599,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":180,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"ENDU_FORCE_20","exerciseType":"running","pace":{"name":"Rapide","value":193,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"durations":[{"value":20,"timeUnit":"seconds"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_5","exerciseType":"recuperation","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":5,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_10","exerciseType":"recuperation","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":10,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"trainingIndex":5,"weekDate":1786320000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":9.131730374049752,"expectedDuration":3300},"paceZones":[{"kind":"Z2","duration":1200,"pace":{"value":328}},{"kind":"Z5","duration":40,"pace":{"value":193}},{"kind":"RECOVER","duration":180,"pace":{"value":599}},{"kind":"Z5","duration":30,"pace":{"value":193}},{"kind":"RECOVER","duration":180,"pace":{"value":599}},{"kind":"Z5","duration":20,"pace":{"value":193}},{"kind":"RECOVER","duration":300,"pace":{"value":328}},{"kind":"Z5","duration":40,"pace":{"value":193}},{"kind":"RECOVER","duration":180,"pace":{"value":599}},{"kind":"Z5","duration":30,"pace":{"value":193}},{"kind":"RECOVER","duration":180,"pace":{"value":599}},{"kind":"Z5","duration":20,"pace":{"value":193}},{"kind":"RECOVER","duration":300,"pace":{"value":328}},{"kind":"RECOVER","duration":600,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"SL_70_HARD_1","description":"Sortie longue en endurance fondamentale avec un bloc actif **FACULTATIF** en deuxième moitié de sortie (en cas de fatigue excessive, douleur, manque d'envie...). Le bloc actif est composé de 4 séries. Chaque série est constituée de 2' d'endurance active, suivies par 2' Tempo, puis 2' Sweetspot pour terminer avec 1' de récupération avant de commencer la série suivante.","displayName":"Sortie Longue & Active","coachAdvice":"1h10 de sortie longue, c'est peu et beaucoup à la fois ! Pour un marathonien, ce serait peu, mais pour toi, coureur qui t'apprêtes à courir un 10km, on commence déjà à être dans des distances vraiment intéressantes !","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_30","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":4,"exercises":[{"_t":"SmartExercise","name":"Aerobie_2","exerciseType":"running","pace":{"name":"Aerobie","value":318,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"aerobie"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Tempo_2","exerciseType":"running","pace":{"name":"Tempo","value":300,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"tempo"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"SweetSpot_2","exerciseType":"running","pace":{"name":"Sweet spot","value":268,"kind":"single-value","zoneKind":"Z3","abstract":false,"slug":"sweet-spot"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_1","exerciseType":"recuperation","pace":{"name":"Lent","value":599,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":1,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"CD_12","exerciseType":"recuperation","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"value":12,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"cool-down"}],"difficulty":3,"t