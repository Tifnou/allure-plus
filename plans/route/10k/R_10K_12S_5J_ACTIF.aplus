_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1785715200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":6.997084548104956,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":328}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"S60_600_2","description":"Séance de seuil 60' où tu vas enchaîner **5 répétitions de 4'** à l'allure cible entrecoupées de 2' de footing lent pour récupérer.","displayName":"Seuil 60","coachAdvice":"L'erreur serait de laisser la fatigue prendre le dessus sur ton efficacité. Plus la séance avance, plus tu fatigues. Plus tu fatigues moins tu fais attention à ta posture, ton souffle, ton gainage. Cela double la fatigue ! Donc concentre-toi sur tous tes intervalles et ne dégrade pas ta technique.","test":false,"importance":true,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_15","exerciseType":"warm-up","pace":{"name":"EF","value":328,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":15,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"S60_4","exerciseType":"running","pace":{"name":"Seuil 60","value":255,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"seuil60"},"durations":[{"value":4,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_2","exerciseType":"recuperation","pace":{"name":"Lent","value":600,"kind":"abstract","zoneKind":"RECOVER","abstract":true,"slug":"slow"},"durations":[{"value":2,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":1,"exercises":[{"_t":"SmartExe