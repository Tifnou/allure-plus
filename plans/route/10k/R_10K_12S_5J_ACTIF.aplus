ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1789948800000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.038123167155425,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Affutage_10_600_S1_ HARD2","description":"Séance d'allure spécifique 10 km avec **3 intervalles de 7'** à ton allure 10 km entrecoupés de 4' de récupération.","displayName":"Allure 10 km","coachAdvice":"Il n’y a que 3 fractions dans cette séance, mais elle n’est pas facile pour autant. Surtout que l’allure 10 km peut sembler « relativement » facile en début de séance (comme en début de course !), donc reste bien concentré pour ne pas te laisser influencer par cette sensation de pouvoir courir plus vite.\nRappelle-toi que l’objectif est que la dernière série soit aussi bien maîtrisée que la première. Pas question de finir à genoux parce que tu auras tout donné : sur les séances à allure spécifique, tu dois rester en contrôle. Si ce n’est pas le cas, c’est probablement que l’allure est trop rapide.","test":false,"importance":false,"trainingType":"Intensity","trainingCategory":"road_intensity","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"WU_20","exerciseType":"warm-up","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":20,"timeUnit":"minutes"}],"manualLap":true}],"blockType":"warm-up"},{"repeat":3,"exercises":[{"_t":"SmartExercise","name":"A10_7","exerciseType":"running","pace":{"name":"10km","value":245,"kind":"single-value","zoneKind":"Z4","abstract":false,"slug":"10km"},"durations":[{"value":7,"timeUnit":"minutes"}],"manualLap":false},{"_t":"SmartExercise","name":"Recup_4","exerciseType":"recuperation","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"RECOVER","abstract":false,"slug":"ef"},"durations":[{"v