ktop"},{"thumbnail":"https://www.datocms-assets.com/89756/1730394833-dsc4270.png","muxPlaybackId":"01brVbo2iL201c02T5ep7PjTZ00nODTWfkJb","format":"mobile"}]}],"gear":"weights","name":"Extension de Mollet"}},{"_t":"SmartPPGExercise","name":"Récupération","exerciseType":"recuperation","sport":"ppg","difficulty":"recovery","repeat":1,"durations":[{"value":60,"timeUnit":"seconds"}],"gearVariation":{"difficultyAdjustedWithWeights":false,"difficultyVariations":[],"gear":"nothing","name":""}}]}],"status":"todo","difficulty":3,"trainingIndex":0,"weekDate":1787529600000,"sport":"ppg","stats":{"_t":"SessionExpectedStats","expectedDistance":0,"expectedDuration":1800},"paceZones":[{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":90},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60},{"kind":"GPP","duration":0},{"kind":"GPP","duration":0},{"kind":"GPP","duration":60}],"gear":["weights"],"duration":{"value":30,"timeUnit":"minutes"}},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_40","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Les footings, c'est la base de l'entraînement, tu en retrouveras donc chaque semaine, c'est ce qui te permettra de faire un bon kilométrage chaque semaine sans générer trop de fatigue et donc en évitant un maximum les blessures !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1787529600000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.017543859649122,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"Force_A10_600_1","description":"Séance \"mix\" avec une première partie constituée de 3 fractions de 30\" à intensité maximale entrecoupées de 2'30 de récupération en footing très lent. Une grosse récup qui te permet de te donner à fond sur chaque 30\". Deuxième partie de séance avec 5 fractions de 4' à ton allure 10 km avec 1'30 de récupération à chaque fois.","displayName":"Force + Allure 10km","coachAdvice":"Un type de séance que tu n'as pas dû voir souvent... c'est normal, on utilise les protocoles les plus récents en terme d'optimisation de l'entraînement ! Un mélange de travail d'endurance de force pour stimuler cette qualité essentielle... avant de faire un peu d'allure spécifique compétition avec la fatigue de la première partie de séance dans les jambes... parfait pour simuler le dernier tiers de ton 10km, quand ce sera vraiment dur ! Concernant ton allure 10km en tant que telle, on est encore loin de la course, donc on te conseille de [lire cet article](https://app.campus.coach/knowledges/understand-and-adjust-your-specific-race-pace-v2) avant de te lancer dans la séance ! :)","te