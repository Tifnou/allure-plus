 pendant les derniers mois de préparation pour catapulter ton niveau vers de nouveaux horizons (ce qui ne manquera pas de te mettre en confiance), soit plus tôt dans la préparation, en étant plus court, pour te mettre le pied à l'étrier et te préparer à la suite.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":596.6172539663276,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":253.8720877300593,"dvalue":11.568229118938095,"abstract":true,"competitive":false},{"slug":"fast","value":191.39026865433337,"dvalue":5.677726870830195,"abstract":true,"competitive":false},{"slug":"sprint","value":153.2365577477626,"dvalue":3.2435705696723884,"abstract":true,"competitive":false},{"slug":"ef","value":326.7692925813889,"dvalue":20.03214828374855,"abstract":false,"competitive":false},{"slug":"tempo","value":298.8375585283145,"dvalue":16.629659242893045,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.27371367671685,"dvalue":13.017561776159228,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.0826060610982,"dvalue":18.83182948318113,"abstract":false,"competitive":false},{"slug":"seuil60","value":253.8720877300593,"dvalue":11.568229118938095,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.14244547960374,"dvalue":10.24381148097288,"abstract":false,"competitive":false},{"slug":"vma","value":211.1165376249225,"dvalue":7.353793487210617,"abstract":false,"competitive":false},{"slug":"marathon","value":288.1561784437218,"dvalue":14.200664311441747,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.0879370687103,"dvalue":12.450354543696893,"abstract":false,"competitive":true},{"slug":"10km","value":246.86231988837145,"dvalue":10.83232153716988,"abstract":false,"competitive":true},{"slug":"5km","value":233.51915228557792,"dvalue":9.477092182296389,"abstract":false,"competitive":true},{"slug":"1500m","value":212.03401139132126,"dvalue":7.436553387267236,"abstract":false,"c