 chrono objectif, ce cycle S60 arrivera soit pendant les derniers mois de préparation pour catapulter ton niveau vers de nouveaux horizons (ce qui ne manquera pas de te mettre en confiance), soit plus tôt dans la préparation, en étant plus court, pour te mettre le pied à l'étrier et te préparer à la suite.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":596.9925139888493,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.0317680690469,"dvalue":11.57550529791357,"abstract":true,"competitive":false},{"slug":"fast","value":191.51064920995458,"dvalue":5.681298044642642,"abstract":true,"competitive":false},{"slug":"sprint","value":153.3329404013471,"dvalue":3.2456107090698523,"abstract":true,"competitive":false},{"slug":"ef","value":326.974823767888,"dvalue":20.04474809437449,"abstract":false,"competitive":false},{"slug":"tempo","value":299.0255212266745,"dvalue":16.640118957660846,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.44182336370125,"dvalue":13.02574955566583,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.28204452034606,"dvalue":18.84367431788718,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.0317680690469,"dvalue":11.57550529791357,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.2941191345643,"dvalue":10.25025462840368,"abstract":false,"competitive":false},{"slug":"vma","value":211.24932559935192,"dvalue":7.358418872566614,"abstract":false,"competitive":false},{"slug":"marathon","value":288.3519572984306,"dvalue":14.21118148505965,"abstract":false,"competitive":true},{"slug":"half-marathon","value":262.26600465840914,"dvalue":12.459621419384634,"abstract":false,"competitive":true},{"slug":"10km","value":247.03004290066139,"dvalue":10.840427926548138,"abstract":false,"competitive":true},{"slug":"5km","value":233.67780969293935,"dvalue":9.484221613099798,"abstract":false,"competitive":true},{"slug":"1500m","value":212.1780713803651,"dval