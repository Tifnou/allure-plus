895c04","_id":"6a7dbc32755f101affa7e5ed","articles":["fXsuskqsRJKyUegAH67w7g","R42mZwR8TZSX6PAemoh0GA","Q7BCWbqyR0ifEA3H1Asmkg","Y2kRza6pRdOsRsIQxSYo7w","GssCR6PsTvu-36aGA22sVQ"],"weekDate":1788134400000,"context":{"priority":"performance","backgroundGoal":"speed","goalId":"6a7dbba0755f101affa7d942","cycleTheme":"S60","cycleDescription":"Le cycle de S60 est un cycle complémentaire au cycle de S30 sur ta préparation 10km, qui s'organiseront pour répondre à la logique de spécificité de ton plan. En fonction de ton chrono objectif, ce cycle S60 arrivera soit pendant les derniers mois de préparation pour catapulter ton niveau vers de nouveaux horizons (ce qui ne manquera pas de te mettre en confiance), soit plus tôt dans la préparation, en étant plus court, pour te mettre le pied à l'étrier et te préparer à la suite.","isStatic":false},"estimatedPaces":[{"slug":"slow","value":597.743742274936,"dvalue":40,"abstract":true,"competitive":false},{"slug":"moderate","value":254.35143011717378,"dvalue":11.590071388445311,"abstract":true,"competitive":false},{"slug":"fast","value":191.75163751952664,"dvalue":5.6884471322657175,"abstract":true,"competitive":false},{"slug":"sprint","value":153.5258876147865,"dvalue":3.249694838289482,"abstract":true,"competitive":false},{"slug":"ef","value":327.38627404690646,"dvalue":20.069971495678704,"abstract":false,"competitive":false},{"slug":"tempo","value":299.401801371808,"dvalue":16.661058128172883,"abstract":false,"competitive":false},{"slug":"sweet-spot","value":267.77836001681777,"dvalue":13.042140567754583,"abstract":false,"competitive":false},{"slug":"aerobie","value":317.68129784585017,"dvalue":18.867386342459813,"abstract":false,"competitive":false},{"slug":"seuil60","value":254.35143011717378,"dvalue":11.590071388445311,"abstract":false,"competitive":false},{"slug":"seuil30","value":241.59775270334916,"dvalue":10.263153083637219,"abstract":false,"competitive":false},{"slug":"vma","value":211.51515216348525,"dvalue":7.367678372926