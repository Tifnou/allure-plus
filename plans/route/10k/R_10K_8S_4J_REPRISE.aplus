ue ton corps peut accepter... et donc ne pas progresser !","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_40","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":40,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":4,"weekDate":1789344000000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":7.017543859649122,"expectedDuration":2400},"paceZones":[{"kind":"Z2","duration":2400,"pace":{"value":327}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"SL_75","description":"Sortie longue à courir 100% en endurance fondamentale, comme pour les footings.","displayName":"Sortie Longue","coachAdvice":"On cherche simplement à conserver un bon niveau d'endurance avec cette sortie longue. 10km ça passe vite, pas besoin de faire plus.","test":false,"importance":true,"trainingType":"SL","trainingCategory":"road_long_run","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_75","exerciseType":"running","pace":{"name":"EF","value":327,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":75,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":2,"trainingIndex":5,"weekDate":1789344000000,"status":"todo","nutritionTraining":{"_id":"6a7dba14afd2719931e92b7e","userId":"642ab60364e5867bee895c04","weekDate":1789344000000,"sessionIndex":5,"choRecommendation":3,"formSuggestions":["liquid","semi-liquid"],"recipeOptions":{"1":{"homemade":[[{"datoId":"fV5sxS6dTOmJgqP6qnmqoA","name":"Velouté de tomates spécial effort","form":"liquid","info":{"quantity":{"value":950,"metric":"mL"},"cho":{"value":57,"metric":"g"},"sodium":{"value":3895,"metric":"mg"}}}],[{"datoId":"UMD5Rt1ESQ25KBXonqCm0A","name":"Jus de pomme","form":"liquid","info":{"quantity":{"value":520,"metric":"mL"},"waterQua