:"slow"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":0,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":3.0303030303030303,"expectedDuration":1800},"paceZones":[{"kind":"Z1","duration":1800,"pace":{"value":594}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_30","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Une première semaine post-course en douceur. Tu t'es donné(e) à 100% sur ta course alors laisse à ton corps le temps de se régénérer pour le remercier.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":1,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.278592375366569,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_30_2","description":"Footing à courir 100% en endurance fondamentale. Le but n'est pas de courir pile au milieu de la fourchette d'allure donnée, mais de faire au mieux en fonction de la forme du jour. Si tu mesures ton cardio, reste en-dessous des 75% de ta Fréquence Cardiaque Maximale, c'est la limite de l'endurance fondamentale.","displayName":"Endurance Fondamentale","coachAdvice":"Tu peux toujours continuer à t'entraîner, juste pour retrouver les sensations. Les choses sérieuses reprendront la semaine prochaine.","test":false,"importance":false,"trainingType":"EF","trainingCategory":"road_basic_endurance","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_30","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":30,"timeUnit":"minutes"}],"manualLap":false}]}],"difficulty":1,"trainingIndex":2,"weekDate":1791763200000,"status":"todo","stats":{"_t":"SessionExpectedStats","expectedDistance":5.278592375366569,"expectedDuration":1800},"paceZones":[{"kind":"Z2","duration":1800,"pace":{"value":326}}]},{"_t":"SmartSessionWithStats","sport":"road","name":"EF_45_5LD","description":"Footin à courir 100% en endurance fondamentale... voire plus lentement si tu en ressens le besoin. Les lignes droites (en option si tu te sens très fatigué(e)) sont à réaliser à une bonne allure et surtout avec une belle technique, on n'est pas sur des sprints ! Pour le temps de récupération, il est libre, prends le temps nécessaire entre 30\" et 1'.","displayName":"Endurance Fondamentale + Lignes droites","coachAdvice":"Quelques lignes droites pour ouvrir ta foulée et retrouver un peu d'impact au sol. Ça te permet de retrouver une petite intensité pour relancer la machine maintenant que tout a dû rentrer en ordre niveau physique et mental.","test":false,"importance":false,"trainingType":"EF_LD","trainingCategory":"road_basic_endurance_with_straight_lines","exercisesBlocks":[{"repeat":1,"exercises":[{"_t":"SmartExercise","name":"EF_35","exerciseType":"running","pace":{"name":"EF","value":326,"kind":"range","zoneKind":"Z2","abstract":false,"slug":"ef"},"durations":[{"value":35,"timeUnit":"minutes"}],"manualLap":false}]},{"repeat":5,"exercises":[{"_t":"SmartExercise","name":"LD","exerciseType":"running","pace":{"name":"Rapide","value":191,"kind":"abstract","zoneKind":"Z5","abstract":true,"slug":"fast"},"d